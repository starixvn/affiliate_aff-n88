
@{
    Layout = "~/Areas/Portal/Views/Shared/_ReactPageLayout.cshtml";
}
@model Fanex.Affiliate.Admin.Core.ViewModels.MediaGallery.BannerListViewModel

@{
    Html.RenderPartial("~/Areas/Portal/Views/MediaGallery/_MediaGallerySubMenu.cshtml", Model.SubMenuList);
}

@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/media-gallery/banner-list.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            categoryList: @Html.Raw(Json.Encode(Model.CategoryList)),
            languageList: @Html.Raw(Json.Encode(Model.LanguageList)),
            currencyList: @Html.Raw(Json.Encode(Model.CurrencyList)),
            imageTypeList: @Html.Raw(Json.Encode(Model.ImageTypeList)),
            sizeList: @Html.Raw(Json.Encode(Model.SizeList)),
            affTypeList: @Html.Raw(Json.Encode(Model.AffTypeList)),
            paramFromHome: @Html.Raw(Json.Encode(Model.Param))
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/media-gallery/banner-list.js")"></script>
}