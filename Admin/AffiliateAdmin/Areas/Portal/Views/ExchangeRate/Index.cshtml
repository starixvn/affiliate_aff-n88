@{
    Layout = "~/Areas/Portal/Views/Shared/_ReactPageLayout.cshtml";
    var hasPermission = Model;
}

@model bool

@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/exchange-rate/exchange-rate.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            hasPermission: '@hasPermission'.toLowerCase() === 'true',
            today: '@DateTime.Now.ToString("MM/dd/yyyy")'
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/exchange-rate/exchange-rate.js")"></script>
}