@using Fanex.Affiliate.Admin.Core.Configurations;
@{
    Layout = null;
    var appSetting = DependencyResolver.Current.GetService<IAppSetting>();
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <base href="@Url.Content("~")" />
    <link href="~/Areas/Portal/www/dist/vendors/bootstrap.css?v=4.3.1" rel="stylesheet" />
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/login.css")" rel="stylesheet" />
    @{
        if (appSetting.IsN8B)
        {
            <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/theme-coral.css")" rel="stylesheet" />
        }
        else
        {
            <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/theme-green.css")" rel="stylesheet" />
        }
    }

</head>
<body>
    @Html.AntiForgeryToken()
    <input type="hidden" id="RootUrl" value="@Url.Content("~")" />
    <div id="root">
    </div>
    <script type="text/javascript" src="~/Areas/Portal/www/dist/vendors/react.js?v=20190424"></script>
    <script type="text/javascript" src="~/Areas/Portal/www/dist/vendors/moment.js?v=20190424"></script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/login.js")"></script>
</body>
</html>
