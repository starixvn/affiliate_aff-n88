@using Fanex.Affiliate.Admin.Core.Constants;
@using Fanex.Affiliate.Admin.Core.Services.Common;
@using System.Collections.Generic;
@using Fanex.Affiliate.Admin.Core.Constants;

@{
    var controllerName = ViewContext.RouteData.Values["Controller"].ToString();
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var permission = sessionService.UserPermissionList;
    var menus = new Dictionary<string, string>
{
        {"Customer",Function.Affiliate },
        {"Affiliate",Function.Affiliate },
        {"Member",Function.Affiliate },
        {"Report",Function.AffReport },
        {"MediaGallery",Function.Media },
        {"Message",Function.HotNews },
        {"ExchangeRate",Function.AffExRate },
        {"Administrator",Function.UserControl },
        {"Domain",Function.Domain }
    };
    var result = from n in menus
                 join p in permission
                 on n.Value equals p.FunctionName
                 select n.Key;
}

@functions{
    public string GetMenuName(string menuKey)
    {
        if (menuKey == "MediaGallery")
        {
            return "Media Gallery";
        }
        else if (menuKey == "ExchangeRate")
        {
            return "Ex.Rate";
        }
        else
        {
            return menuKey;
        }
    }
}
<ul class="nav menu-list">
    <li class="nav-item">
        <a class="nav-link @(controllerName == "Home" ? "active" : string.Empty)" href="@Url.Content("~/Portal/Home")">Home</a>
    </li>

    @foreach (var item in result)
    {
        var active = "nav-link " + (controllerName == item ? "active" : string.Empty);
        <li class="nav-item">
            <a class="@active @controllerName" href="@Url.Content("~/Portal/"+item)">
                @GetMenuName(item)
            </a>
        </li>
    }
</ul>