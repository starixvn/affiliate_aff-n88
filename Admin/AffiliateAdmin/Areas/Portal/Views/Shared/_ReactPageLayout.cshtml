@{
    Layout = "~/Areas/Portal/Views/Shared/_Layout.cshtml";
}
@section vendorcss
{
    <link href="~/Areas/Portal/www/dist/vendors/bootstrap.css?v=4.3.1" rel="stylesheet" />
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/portalmain.css")" rel="stylesheet" />
    @RenderSection("pagecss", required: false)

}

@section vendorjs
{

    <script type="text/javascript" src="~/Areas/Portal/www/dist/vendors/react.js?v=20190424"></script>
    <script type="text/javascript" src="~/Areas/Portal/www/dist/vendors/moment.js?v=20190424"></script>
    @RenderSection("pagejs", required: true)

}

@RenderBody()

<div id="root"></div>
