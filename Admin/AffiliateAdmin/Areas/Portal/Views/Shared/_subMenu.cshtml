@using Fanex.Affiliate.Admin.Core.Services.Common;
@model IEnumerable<Fanex.Affiliate.Admin.Core.DTO.SubMenu>

@{
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var claims = sessionService.ClaimIdentities.SelectMany(i => i.Claims);
}
<ul class="nav">
    @foreach (var item in Model)
    {
        if (string.IsNullOrEmpty(item.FunctionName) || claims.Any(p => p.Type == item.FunctionName))
        {
            <li class="nav-item">
                <a class="nav-link @(item.IsActive? "active" : string.Empty)" href="@item.Url" target="_self">@item.Name</a>
            </li>
        }
    }
</ul>