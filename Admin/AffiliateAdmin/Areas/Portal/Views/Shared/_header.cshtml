<div class="headWrapper">
    <div class="float-left logo">Admin Page @(AppSetting.Instance.SiteFriendlyName)</div>
    <div class="float-left user-info">
        <span class="font-weight-bold icon-top">
            Welcome, @(HttpContext.Current.User.Identity.Name)
        </span>
        <a class="text-redlink" href="@Url.Content("~/Portal/ChangeAdminPassword")" target="_top">[Change Password]</a>
        <a class="text-redlink" href="@Url.Content("~/Portal/Auth/Logout")" target="_self">[Logout]</a>
    </div>

    <div class="float-right clock-container">
        <span class="oi oi-clock"></span><span id="clock"></span>@DateTime.Now.ToString("%z")
    </div>
</div>
