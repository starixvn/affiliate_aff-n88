@model Fanex.Affiliate.Admin.Core.ViewModels.Affiliate.MarketingAccountViewModel

@{
    Html.RenderPartial("~/Areas/Portal/Views/Affiliate/_AffiliateSubMenu.cshtml", Model.SubMenuList);
}

@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/marketing-account.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            languageList: @Html.Raw(Json.Encode(Model.LanguageList)),
            targetCountryList: @Html.Raw(Json.Encode(Model.TargetCountryList))
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/affiliate/marketing-account.js")"></script>
}