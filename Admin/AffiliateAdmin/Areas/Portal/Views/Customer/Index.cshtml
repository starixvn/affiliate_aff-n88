@using Fanex.Affiliate.Admin.Core.Utilities
@model Fanex.Affiliate.Admin.Core.ViewModels.Customer.CustomerViewModel
@{
    var appSetting = AppSetting.Instance;
}
@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/user-panel-layout.css")" rel="stylesheet" />
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/customer.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            licenseeName: '@(appSetting.SiteFriendlyName)',
            today: '@DateTimeHelper.DateTimeGMT8String',
            selectedUserPanel: null,
            affCommonInfo: null,
            leftPanel: {
                affName: '@Model.AffName',
                affTypeList: @Html.Raw(Json.Encode(Model.AffTypeList))
            },
            languageList: @Html.Raw(Json.Encode(Model.LanguageList)),
            supportedUiLanguages: @Html.Raw(Json.Encode(Model.SupportedUiLanguages)),
            productList: @Html.Raw(Json.Encode(Model.ProductList)),
            currencyList: @Html.Raw(Json.Encode(Model.CurrencyList)),
            baseCurrencyList: @Html.Raw(Json.Encode(Model.BaseCurrencyList)),
            isProduction: '@(appSetting.Environment)'.toLowerCase() === 'production',
            customerStatistics: {}
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/customer/customer.js")"></script>
}