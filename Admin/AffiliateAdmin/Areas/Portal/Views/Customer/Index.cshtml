@{
    Layout = "~/Areas/Portal/Views/Shared/_ReactPageLayout.cshtml";
}
@model Fanex.Affiliate.Admin.Core.ViewModels.Customer.CustomerViewModel

@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/user-panel-layout.css")" rel="stylesheet" />
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/customer.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            licenseeName: '@(AppSetting.Instance.SiteFriendlyName)',
            today: '@DateTime.Now.ToString("MM/dd/yyyy")',
            selectedUserPanel: null,
            affCommonInfo: null,
            leftPanel: {
                affName: '@Model.AffName'
            },
            languageList: @Html.Raw(Json.Encode(Model.LanguageList)),
            customerStatistics: {}
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/customer/customer.js")"></script>
}