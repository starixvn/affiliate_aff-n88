@{
    Layout = "~/Areas/Portal/Views/Shared/_ReactPageLayout.cshtml";
}

@model Fanex.Affiliate.Admin.Core.ViewModels.AffiliateReportViewModel
@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/affiliate-report.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            productList: @Html.Raw(Json.Encode(Model.ProductList)),
            languageList: @Html.Raw(Json.Encode(Model.LanguageList)),
            today: '@DateTime.Now.ToString("MM/dd/yyyy")',
            currencyList: @Html.Raw(Json.Encode(Model.CurrencyList)),
            baseCurrencyList: @Html.Raw(Json.Encode(Model.BaseCurrencyList)),
            isProduction: '@(AppSetting.Instance.Environment)'.toLowerCase() === 'production',
            isN8B: '@AppSetting.Instance.SiteName'.toLowerCase() === 'n8b',
            commGroupList: @Html.Raw(Json.Encode(Model.CommGroupList)),
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/report/affiliate-report.js")"></script>
}