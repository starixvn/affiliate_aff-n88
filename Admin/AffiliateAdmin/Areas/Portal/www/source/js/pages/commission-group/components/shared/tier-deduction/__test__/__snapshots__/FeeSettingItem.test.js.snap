      </FormGroup>
      <FormGroup
        tag="div"
      >
        <Input
          className="form-control"
          name="DeductedAmount"
          onChange={[Function]}
          style={
            Object {
              "width": 120,
            }
          }
          type="text"
          value=""
        />
      </FormGroup>
    </Form>
  </Col>
  <Col
