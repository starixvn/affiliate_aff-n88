<#@ template debug="true" hostSpecific="true" #>
<#@ output extension=".txt" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Linq" #>
<#@ include file="$(SolutionDir)\packages\T4.TemplateFileManager.2.2.1\tools\ttinc\TemplateFilemanager.CS.ttinclude" #>

<#
	var projectPath = Host.ResolveAssemblyReference("$(SolutionDir)") + @"\Admin\";
	Directory.SetCurrentDirectory(projectPath);
	var manager = TemplateFileManager.Create(this);

	const string SpNameTemplate = "SpName=\"{0}\"";
	var environments = new string[] { "dev", "master", "local", "sit", "uat", "production" };

	var originalSpName = System.IO.File.ReadAllText(@"AffiliateAdmin\App_Data\SpConfig\_SpNameOriginal.xml");
	var configXml = System.Xml.Linq.XDocument.Load(@"AffiliateAdmin\App_Data\SpConfig\_SpNameConfig.xml");
	var elements = configXml.Root.Elements("item");

	foreach(var env in environments)
	{
		var fileName = env == "dev" ? "SpName.xml" : string.Format("SpName.{0}.xml", env);
		var spContent = originalSpName;
		manager.StartNewFile(fileName);

		foreach(var element in elements)
		{
			var configEnvironments = element.Attribute("Environment").Value.Trim().Split(',');

			if(configEnvironments.Any(e => e.ToLower() == env))
			{
				var spName = element.Attribute("SpName").Value.Trim();
				var suffix = element.Attribute("Suffix").Value.Trim();

				spContent = Regex.Replace(
						spContent,
						string.Format(SpNameTemplate, spName),
						string.Format(SpNameTemplate, spName + suffix),
						RegexOptions.IgnoreCase);
			}
		}
		#>
<#=spContent#>
<#
	}

	manager.Process();
#>