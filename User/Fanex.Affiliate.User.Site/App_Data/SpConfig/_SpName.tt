<#@ template debug="true" hostSpecific="true" #>
<#@ output extension=".txt" #>
<#@ include file="$(SolutionDir)\User\T4.FileManager.VisualStudio.ttinclude" #>
<#@ include file="_SpNameConfiguration.ttinclude" #>

<#
    var manager = TemplateFileManager.Create(this);
    foreach(var site in sites)
    {
        var fileName = site.Environment == "DEV" ? "SpName.xml" : string.Format("SpName.{0}-user.{1}.xml", site.LicenseeName, site.Environment);
		var spConfigs = Helper.GetListOfSpConfig();
		var allSpNames = Helper.GetAllSpNames();
        manager.StartNewFile(fileName, "Fanex.Affiliate.User.Site", "App_Data\\SpConfig");
		#>
<#=site.GenerateSpName(allSpNames, spConfigs)#>
		<#
    }
    manager.Process();
#>