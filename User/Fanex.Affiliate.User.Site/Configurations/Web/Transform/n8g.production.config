<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <compilation debug="false" xdt:Transform="SetAttributes(debug)" />
    <customErrors mode="RemoteOnly" xdt:Transform="SetAttributes(mode)" />

    <authentication mode="Forms">
      <forms loginUrl="~/Home/Index" timeout="20" cookieless="UseCookies" path="/" defaultUrl="~/UserPanel/Main/#AccountOverview" name="Fanex.AffAsiaUserForm" slidingExpiration="true" protection="All" xdt:Transform="Replace" />
    </authentication>

    <sessionState mode="StateServer" stateConnectionString="tcpip=10.2.106.80:42424" cookieName="Fanex.AffAsiaUserSession" cookieless="UseCookies" timeout="20" xdt:Transform="Replace" />
    <machineKey validationKey="5276329D600F4F7F3BF6EE6014BA1BC33AA9D9AD294CDCFF3F01C8018CF1875ED9555C0C0FBB87464BD6EE4F9F2FB0F6AE9E5B1C188860DDEE68609FB9A724A5" decryptionKey="93B3E01D870883ECD43F1330C9DB80D0575465372BB302990CCB4E028FEEE414" validation="SHA1" decryption="AES" xdt:Transform="InsertAfter(/configuration/system.web/sessionState)" />
  </system.web>

  <ONEbook.UM ServiceUris="http://10.99.99.51:8889/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="2:00" UMTo="3:00" SiteId="32" UMPageUrl="~/UnderMaintenance" xdt:Transform="Replace">
    <AllowedIPs AllowAll="true">
    </AllowedIPs>
  </ONEbook.UM>

  <applicationSettings>
    <AffiliateUser.Properties.Settings>
      <setting name="AffiliateUser_MemberInfoService_Service" serializeAs="String">
        <value xdt:Transform="Replace">http://kraf.86812868.com:8010/service.asmx</value>
      </setting>
    </AffiliateUser.Properties.Settings>
  </applicationSettings>

  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
