<?xml version="1.0" encoding="utf-8"?>
<appSettings xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <add key="Environment" value="LOCAL" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>

  <!--MemberSiteSetting-->
  <add key="MemberSiteApiUrl" value="https://aff-b2c.nexdev.net/N88API" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="MemberSiteId" value="3" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>

  <!--Site-->
  <add key="SiteName" value="N8B" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="SiteFriendlyName" value="Bwing" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="DefaultLanguageCode" value="vi-VN" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="DefaultShortedLanguageCode" value="vn" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="MinWithdrawal" value="2,300,000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="DefaultCurrency" value="VND" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="MaxCommission" value="50%" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

  <!--RGB CSS-->
  <add key="RedNumberRGB" value="203" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="GreenNumberRGB" value="161" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="BlueNumberRGB" value="156" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
</appSettings>