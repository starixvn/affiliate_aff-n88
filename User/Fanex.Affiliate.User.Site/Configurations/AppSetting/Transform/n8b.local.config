<?xml version="1.0" encoding="utf-8"?>
<appSettings xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <add key="Environment" value="LOCAL" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>

  <!--MemberSiteSetting-->
  <add key="MemberSiteApiUrl" value="https://ha.nexdev.net:7634/N88API" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="MemberSiteId" value="3" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>

  <!--Site-->
  <add key="SiteName" value="N8B" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="SiteFriendlyName" value="Bwing" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="DefaultLanguageCode" value="vi-VN" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="DefaultShortedLanguageCode" value="vn" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="MinWithdrawal" value="2,300,000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="DefaultCurrency" value="VND" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="MaxCommission" value="60%" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="PhoneNumber" value="0777956785" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>

  <!--UM-->
  <add key="ONEbook.UM:ServiceUri" value="http://10.2.98.3:8889/api" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="ONEbook.UM:EnableCheckUM" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="ONEbook.UM:SiteId" value="2000003" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="ONEbook.UM:EnableUnscheduledUM" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="ONEbook.UM:UMFrom" value="3:00" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="ONEbook.UM:UMTo" value="4:00" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="ONEbook.UM:UMPageUrl" value="~/UnderMaintenance" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="ONEbook.UM:ResultCacheDuration" value="60" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="ONEbook.UM:UMLoggingCategory" value="ONEbook-N88-UM" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
</appSettings>