<?xml version="1.0" encoding="utf-8"?>
<appSettings xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <add key="Environment" value="MASTER" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="MediaScriptUrl" value="http://banner.12betscore.com/Home/MediaScript" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="SiteName" value="N88" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="SiteFriendlyName" value="Nova88" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

  <add key="LoggingCategory" value="Affiliate-N88" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="DefaultLanguageCode" value="en-US" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="MinWithdrawal" value="100" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="DefaultCurrency" value="USD" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="MaxCommission" value="45%" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>

  <!--Mail Contact-->
  <add key="MailContactID" value="hubert.duong@starixsoft.com" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="MailContactTH" value="steve.nguyen@starixsoft.com" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
</appSettings>