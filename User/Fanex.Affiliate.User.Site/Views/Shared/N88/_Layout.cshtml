@using Fanex.Affiliate.User.Core.CoreService
@using Fanex.Affiliate.User.Core.BusinessService
@using Fanex.Affiliate.User.Core.Constants

@{
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var settingService = DependencyResolver.Current.GetService<IAppSetting>();
    var languageService = DependencyResolver.Current.GetService<ILanguageService>();
    var userSession = sessionService.UserSession;
    var languageList = languageService.GetSupportedUILanguageList();
    var currentLanguage = sessionService.CurrentLanguage;
    var languageNativeName = languageList.FirstOrDefault(l => l.Code.Equals(currentLanguage))?.NativeName;
    var siteFriendlyName = settingService.SiteFriendlyName;
    var isLogin = HttpContext.Current.User.Identity.IsAuthenticated && userSession != null;
    var targetCountryLanguages = languageService.GetTargetCountryLanguages();
}

<!DOCTYPE html>
<html lang="@languageNativeName">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(string.IsNullOrEmpty(ViewBag.Title) ? siteFriendlyName + " " + Lang.Affiliate : ViewBag.Title)</title>
    <link rel="icon" href=@Url.Content("~/favicon-n88.ico")>

    <meta name="google-site-verification" content="iFkj5nsimoERnX2jd-9krswREsacSaFCr3Q22CJtQe0" />
    <meta name="msvalidate.01" content="D40D4C0F9E67ABAAAFA183F5D313FEFD" />
    <meta name="description" content="@SiteFriendlyNameHelper.ReplaceB2C(Lang.MetaDescription)" />
    <meta name="keywords" content="@(siteFriendlyName), @(siteFriendlyName) Affiliate Program, Sports Betting Affiliate, Casino Affiliate, betting affiliate programs, earn extra cash, top affiliate programs, asian casino affiliate programs, Asian betting affiliate programs, high payout affiliate programs" />
    <meta name="robots" content="index,follow,archive" />
    <meta name="title" content="@SiteFriendlyNameHelper.ReplaceB2C(Lang.MetaTitle)" />

    <script src="~/www/build/js/lib/jquery-3.3.1.min.js"></script>
    <script>
        window.jQuery || document.write('\x3Cscript src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js" integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8=" crossorigin="anonymous">\x3C/script>')
    </script>

    <script src="~/www/build/js/lib/bootstrap.min.js"></script>

    <link href="~/www/build/styles/css/bootstrap-3.3.7.min.css" rel="stylesheet" />
    <link href="~/www/build/styles/css/materialdesignicons.min.css" rel="stylesheet" type="text/css" />

    @if (currentLanguage == SystemLanguage.ChineseLanguageCode)
    {
        <link href="~/www/build/styles/fonts/noto-sans-sc/font.min.css" rel="stylesheet" />
    }
    else
    {
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,600;0,700;1,700&display=swap">
    }

    <link href="@Url.RenderLink("~/www/build/styles/css/main/n88.css")" rel="stylesheet" />
    <link href="@Url.RenderLink("~/www/build/styles/css/n88.css")" rel="stylesheet" />

    @RenderSection("styles", required: false)

</head>
<body class="@(isLogin ? "after-login-content" : "before-login-content") @currentLanguage">
    <header class="@RenderSection("classHeader", required: false)">
        <div class="header-top">
            <div class="logo">
                <a href="@Url.Content("~")">
                    @if (currentLanguage == "zh-CN")
                    {
                        <img src=@Url.Content("~/www/build/styles/Images/themes/n88.zh-CN.png?v=001") alt="logo" class="logo-image" />
                    }
                    else
                    {
                        <img src=@Url.Content("~/www/build/styles/Images/themes/n88.png?v=001") alt="logo" class="logo-image" />
                    }
                </a>
            </div>
            <div class="login">
                @{Html.RenderAction("AuthenticationForm", "Auth", new { v = DateTime.UtcNow.Ticks });}
                <div class="user-signup">
                    <div class="language-login">
                        <div class="language-container desktop @currentLanguage">
                            <div class="language-selection">
                                <button class="select-language" id="selectedLanguage">
                                    <span><i class="flag flag-@sessionService.CurrentLanguage"></i>@(languageNativeName)</span>
                                    <i class="caret"></i>
                                </button>

                                <div class="language-list-wrapper" id="languageList">
                                    <ul class="list-unstyled language-list">
                                        @*@foreach (var language in languageList)
                                        {
                                            <li>
                                                <a href="javascript:;" class="language-item" data-option="@language.ShortedCode"><i class="flag flag-@language.Code"></i>@language.NativeName</a>
                                            </li>
                                        }*@
                                        @foreach (var country in targetCountryLanguages)
                                        {
                                            <li class="country-item">
                                                <i class="country-item-col-1 flag flag-@country.Key"></i>
                                                <div class="country-item-col-2">
                                                    <p class="country-name @(country.Key == sessionService.CurrentCountry ? "text-bold" : "")">@country.Value[0].TargetCountryName</p>
                                                    <div class="language-options">
                                                        @foreach (var lang in country.Value)
                                                        {
                                                            <a href="javascript:;" class="language-item @(sessionService.CurrentLanguage == lang.Code && country.Key == sessionService.CurrentCountry ? "highlight" : "")" data-target-country-code="@country.Key" data-option="@lang.ShortedCode">
                                                                @lang.NativeName
                                                            </a>
                                                            if (lang != country.Value.Last())
                                                            {
                                                                <span class="separator">|</span>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                        @if (!isLogin)
                        {
                            <a class="btn btn-login-mobile" id="mobileLogin">
                                <span>@Lang.Login</span>
                            </a>
                            <button class="btn btn-login" id="btnLogin" type="button">@Lang.Login</button>
                        }
                        else
                        {
                            <div class="login-after user-login">
                                <a href="@Url.Content("~/UserPanel/Main/#AccountOverview")" class="btn btn-signup"><span class="icon glyphicon glyphicon-user"></span>@Lang.MyAccount - @sessionService.UserSession.UserName</a>
                                <div class="btn-logout">
                                    <a href="@Url.Content("~/Auth/SignOut/")" class="btn btn-login">@Lang.Logout</a>
                                </div>
                            </div>
                        }
                    </div>
                    @if (!isLogin)
                    {
                        <div class="sign-up">
                            <a href="@Url.Content("~/Signup/Index")" class="btn btn-signup">@Lang.SignUpAffiliate</a>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="overlay"></div>
        <div class="navbar">
            <div class="@RenderSection("classNav", required: false) layout-page-container">
                <div class="container-fluid">
                    <div class="row">
                        <div class="navbar-header">
                            <button type="button" id="btn-menu" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1" aria-expanded="false">
                                <span class="sr-only">Toggle navigation</span>
                                <span class="icon-bar"></span>
                                <span class="icon-bar"></span>
                                <span class="icon-bar"></span>
                            </button>
                        </div>
                        <div class="collapse navbar-collapse menu" id="bs-example-navbar-collapse-1">
                            <ul class="nav navbar-nav">
                                @{
                                    var controllerName = ViewContext.RouteData.Values["Controller"].ToString();
                                }
                                <li>
                                    <a class="menu-item @(controllerName == "Home" ? "active" : string.Empty)" href="@Url.Content("~/Home")">
                                        @Lang.Home
                                    </a>
                                </li>
                                <li>
                                    <a class="menu-item @(controllerName == "RevenueSharingStructure" ? "active" : string.Empty)" href="@Url.Content("~/RevenueSharingStructure")">
                                        @Lang.CommissionStructure
                                    </a>
                                </li>
                                <li>
                                    <a class="menu-item @(controllerName == "Product" ? "active" : string.Empty)" href="@Url.Content("~/Product")">
                                        @Lang.Product
                                    </a>
                                </li>
                                <li>
                                    <a class="menu-item @(controllerName == "TermAndCondition" ? "active" : string.Empty)" href="@Url.Content("~/TermAndCondition")">
                                        @Lang.TermAndCondition
                                    </a>
                                </li>
                                @*<li>
                                    <a class="menu-item @(controllerName == "Promotion" ? "active" : string.Empty)" href="@Url.Content("~/Promotion")">
                                        @Lang.Promotion
                                    </a>
                                </li>*@
                                <li>
                                    <a class="menu-item @(controllerName == "FAQ" ? "active" : string.Empty)" href="@Url.Content("~/FAQ")">
                                        @Lang.Faqs
                                    </a>
                                </li>
                                <li>
                                    <a class="menu-item @(controllerName == "ContactUs" ? "active" : string.Empty)" href="@Url.Content("~/ContactUs")">
                                        @Lang.ContactUs
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>
    <div class="main-container">
        @RenderBody()
    </div>

    <div class="footer">
        <div class="footer-text">
            @string.Format(SiteFriendlyNameHelper.ReplaceB2C(Lang.Copyright), DateTime.Now.Year)
        </div>
    </div>

    <div class="blocker" id="blocker" style="display: none;">
        <div class="spinner">
            <div class="dot1"></div>
            <div class="dot2"></div>
        </div>
    </div>

    <input type="hidden" id="RootUrl" value="@Url.Content("~")" />
    <input type="hidden" id="Language" value="@currentLanguage" />
    
    <div class="contact-girl-floating-icon hidden" id="contactGirlIcon">
        <div class="contact-girl-close" id="contactGirlClose">&times;</div>
        <a href="@Url.Content("~/ContactUs")" class="contact-girl-link">
            <img src="~/www/build/styles/Images/contact-girl/n88/contact-us.@(currentLanguage).webp" 
                 alt="Contact Girl" class="contact-girl-image" />
        </a>
    </div>
    
    @Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())
    <script src="https://cdn.ravenjs.com/3.27.0/raven.min.js" crossorigin="anonymous"></script>
    <script>
        window.Lang = {
            All: '@Lang.All',
            ServerError: '@Lang.ServerError'
        };
        window.SiteName = 'n88';
    </script>

    @Html.InlineScripts("~/www/build/js/lib/modernizr-webp.js")
    @Html.InlineScripts("~/www/build/js/jquery.extension.js")
    <script src="@Url.RenderLink("~/www/build/js/site.js")"></script>
    <script src="@Url.RenderLink("~/www/build/js/layout.js")"></script>
    <script src="@Url.RenderLink("~/www/build/js/layout/n88.js")"></script>

    @if (userSession != null)
    {
        <script src="@Url.RenderLink("~/www/build/js/recheckin.js")"></script>
    }

    @RenderSection("scripts", required: false)
</body>
</html>