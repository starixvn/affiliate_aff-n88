@{
    Layout = "~/Views/Shared/N88/_Layout.cshtml";

    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var groupName = sessionService.UserSession.GroupName;
}

@using Fanex.Affiliate.User.Core.CoreService
@using Fanex.Affiliate.User.Core.Constants

@section styles{
    <link href="@Url.RenderLink("~/www/build/styles/css/main/n88-after-login.css")" rel="stylesheet" />
    @RenderSection("styles", required: false)
}

@section scripts{
    @RenderSection("scripts", required: false)
}

<div class="main after-login">
    @RazorHelper.RenderHotNews()
    <div class="after-login-container">
        <div class="content-menu">
            <ul class="menu list-unstyled content-menu-pc" id="mainMenu">
                <li><a class="menu-item" id="menuAccountOverview" href="@Url.Content("~/UserPanel/Main/#AccountOverview")">@Lang.AccOverview</a></li>
                @if (string.Equals(groupName, CommGroupName.KoreanAgentComm))
                {
                    <li><a class="menu-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Member" ? "active" : string.Empty)" id="menuYourCustomer" href="@(Url.Content("~/UserPanel/Member/Index"))">@Lang.YourCustomers</a></li>
                }
                <li><a class="menu-item" id="menuStatementHistory" href="@Url.Content("~/UserPanel/Main/#StatementHistory")">@Lang.StatementHistory</a></li>
                <li><a class="menu-item" id="menuMyAccount" href="@Url.Content("~/UserPanel/Main/#MyAccount")">@Lang.MyAccount</a></li>
                <li><a class="menu-item" id="menuPaymentRequest" href="@Url.Content("~/UserPanel/Main/#PaymentRequest")">@Lang.PaymentRequest</a></li>
                @if (!sessionService.UserSession.DisabledTransfer)
                {
                    <li class="parent">
                        <a class="menu-item" href="javascript:;">@Lang.TransferBalanceForPlayer <i class="content-dropdown-icon"></i></a>
                        <ul class="menu submenu-container list-unstyled">
                            <li><a class="menu-item" id="menuPlayerTransferBalance" href="@Url.Content("~/UserPanel/Main/#PlayerTransferBalance")">@Lang.TransferBalanceForPlayer</a></li>

                            <li><a class="menu-item" id="menuPlayerTransferBalanceHistory" href="@Url.Content("~/UserPanel/Main/#PlayerTransferBalanceHistory")">@Lang.TransferBalanceForPlayerHistory</a></li>

                        </ul>
                    </li>
                }
                <li><a class="menu-item" id="menuRevenueReport" href="@Url.Content("~/UserPanel/Main/#RevenueReport")">@Lang.CommissionReport</a></li>
                <li class="parent">
                    <a class="menu-item" href="javascript:;">@Lang.Statistics <i class="content-dropdown-icon"></i></a>
                    <ul class="menu submenu-container list-unstyled">
                        <li><a class="menu-item" id="menuReferrersStatistics" href="@Url.Content("~/UserPanel/Main/#ReferrersStatistics")">@Lang.Referrals</a></li>
                        <li><a class="menu-item" id="menuLandingPageStatistics" href="@Url.Content("~/UserPanel/Main/#LandingPageStatistics")">@Lang.LandingPages</a></li>
                        <li><a class="menu-item" id="menuMarketingPageStatistics" href="@Url.Content("~/UserPanel/Main/#MarketingLinkStatistics")">@Lang.MarketLinkStatistics</a></li>
                    </ul>
                </li>
            </ul>

            <div class="content-menu-mobile">
                <div class="show-name-menu">
                    @Lang.AccOverview
                </div>
                <ul class="dropdown-content-menu">
                    <li><a href="@Url.Content("~/UserPanel/Main/#AccountOverview")" class="active">@Lang.AccOverview</a></li>
                    @if (string.Equals(groupName, CommGroupName.KoreanAgentComm))
                    {
                        <li><a class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Member" ? "active" : string.Empty)" id="menuYourCustomer" href="@(Url.Content("~/UserPanel/Member/Index"))">@Lang.YourCustomers</a></li>
                    }
                    <li><a id="menuStatementHistory" href="@Url.Content("~/UserPanel/Main/#StatementHistory")">@Lang.StatementHistory</a></li>
                    <li><a id="menuMyAccount" href="@Url.Content("~/UserPanel/Main/#MyAccount")">@Lang.MyAccount</a></li>
                    <li><a id="menuPaymentRequest" href="@Url.Content("~/UserPanel/Main/#PaymentRequest")">@Lang.PaymentRequest</a></li>
                    @if (!sessionService.UserSession.DisabledTransfer)
                    {
                        <li class="parent">
                            <a class="parent-item" href="javascript:;">@Lang.TransferBalanceForPlayer <i class="content-dropdown-icon"></i></a>
                            <ul class="list-unstyled sub-menu-content">
                                <li><a id="menuPlayerTransferBalance" href="@Url.Content("~/UserPanel/Main/#PlayerTransferBalance")">@Lang.TransferBalanceForPlayer</a></li>

                                <li><a id="menuPlayerTransferBalanceHistory" href="@Url.Content("~/UserPanel/Main/#PlayerTransferBalanceHistory")">@Lang.TransferBalanceForPlayerHistory</a></li>

                            </ul>
                        </li>
                    }
                    <li><a id="menuRevenueReport" href="@Url.Content("~/UserPanel/Main/#RevenueReport")">@Lang.CommissionReport</a></li>
                    <li class="parent">
                        <a class="parent-item" href="javascript:;">@Lang.Statistics <i class="content-dropdown-icon"></i></a>
                        <ul class="list-unstyled sub-menu-content">
                            <li><a id="menuReferrersStatistics" href="@Url.Content("~/UserPanel/Main/#ReferrersStatistics")">@Lang.Referrals</a></li>
                            <li><a id="menuLandingPageStatistics" href="@Url.Content("~/UserPanel/Main/#LandingPageStatistics")">@Lang.LandingPages</a></li>
                            <li><a id="menuMarketingPageStatistics" href="@Url.Content("~/UserPanel/Main/#MarketingLinkStatistics")">@Lang.MarketLinkStatistics</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
            

        </div>

        <div class="main-content">
              @RenderBody()
        </div>
    </div>
</div>