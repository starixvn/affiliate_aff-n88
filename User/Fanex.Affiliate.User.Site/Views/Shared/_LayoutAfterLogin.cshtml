@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var appSetting = DependencyResolver.Current.GetService<IAppSetting>();

    var siteName = appSetting.SiteName;
    var groupName = sessionService.UserSession.GroupName;
    var isN8G = string.Equals(AppSetting.Instance.SiteName, SiteName.N8G, StringComparison.CurrentCultureIgnoreCase);

    var today = DateTimeOffset.Now.DateTime;
    var cutOfDateUpdateTelegramNotify = DateTime.Parse("06/30/2025");

    var isShowDialog = DateTime.Compare(cutOfDateUpdateTelegramNotify, today) >= 0;
}

@using Fanex.Affiliate.User.Core.CoreService
@using Fanex.Affiliate.User.Core.Constants

@section styles {
    @RenderSection("styles", required: false)
}

@section scripts {
    @if (isShowDialog)
    {
        <script src="@Url.RenderLink("~/www/build/js/telegram-update-dialog.js")"></script>
    }
    @RenderSection("scripts", required: false)
}

<div class="main after-login">
    <div class=@(isN8G ? "page-container" : "after-login-container")>
        @RazorHelper.RenderHotNews()
        <div class="content-menu">
            <ul class="menu list-unstyled" id="mainMenu">
                <li>
                    <a class="menu-item" id="menuAccountOverview"
                       href="@Url.Content("~/UserPanel/Main/#AccountOverview")">@Lang.AccOverview</a>
                </li>
                @if (string.Equals(groupName, CommGroupName.KoreanAgentComm))
                {
                    <li>
                        <a class="menu-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Member" ? "active" : string.Empty)"
                           id="menuYourCustomer" href="@(Url.Content("~/UserPanel/Member/Index"))">@Lang.YourCustomers</a>
                    </li>
                }
                <li>
                    <a class="menu-item" id="menuStatementHistory"
                       href="@Url.Content("~/UserPanel/Main/#StatementHistory")">@Lang.StatementHistory</a>
                </li>
                <li>
                    <a class="menu-item" id="menuMyAccount"
                       href="@Url.Content("~/UserPanel/Main/#MyAccount")">@Lang.MyAccount</a>
                </li>
                <li>
                    <a class="menu-item" id="menuPaymentRequest"
                       href="@Url.Content("~/UserPanel/Main/#PaymentRequest")">@Lang.PaymentRequest</a>
                </li>
                @if (!sessionService.UserSession.DisabledTransfer)
                {
                    <li class="parent">
                        <a class="menu-item" href="javascript:;">@Lang.TransferBalanceForPlayer <i class="caret"></i></a>
                        <ul class="menu submenu-container list-unstyled">
                            <li>
                                <a class="menu-item" id="menuPlayerTransferBalance"
                                   href="@Url.Content("~/UserPanel/Main/#PlayerTransferBalance")">@Lang.TransferBalanceForPlayer</a>
                            </li>

                            <li>
                                <a class="menu-item" id="menuPlayerTransferBalanceHistory"
                                   href="@Url.Content("~/UserPanel/Main/#PlayerTransferBalanceHistory")">@Lang.TransferBalanceForPlayerHistory</a>
                            </li>

                        </ul>
                    </li>
                }
                <li>
                    <a class="menu-item" id="menuRevenueReport"
                       href="@Url.Content("~/UserPanel/Main/#RevenueReport")">@Lang.CommissionReport</a>
                </li>
                <li class="parent">
                    <a class="menu-item" href="javascript:;">@Lang.Statistics <i class="caret"></i></a>
                    <ul class="menu submenu-container list-unstyled">
                        <li>
                            <a class="menu-item" id="menuReferrersStatistics"
                               href="@Url.Content("~/UserPanel/Main/#ReferrersStatistics")">@Lang.Referrals</a>
                        </li>
                        <li>
                            <a class="menu-item" id="menuLandingPageStatistics"
                               href="@Url.Content("~/UserPanel/Main/#LandingPageStatistics")">@Lang.LandingPages</a>
                        </li>
                        <li>
                            <a class="menu-item" id="menuMarketingLinkStatistics"
                               href="@Url.Content("~/UserPanel/Main/#MarketingLinkStatistics")">@Lang.MarketLinkStatistics</a>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>

        <div class="main-content">
            <div class="container-fluid">
                @RenderBody()
            </div>
        </div>
    </div>
</div>
<!-- Modal Telegram Update -->
<div class="modal fade" id="telegramUpdateModal" tabindex="-1" role="dialog" aria-labelledby="telegramUpdateModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body p-4">
                <div class="align-items-center justify-content-between">
                    <div class="modal-text-content @siteName">
                        <h4 class="modal-title">@Lang.TitleUpdateTelegram</h4>
                        <p>@Lang.ContentUpdateTelegram</p>
                    </div>
                    <div class="modal-button-group">
                        <button type="button" class="btn @(siteName == "N8B" ? "btn-signup" : "btn-login")" id="btnRemindLater">@Lang.RemindMeLater</button>
                        <button type="button" class="btn @(siteName == "N8B" ? "btn-signup" : "btn-login")" id="btnUpdateNow">@Lang.UpdateNow</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>