@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using Fanex.Affiliate.User.Core.Utilities

@{
    var settingService = DependencyResolver.Current.GetService<IAppSetting>();
    var siteName = settingService.IsN8B ? "N8B" : "N8G";
    var gaID = AppSetting.Instance.IsN8B ? "UA-93927620-4" : "UA-93927620-5";
}

@section styles{
    @RenderSection("styles", required: false)
}

@section classNav{page-container}

@section scripts{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsencrypt/2.3.1/jsencrypt.min.js"></script>

    @if (settingService.Environment.Equals("UAT", StringComparison.OrdinalIgnoreCase) || settingService.IsProduction)
    {
        <!-- Google Analytics -->
        <!-- Global site tag (gtag.js) - Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=@(gaID)"></script>
        <script type="text/javascript">
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());

            gtag('config', '@(gaID)');
        </script>
        <!-- End Google Analytics -->
    }

    @Html.InlineScripts("~/www/build/js/pagetracking.js")

    <script type="text/javascript">
        var validationMessage = {
            enterUserName: "@Lang.ErrmsgEntryUsername",
            enterPassword: '@Lang.ErrmsgEntryPassword',
            enterValidationCode: '@Lang.ErrmsgEntryValidCode'
        }
    </script>

    @Html.InlineScripts("~/www/build/js/pages/login.js")
    @RenderSection("scripts", required: false)
}

<div class="main">
    <div class="banner-side banner-left">
        <picture>
            <img src="~/www/build/styles/Images/banner-main-left.jpg?v=000001" alt="banner-left" />
        </picture>
    </div>

    <div class="page-container">
        @RazorHelper.RenderHotNews()
        @RenderBody()
    </div>

    <div class="banner-side banner-right">
        <picture>
            <img src="~/www/build/styles/Images/banner-main-right.jpg?v=000001" alt="banner-right" />
        </picture>
    </div>
</div>

<div class="modal fade login-dialog" tabindex="-1" role="dialog" id="loginDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-banner">
                <img src=@(Url.Content($"~/www/build/styles/Images/themes/{siteName}.png")) alt="logo" />
                <h2 class="logo-text">@Lang.AffiliateProgram</h2>
            </div>

            <div class="modal-main-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h3 class="modal-title">@Lang.AffiliateLogin</h3>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h3 class="title-left">@Lang.NotAffiliateMemberYet</h3>
                            <p>@SiteFriendlyNameHelper.Replace12Bet(Lang.SignUpToAffiliateProgram)</p>
                            <a href="@Url.Content("~/Signup/Index")" role="button" class="btn btn-signup btn-block text-uppercase">@Lang.JoinNow</a>
                        </div>

                        <div class="col-md-6 login-side" id="dialogUserInput">
                            <h3 class="title-right">@Lang.WelcomeBack</h3>
                            <div class="form-group">
                                <input type="text" id="dialogtxtUsername" class="form-control" placeholder="@Lang.Username" />
                            </div>
                            <div class="form-group">
                                <input type="password" id="dialogtxtPassword" class="form-control" placeholder="@Lang.Password" />
                            </div>
                            <div class="form-group">
                                <input type="text" id="dialogtxtValidation" class="form-control captcha-input" placeholder="@Lang.Validation" />
                                <div class="validation-value">
                                    <img src="" alt="captcha" id="loginDialogcaptchaImg" />
                                </div>
                            </div>

                            <button type="button" id="btnDialogLogin" class="btn btn-login-mobile btn-block text-uppercase">@Lang.Login</button>
                            <a href="@Url.Content("~/Password/Index")" class="link-login-popup">> @Lang.ForgotLoginDetail</a>
                        </div>
                    </div>
                </div>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->