@model Fanex.Affiliate.User.Core.MetalModels.Email.ContactUsEmailParam
<div>
    Pasukan Sokongan Affiliate yang dihormati,<br />
    <div style="margin-left: 30px;">
        Anda telah menerima pertanyaan baharu daripada borang Hubungi Kami Affiliate.<br />
        Nama: @Model.FirstName @Model.LastName<br />
        E-mel: @Model.Sender<br />
        Subjek: @Model.Subject<br />
        Pesanan:<br />
        <div style="margin-left: 30px;"> @Raw(Model.Message.Replace("\n", "<br />"))</div><br />

        Dihantar pada: @Model.SubmittedDateTime.ToString("yyyy-MM-dd HH:mm") (GMT+8)<br />
    </div>
    ---------------------------------------------------------------------------------------------------------------------------------------<br /><br />
    Dengan hormatnya,<br />
    Sistem Affiliate
</div>
