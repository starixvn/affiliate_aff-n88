@model Fanex.Affiliate.User.Core.MetalModels.Email.ContactUsEmailParam
<div>
    Tim Dukungan Afiliasi yang Terhormat,<br />
    <div style="margin-left: 30px;">
        Anda telah menerima pertanyaan baru dari formulir Kontak Kami Afiliasi.<br />
        Nama: @Model.FirstName @Model.LastName<br />
        Email: @Model.Sender<br />
        Subjek: @Model.Subject<br />
        Pesan:<br />
         <div style="margin-left: 30px;">
             <pre style="font-family: inherit; font-size: inherit; margin: 0; white-space: pre-wrap;">@Model.Message</pre>
         </div>

        Dikirim pada: @Model.SubmittedDateTime.ToString("yyyy-MM-dd HH:mm") (GMT+8)<br />
    </div>
    ---------------------------------------------------------------------------------------------------------------------------------------<br />
    Salam hormat,<br />
    Sistem Afiliasi
</div>
