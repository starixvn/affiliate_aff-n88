@model Fanex.Affiliate.User.Core.MetalModels.Email.ContactUsEmailParam
<div>
    尊敬的联盟支持团队：<br />
    <div style="margin-left: 30px;">
        您收到一条来自联盟联系我们表单的新咨询。<br />
        姓名: @Model.FirstName @Model.LastName<br />
        邮箱: @Model.Sender<br />
        主题: @Model.Subject<br />
        留言内容:<br />
         <div style="margin-left: 30px;">
             <pre style="font-family: inherit; font-size: inherit; margin: 0; white-space: pre-wrap;">@Model.Message</pre>
         </div>

        提交时间: @Model.SubmittedDateTime.ToString("yyyy-MM-dd HH:mm") (GMT+8)<br />
    </div>
    ---------------------------------------------------------------------------------------------------------------------------------------<br />
    此致<br />
    代理系统
</div>
