@model Fanex.Affiliate.User.Core.MetalModels.Email.ContactUsEmailParam
<div>
    Dear Affiliate Support Team,<br /><br />

    You have received a new inquiry from the Affiliate Contact Us form.<br /><br />

    Name: @Model.FirstName @Model.LastName<br />
    Email: @Model.Sender<br />
    Subject: @Model.Subject<br />
    Message:<br />
    &nbsp;&nbsp;&nbsp;@Html.Raw(Model.Message.Replace("\n", "<br />"))<br /><br />

    Submitted at: @Model.SubmittedDateTime.ToString("yyyy-MM-dd HH:mm:ss")<br /><br />

    ---------------------------------------------------------------------------------------------------------------------------------------<br /><br />

    Best regards,<br />
    Affiliate System
</div>
