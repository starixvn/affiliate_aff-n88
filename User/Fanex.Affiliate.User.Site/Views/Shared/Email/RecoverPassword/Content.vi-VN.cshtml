@model Fanex.Affiliate.User.Core.MetalModels.Email.RecoverPasswordEmailParam
@{
    var userInfo = Model.User;
    var recoverUrl = Model.RootDomain + "Password/RecoverPassword?uid=" + userInfo.AffId + "&vid=" + Model.Code;
}
    <div>
        Kính gửi @userInfo.FirstName<br /><br />

        Bạn đã yêu cầu chúng tôi phục hồi tên tài khoản và mật mã của bạn. Xin hãy nhấp vào liên kết dưới đây, mật mã mới sẽ được gửi đến cho bạn trong thời gian sớm nhất.<br />
        <a href='@recoverUrl'>@recoverUrl</a><br /><br />

        Xin lưu ý:<br />
        *Tên tài khoản là: @userInfo.UserName<br />
        *Vì lý do an toàn, chúng tôi phải cung cấp cho bạn mật mã mới (bạn có thể đổi mật mã bất cứ khi nào).<br />
        *Liên kết trên sẽ hết hạn và vô hiệu trong vòng 24 tiếng.<br /><br />

        Nếu yêu cầu này không phải từ bạn, xin bỏ qua lá thư này.<br /><br />

        Xin chân thành cám ơn.<br /><br />

        Bộ phận liên kết @Model.SiteFriendlyName<br />
        <a href="mailto:@Model.MailContact">@Model.MailContact</a>
    </div>