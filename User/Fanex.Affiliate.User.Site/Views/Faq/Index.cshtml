@using Fanex.Affiliate.User.Core.Constants
@model Fanex.Affiliate.User.Core.ViewModels.BaseLayoutViewModel

@{
    ViewBag.Title = Lang.Faqs;
    Layout = PathHelper.GetLayoutPath("_LayoutBeforeLogin", Model.SiteName);
}

@{
    var isN88 = string.Equals(Model.SiteName, SiteName.N88, StringComparison.CurrentCultureIgnoreCase);
    var contentView = PathHelper.GetViewPath("Faq", $"_Content.{Model.CurrentLanguage}", Model.SiteName);

    var htmlString = Html.Partial(contentView, Model.SiteFriendlyName).ToHtmlString();
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/faq.css")
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/n88/left-menu-panel.js")
}

<div class="main-content">
    @if (isN88)
    {
        <div class="mobile-left-panel">
            <span>List Category</span>
        </div>
        <div class="left-panel" id="left-panel-menu">
            <div class="menu">
                <ul class="nav navbar-nav" id="left-panel-nav">
                    <li>
                        <a class="menu-item left-menu-item active" href="#General">
                            @Lang.General
                        </a>
                    </li>
                    <li>
                        <a class="menu-item left-menu-item" href="#MarketingAndTracking">
                            @Lang.MarketingAndTracking
                        </a>
                    </li>
                    <li>
                        <a class="menu-item left-menu-item" href="#RevenueSharePayment">
                            @Lang.RevenueSharePayment
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    }
    <div class="content">
        <div class="page-title">
            <span class="text">@Lang.Faqs</span>
        </div>

        @Html.Raw(htmlString)

        @RazorHelper.RenderMovingTopButton()
    </div>
</div>
