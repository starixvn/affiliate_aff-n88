@using Fanex.Affiliate.User.Core.Constants
@model Fanex.Affiliate.User.Core.ViewModels.BaseLayoutViewModel

@{
    ViewBag.Title = Lang.Faqs;
    Layout = "~/Views/Shared/N88/_LayoutBeforeLogin.cshtml";
}

@{
    var viewName = $"~/Views/Faq/N88/_Content.{Model.CurrentLanguage}.cshtml";

    var htmlString = Html.Partial(viewName, Model.SiteFriendlyName).ToHtmlString();
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/faq.css")
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/n88/left-menu-panel.js")
}

<div class="main-content">
    @RazorHelper.RenderLeftPanel(Menu.FaqMenuList)
    <div class="content">
        <div class="page-title">
            <span class="text">@Lang.Faqs</span>
        </div>

        @Html.Raw(htmlString)

        @RazorHelper.RenderMovingTopButton()
    </div>
</div>