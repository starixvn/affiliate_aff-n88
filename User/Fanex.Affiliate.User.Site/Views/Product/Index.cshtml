@model Fanex.Affiliate.User.Core.ViewModels.ProductPageViewModel
@{
    ViewBag.Title = Lang.Product;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@{
    var viewName = $"~/Views/Product/_Content.{Model.CurrentLanguage}.cshtml";
    var siteFriendlyName = Model.SiteFriendlyName;
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/products.css")
}

<div class="content product-page">
    <div class="page-title">
        <span class="text">@Lang.Product</span>
    </div>

    @{ Html.RenderPartial(viewName, siteFriendlyName); }

    @if (!Model.IsAuthenticated)
    {
        <div class="col-sm-offset-3 col-sm-6 signup-block">
            <a href="@Url.Content("~/SignUp")" class="btn btn-link btn-block nounderline">@SiteFriendlyNameHelper.ReplaceB2C(Lang.SignUpAffiliateProgramNow)</a>
        </div>
    }
    @RazorHelper.RenderMovingTopButton()
</div>