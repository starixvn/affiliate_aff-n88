@model Fanex.Affiliate.User.Core.ViewModels.ProductPageViewModel
@{
    ViewBag.Title = Lang.Product;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@{
    var siteFriendlyName = Model.SiteFriendlyName;
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/products.css")
}

<div class="product-new-page">
    <div class="page-title">
        <span class="text">@Lang.Our_Products</span>
    </div>

    @Html.RenderPartialByLanguage("~/Views/Product/_Content", Model.CurrentLanguage, siteFriendlyName)
    @RazorHelper.RenderMovingTopButton()
</div>