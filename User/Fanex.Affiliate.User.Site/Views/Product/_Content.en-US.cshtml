@model string
@{
    var siteFriendlyName = Model;
}

<div class="product-block">
    <div class="sportbooks-block">
        <div class="product-info">
            <div class="product-title">
                <h2>@Lang.Sportsbook</h2>
            </div>
            <div class="product-content">
                <p>
                    @siteFriendlyName is favored by millions of betting players from all over the world due to its wide variety coverage for all the sports actions. Offering the highest pay out rate that covers a wide range of sports event from around the world. It is the top platform for every sports betting enthusiast.                                                                                                                                 
                </p>
            </div>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="live-casino-block">
        <div class="product-info">
            <div class="product-title">
                <h2>@Lang.LiveCasino</h2>
            </div>
            <div class="product-content">
                <p>
                    Dive into an exciting range of live casino games at @siteFriendlyName, including fan favorites like baccarat and blackjack. Enjoy premium gaming from the comfort of your home with seamless access to a world-class live casino experience.
                </p>
            </div>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="slots-block">
        <div class="product-info">
            <div class="product-title">
                <h2>@Lang.Slots</h2>
            </div>
            <div class="product-content">
                <p>
                    Play the best online slot games all in one place without downloading at @siteFriendlyName. Explore thrilling titles with rich mechanics, eye-catching visuals, and the chance to win incredible jackpots!
                </p>
            </div>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="esports-block">
        <div class="product-info">
            <div class="product-title">
                <h2>@Lang.Esports</h2>
            </div>
            <div class="product-content">
                <p>
                    Bet on your favorite eSports teams with ease at @siteFriendlyName. Enjoy the best payout rates and full coverage on top titles like CS:GO, Dota 2, and LoL. @siteFriendlyName makes eSports betting both exciting and effortless.
                </p>
            </div>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="lottery-block">
        <div class="product-info">
            <div class="product-title">
                <h2>@Lang.Lottery</h2>
            </div>
            <div class="product-content">
                <p>
                    Discover the excitement of online lottery betting at @siteFriendlyName, where players can enjoy multiple formats including 3D/5D, 11x5, and Dice lotteries. Each game type offers rich betting options such as Big/Small, Odd/Even, and Color Range, making every draw more thrilling.
                </p>
            </div>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="fishing-block">
        <div class="product-info">
            <div class="product-title">
                <h2>@Lang.Fishing</h2>
            </div>
            <div class="product-content">
                <p>
                    @siteFriendlyName stands out as a top choice for fishing game fans, with premium titles like SG Fishing and Alien Hunter. Enjoy action-packed gameplay and the chance to score major prizes with every catch.
                </p>
            </div>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="number-game-block">
        <div class="product-info">
            <div class="product-title">
                <h2>@Lang.NumberGame</h2>
            </div>
            <div class="product-content">
                <p>
                    @siteFriendlyName’s Number Game includes various games that involve picking and guessing numbers, much like lotteries, bingo, or keno. These games are popular for their simplicity and the exciting chance to win big payouts. If you enjoy number-based games, @siteFriendlyName is worth trying.
                </p>
            </div>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="keno-block">
        <div class="product-info">
            <div class="product-title">
                <h2>@Lang.Keno</h2>
            </div>
            <div class="product-content">
                <p>
                    @siteFriendlyName Keno is an easy-to-play game where you simply pick your numbers and wait for the draw. With no skills or strategies required, it’s a fun and accessible option for all players.
                </p>
            </div>
        </div>
    </div>
</div>