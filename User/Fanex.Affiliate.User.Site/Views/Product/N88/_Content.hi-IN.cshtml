@model string
@{
    var siteFriendlyName = Model;
}

<div class="product-block">
    <div class="sportbooks-block">
        <div class="product-info">
            <div class="product-title">
                <h2>@Lang.Sportsbook</h2>
            </div>
            <div class="product-content">
                <p>
                    @siteFriendlyName दुनिया भर के लाखों बेटिंग खिलाड़ियों द्वारा पसंद किया जाता है, क्योंकि यह सभी प्रकार के खेल आयोजनों की व्यापक कवरेज और उच्चतम पAYOUT दर प्रदान करता है। यह हर स्पोर्ट्स बेटिंग प्रेमी के लिए शीर्ष प्लेटफ़ॉर्म है। 
                </p>
            </div>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="live-casino-block">
        <div class="product-info">
            <div class="product-title">
                <h2>@Lang.LiveCasino</h2>
            </div>
            <div class="product-content">
                <p>
                    @siteFriendlyName पर रोमांचक लाइव कैसीनो गेम्स की एक रेंज में शामिल हों, जिसमें बैकारेट और ब्लैकजैक जैसे प्रशंसकों के पसंदीदा गेम्स शामिल हैं। अपने घर के आराम से विश्व स्तरीय लाइव कैसीनो अनुभव का आनंद लें।
                </p>
            </div>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="slots-block">
        <div class="product-info">
            <div class="product-title">
                <h2>@Lang.Slots</h2>
            </div>
            <div class="product-content">
                <p>
                    @siteFriendlyName पर बिना डाउनलोड किए सभी बेहतरीन ऑनलाइन स्लॉट गेम्स खेलें। रोमांचक फीचर्स, शानदार विज़ुअल्स और ज़बरदस्त जैकपॉट जीतने का मौका खोजें!
                </p>
            </div>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="esports-block">
        <div class="product-info">
            <div class="product-title">
                <h2>@Lang.Esports</h2>
            </div>
            <div class="product-content">
                <p>
                    @siteFriendlyName पर आसानी से अपने पसंदीदा ईस्पोर्ट्स टीम्स पर सट्टा लगाएं। CS:GO, Dota 2, और LoL जैसे टॉप टाइटल्स पर बेहतरीन पAYOUT दर और फुल कवरेज का लाभ उठाएं। @siteFriendlyName ईस्पोर्ट्स बेटिंग को रोमांचक और सरल बनाता है।
                </p>
            </div>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="lottery-block">
        <div class="product-info">
            <div class="product-title">
                <h2>@Lang.Lottery</h2>
            </div>
            <div class="product-content">
                <p>
                    @siteFriendlyName पर ऑनलाइन लॉटरी बेटिंग का रोमांच अनुभव करें, जहां खिलाड़ी 3D/5D, 11x5 और डाइस लॉटरी जैसे कई फॉर्मेट्स में खेल सकते हैं। हर गेम में Big/Small, Odd/Even और Color Range जैसी विविध बेटिंग विकल्प होते हैं, जो हर ड्रॉ को और रोमांचक बनाते हैं।
                </p>
            </div>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="fishing-block">
        <div class="product-info">
            <div class="product-title">
                <h2>@Lang.Fishing</h2>
            </div>
            <div class="product-content">
                <p>
                    SG Fishing और Alien Hunter जैसे प्रीमियम टाइटल्स के साथ @siteFriendlyName फिशिंग गेम प्रेमियों के लिए एक शीर्ष पसंद है। एक्शन से भरपूर गेमप्ले और हर कैच के साथ बड़ी पुरस्कार जीतने का मौका पाएं।
                </p>
            </div>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="number-game-block">
        <div class="product-info">
            <div class="product-title">
                <h2>@Lang.NumberGame</h2>
            </div>
            <div class="product-content">
                <p>
                    @siteFriendlyName का नंबर गेम उन गेम्स का संग्रह है जिनमें नंबर चुनना और उनका अनुमान लगाना शामिल है — जैसे कि लॉटरी, बिंगो या केनो। ये गेम्स अपनी सरलता और बड़े पAYOUT जीतने की संभावना के कारण लोकप्रिय हैं। यदि आपको नंबर-बेस्ड गेम्स पसंद हैं, तो @siteFriendlyName जरूर आज़माएं।
                </p>
            </div>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="keno-block">
        <div class="product-info">
            <div class="product-title">
                <h2>@Lang.Keno</h2>
            </div>
            <div class="product-content">
                <p>
                    @siteFriendlyName केनो एक सरल गेम है, जिसमें खिलाड़ी केवल अपने नंबर चुनते हैं और ड्रॉ का इंतज़ार करते हैं। किसी विशेष कौशल या रणनीति की ज़रूरत नहीं होती, जिससे यह सभी के लिए एक मज़ेदार और सुलभ विकल्प बनता है।
                </p>
            </div>
        </div>
    </div>
</div>