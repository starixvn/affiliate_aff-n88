@model Fanex.Affiliate.User.Core.ViewModels.ProductPageViewModel
@{
    ViewBag.Title = Lang.Product;
    Layout = "~/Views/Shared/N88/_LayoutBeforeLogin.cshtml";
    var supportPgSoftProductMarkets = "id-ID,th-TH";
}

@{
    var siteFriendlyName = Model.SiteFriendlyName;
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/n88/products.css")
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/n88/left-menu-panel-has-sub.js")
}

<div class="main-content main-content-left-panel">
    <div class="content product-page product-new-page">
        <div class="page-title">
            <span class="text">@Lang.Our_Products</span>
        </div>

        @Html.RenderPartialByLanguage("~/Views/Product/N88/_Content", Model.CurrentLanguage, siteFriendlyName)


        @RazorHelper.RenderN88MovingTopButton()
    </div>

</div>