@model string
@{
    var rs45FileName = Url.Content($"~/www/build/styles/Images/products/N88/Revenue-Share-45");

    var orgRS45FileName = $"{rs45FileName}.{Model}";
    var mobileRS45FileName = $"{rs45FileName}-Mobile.{Model}";
}
<div id="productBanner" class="carousel slide" data-ride="carousel">
    <div class="carousel-inner" role="listbox">
        <div class="item active">
            <picture>
                <source media="(max-width:480px)" srcset="@(mobileRS45FileName + ".jpg?v=166681")" type="image/jpeg" />
                <source srcset="@(orgRS45FileName + ".jpg?v=166681")" type="image/jpeg" />
                <img class="img-item img-responsive" src="@(orgRS45FileName + ".jpg?v=166681")" alt="45% Revenue Share" />
            </picture>
        </div>
    </div>
    @*<a class="left carousel-control" href="#productBanner" role="button" data-slide="prev">
        <span class="chevron left" aria-hidden="true"></span>
        <span class="sr-only">Previous</span>
    </a>
    <a class="right carousel-control" href="#productBanner" role="button" data-slide="next">
        <span class="chevron right" aria-hidden="true"></span>
        <span class="sr-only">Next</span>
    </a>*@
</div>

@*<script type="text/javascript" src="@Url.RenderLink("~/www/build/js/pages/product.js")"></script>*@