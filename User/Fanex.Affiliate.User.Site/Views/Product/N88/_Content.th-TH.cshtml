@model string
@{
    var siteFriendlyName = Model;
}

<div class="product-block">
    <div class="sportbooks-block sport-left-block">&nbsp;</div>
    <div class="product-info">
        <div class="product-title">
            <h2>@Lang.Sportsbook</h2>
        </div>
        <div class="product-content">
            <p>
                @siteFriendlyName ได้รับความนิยมจากผู้เล่นพนันนับล้านทั่วโลก ด้วยการให้บริการครอบคลุมกีฬาหลากหลายประเภทอย่างครบวงจร พร้อมอัตราจ่ายสูงสุดที่ครอบคลุมการแข่งขันกีฬาจากทั่วทุกมุมโลก ทำให้เป็นแพลตฟอร์มอันดับหนึ่งสำหรับผู้ที่ชื่นชอบการเดิมพันกีฬาอย่างแท้จริง 
            </p>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="product-info">
        <div class="product-title">
            <h2>@Lang.LiveCasino</h2>
        </div>
        <div class="product-content">
            <p>
                ดื่มด่ำกับเกมคาสิโนสดที่น่าตื่นเต้นหลากหลายรูปแบบที่ @siteFriendlyName รวมถึงเกมยอดนิยมอย่างบาคาร่าและแบล็คแจ็ค เพลิดเพลินกับการเล่นเกมระดับพรีเมียมได้อย่างสะดวกสบายจากที่บ้าน พร้อมประสบการณ์คาสิโนสดระดับโลกที่เข้าถึงได้อย่างไร้รอยต่อ
            </p>
        </div>
    </div>
    <div class="live-casino-block sport-right-block">&nbsp;</div>
</div>
<div class="product-block">
    <div class="slots-block sport-left-block">&nbsp;</div>
    <div class="product-info">
        <div class="product-title">
            <h2>@Lang.Slots</h2>
        </div>
        <div class="product-content">
            <p>
                เล่นเกมสล็อตออนไลน์ที่ดีที่สุดทั้งหมดในที่เดียวที่ @siteFriendlyName โดยไม่ต้องดาวน์โหลด สำรวจเกมสล็อตที่น่าตื่นเต้นพร้อมระบบเกมที่หลากหลาย ภาพกราฟิกสวยงาม และโอกาสชนะรางวัลแจ็คพอตมหาศาล!
            </p>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="product-info">
        <div class="product-title">
            <h2>@Lang.Esports</h2>
        </div>
        <div class="product-content">
            <p>
                เดิมพันทีมอีสปอร์ตที่คุณชื่นชอบได้อย่างง่ายดายที่ @siteFriendlyName เพลิดเพลินกับอัตราจ่ายที่ดีที่สุดและครอบคลุมเกมดังอย่าง CS:GO, Dota 2 และ LoL @siteFriendlyName ทำให้การเดิมพันอีสปอร์ตเป็นเรื่องที่สนุกและสะดวกสบาย
            </p>
        </div>
    </div>
    <div class="esports-block sport-right-block">&nbsp;</div>
</div>
<div class="product-block">
    <div class="lottery-block sport-left-block">&nbsp;</div>
    <div class="product-info">
        <div class="product-title">
            <h2>@Lang.Lottery</h2>
        </div>
        <div class="product-content">
            <p>
                ค้นพบความตื่นเต้นของการเดิมพันหวยออนไลน์ที่ @siteFriendlyName ที่ผู้เล่นสามารถสนุกกับรูปแบบหลากหลาย เช่น 3D/5D, 11x5 และหวยลูกเต๋า แต่ละเกมมีตัวเลือกการเดิมพันมากมาย เช่น โต๊ด/เต็ง, คู่/คี่ และช่วงสี ทำให้ทุกการออกรางวัลเร้าใจยิ่งขึ้น
            </p>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="product-info">
        <div class="product-title">
            <h2>@Lang.Fishing</h2>
        </div>
        <div class="product-content">
            <p>
                @siteFriendlyName เป็นตัวเลือกอันดับต้น ๆ สำหรับแฟนเกมยิงปลา ด้วยเกมคุณภาพอย่าง SG Fishing และ Alien Hunter เพลิดเพลินกับการเล่นที่เต็มไปด้วยความสนุกและโอกาสคว้ารางวัลใหญ่ในทุกการจับปลา
            </p>
        </div>
    </div>
    <div class="fishing-block sport-right-block">&nbsp;</div>
</div>
<div class="product-block">
    <div class="number-game-block sport-left-block">&nbsp;</div>
    <div class="product-info">
        <div class="product-title">
            <h2>@Lang.NumberGame</h2>
        </div>
        <div class="product-content">
            <p>
                เกมตัวเลขของ @siteFriendlyName ครอบคลุมเกมหลากหลายประเภทที่เกี่ยวกับการเลือกและทายตัวเลข คล้ายกับล็อตเตอรี่ บิงโก หรือเกมคีโน เกมเหล่านี้ได้รับความนิยมด้วยความเรียบง่ายและโอกาสชนะรางวัลใหญ่ หากคุณชื่นชอบเกมที่ใช้ตัวเลข @siteFriendlyName คือทางเลือกที่คุณควรลอง
            </p>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="product-info">
        <div class="product-title">
            <h2>@Lang.Keno</h2>
        </div>
        <div class="product-content">
            <p>
                เกมคีโนของ @siteFriendlyName เป็นเกมที่เล่นง่าย เพียงแค่เลือกหมายเลขที่ชอบแล้วรอลุ้นผลการออกรางวัล ไม่ต้องใช้ทักษะหรือกลยุทธ์ใด ๆ จึงเป็นตัวเลือกที่สนุกและเข้าถึงได้สำหรับผู้เล่นทุกคน
            </p>
        </div>
    </div>
    <div class="keno-block sport-right-block">&nbsp;</div>
</div>