@model string
@{
    var siteFriendlyName = Model;
}

<div class="product-block">
    <div class="sportbooks-block sport-left-block">&nbsp;</div>
    <div class="product-info">
        <div class="product-title">
            <h2>@Lang.Sportsbook</h2>
        </div>
        <div class="product-content">
            <p>
                @siteFriendlyName বিশ্বের বিভিন্ন প্রান্তের লক্ষ লক্ষ বেটিং খেলোয়াড়দের কাছে জনপ্রিয়, কারণ এটি ক্রীড়া ইভেন্টের বিশাল পরিসরের জন্য বিস্তৃত কভারেজ এবং সর্বোচ্চ পেআউট রেট অফার করে। এটি প্রত্যেক ক্রীড়া বাজি প্রেমীদের জন্য শীর্ষ প্ল্যাটফর্ম। 
            </p>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="product-info">
        <div class="product-title">
            <h2>@Lang.LiveCasino</h2>
        </div>
        <div class="product-content">
            <p>
                @siteFriendlyName-এ বাকারাট এবং ব্ল্যাকজ্যাকের মতো জনপ্রিয় লাইভ ক্যাসিনো গেমস উপভোগ করুন। ঘরে বসেই বিশ্বমানের লাইভ ক্যাসিনো অভিজ্ঞতার মজা নিন।
            </p>
        </div>
    </div>
    <div class="live-casino-block sport-right-block">&nbsp;</div>
</div>
<div class="product-block">
    <div class="slots-block sport-left-block">&nbsp;</div>
    <div class="product-info">
        <div class="product-title">
            <h2>@Lang.Slots</h2>
        </div>
        <div class="product-content">
            <p>
                @siteFriendlyName-এ কোনো কিছু ডাউনলোড না করেই সেরা অনলাইন স্লট গেমগুলো খেলুন। দারুন গ্রাফিক্স, আকর্ষণীয় গেমপ্লে, এবং চমৎকার জ্যাকপট জয়ের সুযোগ আপনার জন্য অপেক্ষা করছে!
            </p>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="product-info">
        <div class="product-title">
            <h2>@Lang.Esports</h2>
        </div>
        <div class="product-content">
            <p>
                @siteFriendlyName-এ সহজেই আপনার প্রিয় ইস্পোর্টস টিমের উপর বাজি ধরুন। CS:GO, Dota 2, এবং LoL-এর মতো জনপ্রিয় গেমে সর্বোচ্চ পেআউট রেট এবং সম্পূর্ণ কভারেজ উপভোগ করুন।
            </p>
        </div>
    </div>
    <div class="esports-block sport-right-block">&nbsp;</div>
</div>
<div class="product-block">
    <div class="lottery-block sport-left-block">&nbsp;</div>
    <div class="product-info">
        <div class="product-title">
            <h2>@Lang.Lottery</h2>
        </div>
        <div class="product-content">
            <p>
                @siteFriendlyName-এ অনলাইন লটারি বেটিংয়ের উত্তেজনায় ডুবে যান, যেখানে আপনি 3D/5D, 11x5, এবং ডাইস লটারি সহ নানা ধরনের ফরম্যাট উপভোগ করতে পারেন। প্রতিটি গেমে Big/Small, Odd/Even, ও Color Range-এর মতো বিভিন্ন বেটিং অপশন থাকে, যা প্রতিটি ড্র-কে আরও রোমাঞ্চকর করে তোলে।
            </p>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="product-info">
        <div class="product-title">
            <h2>@Lang.Fishing</h2>
        </div>
        <div class="product-content">
            <p>
                SG Fishing এবং Alien Hunter-এর মতো সেরা ফিশিং গেমসের জন্য @siteFriendlyName ফিশিং গেম প্রেমীদের কাছে শীর্ষ পছন্দ। প্রতিটি ক্যাচে রয়েছে উত্তেজনাপূর্ণ গেমপ্লে এবং বড় পুরস্কার জয়ের সুযোগ।
            </p>
        </div>
    </div>
    <div class="fishing-block sport-right-block">&nbsp;</div>
</div>
<div class="product-block">
    <div class="number-game-block sport-left-block">&nbsp;</div>
    <div class="product-info">
        <div class="product-title">
            <h2>@Lang.NumberGame</h2>
        </div>
        <div class="product-content">
            <p>
                @siteFriendlyName-এর নম্বর গেমসে রয়েছে বিভিন্ন ধরনের গেম, যেখানে নম্বর বেছে নেওয়া ও অনুমান করা হয়, অনেকটা লটারি, বিঙ্গো, বা কেনোর মতো। এগুলো সহজ এবং বড় পেআউট জেতার উত্তেজনাপূর্ণ সুযোগের জন্য জনপ্রিয়।
            </p>
        </div>
    </div>
</div>
<div class="product-block">
    <div class="product-info">
        <div class="product-title">
            <h2>@Lang.Keno</h2>
        </div>
        <div class="product-content">
            <p>
                @siteFriendlyName কেনো একটি সহজ গেম, যেখানে খেলোয়াড়রা নম্বর বেছে নিয়ে ড্র-এর জন্য অপেক্ষা করে। কোনো দক্ষতা বা কৌশল ছাড়াই, এটি সকলের জন্য উপভোগ্য ও সহজলভ্য একটি মজার অপশন।
            </p>
        </div>
    </div>
    <div class="keno-block sport-right-block">&nbsp;</div>
</div>

