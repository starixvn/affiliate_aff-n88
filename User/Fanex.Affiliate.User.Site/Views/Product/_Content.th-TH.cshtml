@{
    var siteName = AppSetting.Instance.SiteFriendlyName;
}
<div class="adv text-center">
    <div class="banner-product banner-product-sport">
        <p class="text-red"><span>ผลิตภัณฑ์ทั้งหมดจะถูกนับในส่วนแบ่งรายได้ต่อเดือนของคุณ!!</span></p>
    </div>
</div>
<div>
    <p class="text-block">
        สิ่งที่สำคัญที่สุดคาสิโนออนไลน์นี้มุ่งเน้นอย่างมากที่จะเสนอสถานที่เล่นการพนันที่ปลอดภัย เกมส์แต่ละเกมส์ถูกออกแบบให้ความสวยงามเป็นที่น่าพึงพอใจและองค์ประกอบการออกแบบที่ไม่เหมือนใคร เพื่อให้ผู้เล่นได้ดื่มดำไปกับเกมส์
    </p>
    <p class="text-block">
        ายินดีเป็นอย่างยิ่งที่ได้ต้อนรับทุกท่านเข้าร่วมโปรแกรมพันธมิตร @(siteName) เพื่อสร้างรายได้คอมมิชชั่นของคุณให้มากที่สุดจากผลิตภัณฑ์ @(siteName) ทั้งหมด
    </p>
</div>
<div>
    <p class="text-bold text-uppercase">ผลิตภัณฑ์กีฬา</p>
    <p>
        @(siteName) ได้รับการสนับสนุนจากผู้เล่นการพนันนับล้านจากทั่วทุกมุมโลกเนื่องจากความครอบคลุมที่หลากหลายของกีฬาทุกประเภท เมื่อลงทะเบียนสำเร็จบนเว็บไซต์ผ่านการโฆษณาของพันธมิตร ผู้เล่นจะเข้าถึงเข้ากีฬาต่อไปนี้แบบเต็มรูปแบบ: ฟุตบอล, ปิงปอง, บาสเก็ตบอล,กอล์ฟ, มวย, วอลเลย์บอล, มอเตอร์สปอร์ต, ฮ็อกกี้น้ำแข็ง,เบสบอล, แฮนด์บอล, โปโลน้ำ ,รักบี้, กีฬาปาลูกดอก, ว่ายน้ำ, สนุ๊กเกอร์และคริกเก็ตเป็นต้น ยอดการวางเดิมพันของสมาชิกในพันธมิตรของคุณคือค่าคอมมิชชั่นรายเดือนที่คุณจะได้รับ
    </p>
    <p class="text-block">
        ที่สำคัญคือ @(siteName) นำเสนอเกมส์เดิมพันที่ยอดนิยมเดิมพันมากที่สุดในเอเชีย อย่างเช่น
    </p>
    <div class="table table-responsive">
        <table class="game-list">
            <tbody>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name" width="30%">
                        @Lang.ProductSportsBook
                    </td>
                    <td>
                        หน้ากีฬา @(siteName) เป็นแพลตฟอร์มหน้าเดิมพันกีฬาที่เสนอค่าน้ำที่ดีที่สุดในตลาด พร้อมทั้งรูปแบบการเดิมพันที่หลากหลาย ครอบคลุมทุกแมตซ์ ทุกลีกฟุตบอลกว่า 100 ลีก ทุกรายการการแข่งขัน กว่า 5,000 รายการ รองรับทุกภาษาทั่วทั้งเอเชีย จึงถือได้ว่าหน้ากีฬา @(siteName)นั้นเป็นแพลตฟอร์มการเดิมพันหน้ากีฬาที่ดีที่สุดในเอเชีย
                    </td>
                </tr>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name">
                        @Lang.ProductVirtualSports
                    </td>
                    <td>
                        เกมกีฬาจำลอง เป็นเกมอิเล็กทรอนิกส์ที่ได้แรงบันดาลใจจากกีฬาจริง เช่น ฟุตบอล, วิ่งแข่งม้า, วิ่งแข่งหมาเกรย์ฮาวด์, กีฬาแข่งรถ, มอเตอร์สปอร์ต, จักรยานทางเร็ว และเทนนิส เป็นต้น แต่เกมนี้มีข้อแตกต่างจากกีฬาที่แข่งจริงๆ ซึ่งจะเริ่มต้นการแข่งและจบลงในอีก 3-5 นาทีพร้อมภาพวีดิโอช่วงสำคัญของแต่ละเกมซึ่งจะทำให้ผู้เล่นสามารถทราบผลการแข่งขันได้ทันที
                    </td>
                </tr>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name">
                        @Lang.ProductNumberGame
                    </td>
                    <td>
                        เกมส์หมายเลข เป็นเกมที่น่าเล่นมากและเป็นที่ดึงดูดผู้เล่น ด้วยสไตล์เกมส์จะเหมือนกับการจับสลากล็อตเตอร์รี่ที่ได้รับแรงบันดาลใจจากเกมบิงโก โดยผู้เล่นทุกคนต้องวางเดิมพันบนหมายเลขซึ่งจะมีลูกบอลที่หมุนอยู่ในเครื่องสุ่มออกรางวัล สิ่งที่สร้างความตื่นเต้นที่สุดในเกมส์นี้คือสาวสวยที่จับฉลากลูกบอลหมายเลขรางวัลในจอถ่ายทอดสดแบบเรียลไทม์จะเต้นโชว์สร้างความเพลิดเพลินให้กับผู้เล่นขณะรอลูกบอลออกรางวัล
                    </td>
                </tr>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name">
                        @Lang.ProductRngKeno
                    </td>
                    <td>
                        RNG Keno เล่นโดยสุ่ม 20 ลูกจาก 80 หมายเลข (01 ถึง 80) โดยเป็นการรวมกันของตัวเลขที่สุ่ม 20 ลูก โดยมีหลายวิธีที่จะชนะและวิธีการเดิมพันหลายประเภทเช่น สามารถแทงสูง -ต่ำ ใหญ่ แทงคี่ - คู่, แทงมังกร-เสือ และอื่น ๆ อีกหลายวิธี อีกทั้งคีโนนี้จะมีหลายโซนฤดูและโซนประเทศให้เลือกเดิมพัน และยังเป็นเกมส์ที่รู้ผลชนะรวดเร็วในช่วงอึดใจเพียงหนึ่งนาทีเท่านั้น
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="adv text-center">
        <div class="banner-product banner-product-casino">
            <p class="text-red col-sm-9 col-xs-8"><span>ผลิตภัณฑ์ทั้งหมดจะถูกนับในส่วนแบ่งรายได้ต่อเดือนของคุณ!!</span></p>
        </div>
    </div>
</div>
<div>
    <p class="text-bold text-uppercase">ผลิตภัณฑ์คาสิโน</p>
    <p>
        ใน@(siteName) คาสิโนจะแยกกันตามแพล็ตฟอร์มที่ให้บริการดังคุณจะดูรายละเอียดได้จากตารางด้านล่างว่าแต่ละคลับหรือแพล็ตฟอร์มไหนให้บริการคาสิโนรูปแบบใดบ้างใน@(siteName). เรามีนับหลายร้อยเกมส์แตกต่างกันให้เล่น เช่น คาสิโนสด, เกมส์สล็อต, เกมส์เล่นบนโต๊ะ, เกมส์ไพ่, วีดิโอโป๊กเกอร์, เกมส์ตู้ ทั้งหมดต่างรวบรวมไว้เป็นหมวดหมู่ด้วยรูปแบบหน้าเว็บที่ใช้งานง่ายเพื่อให้ประสบการณ์ที่ดีที่สุดในการเล่นคาสิโนของคุณ
    </p>
    <p class="text-block">
        รับทราบเพิ่มเติมเกี่ยวกับประเภทเกมคาสิโนต่างๆของเราและแพลตฟอร์มหรูหราที่เรานำเสนอดังต่อไปนี้
    </p>
    <div class="table table-responsive">
        <table class="game-list">
            <tbody>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name">
                        @Lang.ProductAllbet
                    </td>
                    <td>
                        ALLBET GAMING ป็นบริษัทด้านการพนันและความบันเทิงที่ทันสมัสุดในเอเชีย รวมถึงฟังก์ชั่นการเล่นแบบหลากหลายที่สุด ที่คุณสามารถตรวจสอบการ์ดคะแนนสูงสุดถึง 12 ใบและมีตัวเลือกในการแสดงตาราง 4, 8, 16 หรือ 32 บนหน้าจอการแจกไพ่ 6 ใบก่อนใช้งานพิเศษของโต๊ะวีไอพี และคุณสมบัติอื่น ๆ อีกมากมาย
                    </td>
                </tr>
                <tr>
                    <td class="text-center text-bold text-uppercase game-name">
                        @Lang.ProductPragmaticPlay
                    </td>
                    <td>
                        Pragmatic นำเสนอกลุ่มผลิตภัณฑ์หลากหลายที่มีนวัตกรรมควบคุมและเน้นไปที่อุปกรณ์พกพา ด้วยผลงานที่ได้รับรางวัลมากมายหลายรางวัลและมีเนื้อหาที่เป็นเอกลักษณ์ประกอบด้วยเกมส์ HTML5 ที่ผ่านการพิสูจน์แล้วกว่า 100 เกมส์มีให้บริการในหลายสกุลเงินและตลาดที่ได้รับการรับรองทั้งหมด
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    @{ Html.RenderPartial("~/Views/Product/_CasinoProductTable.cshtml"); }
<p class="text-block">
    ประเภทการเดิมพันทั้งหมดเบื้องต้นต่างนับรายได้ในโปรแกรมพันธมิตร@(siteName)ทั้งสิ้น เราขอเชิญคุณมาเข้าร่วมเป็นหุ้นส่วนธุรกิจนี้เรื่อยไปให้ยาวนานในการโฆษณาและทำให้แบรนด์ของเราโดดเด่นสร้างประสบการณ์เดิมพันที่เยี่ยมยอดให้ลูกค้าและทำให้รายได้ค่าคอมมิชชั่นของคุณเติบโตต่อเนื่องตลอดไปพร้อมกับแบรนด์ของเรา เพียงร่วมโปรแกรมพันธมิตรกับเราวันนี้!
</p>
</div>