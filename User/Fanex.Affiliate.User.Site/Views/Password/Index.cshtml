@{
    ViewBag.Title = Lang.ForgetPassword;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@section styles {
    <style>
        .main {
            min-height: calc(100vh - 282px)
        }

        .has-error > input {
            border-color: #a94442;
        }
    </style>
}
@section scripts{
    <script src="@Url.RenderLink("~/www/build/js/validation.js")"></script>
    <script src="@Url.RenderLink("~/www/build/js/forgotpassword.js")"></script>
}

<div class="content">
    <div class="page-title">
        <span class="text">@Lang.ForgetPassword</span>
    </div>

    <div class="alert" role="alert" id="messageResult" style="display: none"></div>
    <div id="mainContent">
        <p>@Html.Raw(Lang.TitelForgetPass.Replace("{0}", Url.Content("~/ContactUs")))</p>
        <form id="forgotPasswordForm" class="form-horizontal" style="margin-top:30px;">
            @Html.AntiForgeryToken()
            <div class="form-group" id="emailInputGroup">
                <label class="col-sm-3 col-md-2 control-label require">@Lang.YourEmail</label>
                <div class="col-sm-4">
                    <input class="form-control" name="Email" id="Email" type="text" autocomplete="off" />
                </div>
                <div class="col-sm-offset-3 col-md-offset-2 col-sm-10 validation-input">
                    <span class="help-block hide">@Lang.EmailAddressIsInvalid</span>
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-offset-3 col-md-offset-2 col-sm-4">
                    <button id="btnSubmit" class="btn btn-submit" type="submit">@Lang.Submit</button>
                    <button id="btnReset" class="btn btn-submit" type="reset">@Lang.Reset</button>
                </div>
            </div>
        </form>
    </div>
</div>