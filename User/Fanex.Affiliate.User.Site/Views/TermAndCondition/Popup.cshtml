@{
    Layout = null;
}

@using Fanex.Affiliate.User.Core.CoreService
@using Fanex.Affiliate.User.Core.Constants
@{
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var userSession = sessionService.UserSession;
}

@model string
@{
    var viewName = "~/Views/TermAndCondition/_Content." + Model + ".cshtml";
    var htmlString = SiteFriendlyNameHelper.Replace12Bet(Html.Partial(viewName).ToHtmlString());
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Lang.TermAndCondition</title>
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u" rel="stylesheet" crossorigin="anonymous">
    @if (sessionService.CurrentLanguage == SystemLanguage.VietNamLanguageCode)
    {
        <link href="@Url.RenderLink("~/www/build/styles/fonts/tahoma/font.css")" rel="stylesheet" />
    }
    else
    {
        <link href="@Url.RenderLink("~/www/build/styles/fonts/Montserrat/font.css")" rel="stylesheet" />
    }
    <link href="@Url.RenderLink("~/www/build/styles/css/main.css")" rel="stylesheet" />
</head>
<body>
    <div class="main-container">
        <div class="main">
            <div class="banner-side banner-left">
                <img src="~/www/build/styles/Images/banner-main-left.jpg?v=000001" alt="aff background" />
            </div>

            <div class="page-container">
                <div class="content">
                    <div class="page-title">
                        <span class="text">@Lang.TermAndCondition</span>
                    </div>

                    @Html.Raw(htmlString)

                    @RazorHelper.RenderMovingTopButton()
                </div>
            </div>

            <div class="banner-side banner-right">
                <img src="~/www/build/styles/Images/banner-main-right.jpg?v=000001" alt="aff background" />
            </div>
        </div>
    </div>

    @Html.InlineScripts("~/www/build/js/lib/modernizr-webp.js")
    <script>
        window.onscroll = function () { scrollFunction() };

        function scrollFunction() {
            var $button = document.getElementById("moveToTop");
            if ($button) {
                var display = (document.body.scrollTop > 200 || document.documentElement.scrollTop > 200) ? 'block' : 'none';
                $button.style.display = display;
            }
        }
    </script>
</body>
</html>