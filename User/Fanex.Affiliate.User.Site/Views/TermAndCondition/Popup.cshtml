@{
    Layout = null;
}
@using Fanex.Affiliate.User.Core.Constants
@model Fanex.Affiliate.User.Core.ViewModels.BaseLayoutViewModel
@{
    var currentLanguage = Model.CurrentLanguage;
    var htmlString = Html.RenderPartialByLanguage($"~/Views/TermAndCondition/_Content", Model.CurrentLanguage, Model.SiteFriendlyName);
    var siteName = Model.SiteName.ToLower();
    var isN8G = string.Equals(Model.SiteName, SiteName.N8G, StringComparison.CurrentCultureIgnoreCase);
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Lang.TermAndCondition</title>
    <link rel="icon" href=@Url.VersionedLink("~/favicon-" + siteName + ".ico")>

    <link href="~/www/build/styles/css/bootstrap-3.3.7.min.css" rel="stylesheet" />
    @if (currentLanguage == SystemLanguage.ChineseLanguageCode)
    {
        <link href="~/www/build/styles/fonts/noto-sans-sc/font.min.css" rel="stylesheet" />
    }
    else
    {
        if (isN8G)
        {
            <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,300;0,400;0,500;0,700;0,900;1,400&display=swap" rel="stylesheet">
        }
        else
        {
            <link href="~/www/build/styles/fonts/myriadPro/font.css" rel="stylesheet" />
        }
    }
    <link href="@Url.RenderLink("~/www/build/styles/css/main.css")" rel="stylesheet" />
    <link href="@Url.RenderLink("~/www/build/styles/css/" + siteName + ".css")" rel="stylesheet" />
</head>
<body class="@Model.CurrentLanguage">

    <div class="main-container">
        <div class="main">
            <div class="page-container">
                <div class="content term-condition-page">
                    <div class="page-title">
                        <span class="text">@Lang.TermAndCondition</span>
                    </div>

                    @Html.Raw(htmlString)

                    @RazorHelper.RenderMovingTopButton()
                </div>
            </div>
        </div>
    </div>

    @Html.InlineScripts("~/www/build/js/lib/modernizr-webp.js")
    <script>
        window.onscroll = function () { scrollFunction() };

        function scrollFunction() {
            var $button = document.getElementById("moveToTop");
            if ($button) {
                var display = (document.body.scrollTop > 200 || document.documentElement.scrollTop > 200) ? 'block' : 'none';
                $button.style.display = display;
            }
        }
    </script>
</body>
</html>