@using Fanex.Affiliate.User.Core.Constants
@model Fanex.Affiliate.User.Core.ViewModels.BaseLayoutViewModel
@{
    ViewBag.Title = Lang.TermAndCondition;
    Layout = "~/Views/Shared/N88/_LayoutBeforeLogin.cshtml";
}

@{
    var viewName = $"~/Views/TermAndCondition/N88/_Content.{Model.CurrentLanguage}.cshtml";

    var htmlString = Html.Partial(viewName, Model.SiteFriendlyName);
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/n88/left-menu-panel.js")
}

<div class="main-content main-content-left-panel">
    @RazorHelper.RenderLeftPanel(Menu.TermAndConditionMenuList)
    <div class="content">
        <div class="page-title">
            <span class="text">@Lang.TermAndCondition</span>
        </div>

        @Html.Raw(htmlString)

        @RazorHelper.RenderN88MovingTopButton()
    </div>
</div>