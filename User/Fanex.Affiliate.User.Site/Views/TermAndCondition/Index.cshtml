@using Fanex.Affiliate.User.Core.Constants
@model Fanex.Affiliate.User.Core.ViewModels.BaseLayoutViewModel
@{
    ViewBag.Title = Lang.TermAndCondition;
    Layout = PathHelper.GetLayoutPath("_LayoutBeforeLogin", Model.SiteName);
}

@{
    var isN88 = string.Equals(Model.SiteName, SiteName.N88, StringComparison.CurrentCultureIgnoreCase);
    var viewName = PathHelper.GetViewPath("TermAndCondition", $"_Content.{Model.CurrentLanguage}", Model.SiteName); ;

    var htmlString = SiteFriendlyNameHelper.ReplaceB2C(Html.Partial(viewName, Model.SiteFriendlyName).ToHtmlString());
}
@section styles{
    @Html.InlineStyles("~/www/build/styles/css/products.css")
}
@section scripts{
    @Html.InlineScripts("~/www/build/js/n88/left-menu-panel.js")
}

<div class="main-content term-condition">
    @if (isN88)
    {
        <div class="mobile-left-panel">
            <span>@Lang.ListCategory</span>
        </div>
