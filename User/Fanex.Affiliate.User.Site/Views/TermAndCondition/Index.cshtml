@model Fanex.Affiliate.User.Core.ViewModels.BaseLayoutViewModel
@{
    ViewBag.Title = Lang.TermAndCondition;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@{
    var viewName = $"~/Views/TermAndCondition/_Content.{Model.CurrentLanguage}.cshtml";

    var htmlString = Html.Partial(viewName, Model.SiteFriendlyName);
}

<div class="main-content term-condition">
    <div class="content">
        <div class="page-title">
            <span class="text">@Lang.TermAndCondition</span>
        </div>

        @Html.Raw(htmlString)

        @RazorHelper.RenderMovingTopButton()
    </div>
</div>