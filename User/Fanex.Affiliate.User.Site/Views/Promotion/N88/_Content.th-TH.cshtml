@{
    var bannerSrc = Url.Content($"~/www/build/styles/images/promotion-banners/N88/Promotion-45");

    var orgBannerSrc = $"{bannerSrc}.th-TH.jpg?v=166581";
    var mobileBannerSrc = $"{bannerSrc}.mobile.th-TH.jpg?v=166581";
}

<h2 class="text-bold">ข้อกำหนดและเงื่อนไข:</h2>
<div>
    <ol>
        <li>
            <p>
                โปรโมชั่นนี้สำหรับสมาชิกพันธมิตรที่ลงทะเบียนในสกุลเงินอินโดนีเซียรูเปีย ไทยบาท และมาเลเซียริงกิต
            </p>
        </li>
        <li>
            <p>
                โปรโมชั่นนี้เริ่มตั้งแต่วันที่ 1 มกราคม 2565 เวลา 00:00:00 น. (GMT+8) จนถึงวันที่ 28 กุมภาพันธ์ 2565 เวลา 23:59:59 น. (GMT+8)
            </p>
            <p>
                โปรโมชั่นนี้สำหรับผลิตภัณฑ์สล็อตเท่านั้น
            </p>
        </li>
        <li>
            <p>ผู้ที่มีสิทธิ์ได้ร่วมรับโปรโมชั่นนี้ จะต้องมีจำนวนสมาชิกที่มียอดเดิมพันโดยสมัครจากการแนะนำของคุณ อย่างน้อย 5 ราย</p>
            <p>ในการถอนการแบ่งปันของคุณ พันธมิตรต้องปฏิบัติตามขั้นต่ำ 100 ดอลล่าร์</p>
            <p>
                <div>ตัวอย่าง:</div>
                <div>ยอดกำไรสุทธิ = 10,000 ดอลล่าร์</div>
                <div>จำนวนสมาชิกที่มีการเดิมพัน >= 5</div>
                <div>ยอดค่าคอมมิชชั่นที่ท่านจะได้รับ = 10,000 x 80% = 8,000 ดอลล่าร์</div>
            </p>
        </li>
        <li>
            <p>Nova88 ขอสงวนสิทธิ์ในการถอดถอนโปรโมชั่น และปฏิเสธ หรือ ยกเลิก โปโมชั่นต่อสมาชิกพันธมิตรเป็นรายบุคคล ที่ละเมิดกฎข้อตกลงและเงื่อนไข</p>
        </li>
        <li>
            <p>หลังโปรโมชั่นนี้สิ้นสุดลง เปอร์เซ็นต์ค่าคอมมิชชั่นจะกลับไปมีค่าตามเดิม ตามข้อตกลงการรับค่าคอมมิชชั่นในเว็ปไซต์พันธมิตร</p>
        </li>
        <li>
            <p>ข้อกำหนดและเงื่อนไขของ Nova88 มีผลบังคับใช้</p>
        </li>
    </ol>
</div>

<div class="banner banner-80-percent">
    <picture>
        <source media="(max-width:480px)" srcset="@(mobileBannerSrc)" type="image/jpeg" />
        <source srcset="@(orgBannerSrc)" type="image/jpeg" />
        <img class="img-item img-responsive" src="@(orgBannerSrc)" alt="promtion banner 80%" />
    </picture>
</div>
