@{
    ViewBag.Title = Lang.Promotion;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";

}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/promotion.css")
}

@model string
@{
    var appSetting = AppSetting.Instance;
    var siteName = appSetting.SiteName;
    var jsVer = appSetting.JsVersion;
    var contentView = "~/Views/Promotion/" + appSetting.SiteName + "/_Content." + Model + ".cshtml";

    var htmlString = SiteFriendlyNameHelper.Replace12Bet(Html.Partial(contentView).ToHtmlString());
    var bannerSrc = Url.Content($"~/www/build/styles/images/promotion-banners/{siteName}/promotion");

    var orgBannerSrc = $"{bannerSrc}.{Model}.jpg?v={jsVer}";
    var mobileBannerSrc = $"{bannerSrc}.mobile.{Model}.jpg?v={jsVer}";
}

<div id="promotion" class="content">
    <div class="page-title">
        <span class="text">@Lang.Promotion</span>
    </div>
    <div class="banner">
        <div class="count-down">
            <div class="count-down-content">
                <div class="count-down-item day">
                    <div class="number">0</div>
                    <div class="count-down-text">@Lang.Day</div>
                </div>
                <div class="count-down-item hour">
                    <div class="number">0</div>
                    <div class="count-down-text">@Lang.Hour</div>
                </div>
                <div class="count-down-item min">
                    <div class="number">0</div>
                    <div class="count-down-text">@Lang.Min</div>
                </div>
                <div class="count-down-item sec">
                    <div class="number">0</div>
                    <div class="count-down-text">@Lang.Sec</div>
                </div>
            </div>
            <div class="count-down-btn">
                <a class="btn btn-login" href="~/Signup/Index">@Lang.JoinNow</a>
            </div>
        </div>
        <picture>
            <source media="(max-width:480px)" srcset="@(mobileBannerSrc)" type="image/jpeg" />
            <source srcset="@(orgBannerSrc)" type="image/jpeg" />
            <img class="img-item img-responsive" src="@(orgBannerSrc)" alt="promtion banner" />
        </picture>
    </div>

    <div class="main-content">
        @Html.Raw(htmlString)
    </div>


    @RazorHelper.RenderMovingTopButton()
</div>
<script>
    window.dic = { Finished: '@Lang.Finished' };
</script>
<script type="text/javascript" src="@Url.RenderLink("~/www/build/js/pages/promotion.js")"></script>