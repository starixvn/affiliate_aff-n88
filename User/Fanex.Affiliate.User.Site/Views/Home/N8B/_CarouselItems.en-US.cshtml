@{
    var maxCommission = AppSetting.Instance.MaxCommission;

    var sportBannerFileName = Url.Content($"~/www/build/styles/Images/sports-banners/N8B/AFF-Home-banner-SB");
    var advFileName = Url.Content($"~/www/build/styles/Images/apply/N8B/3step." + Model.Language);
}

<div class="item active">
    <picture>
        <source srcset="@(sportBannerFileName + ".webp?v=158572")" type="image/webp" />
        <source srcset="@(sportBannerFileName + ".jpg?v=158572")" type="image/jpeg" />
        <img class="img-item img-responsive" src="@(sportBannerFileName + ".jpg?v=158572")" alt="Sport Banner" />
    </picture>
    <div class="banner-text">
        <h2 class="txt-lang">
            @Html.Raw(string.Format(Lang.EarnUpTo, "<span class=\"special-yellow-text\"/>" + maxCommission +"</span>"))
        </h2>
        <h5 class="txt-lang sub-title">@Lang.JoinIn</h5>
        @if (!Model.IsAuthenticated)
        {
            <a id="sportBanner" class="nounderline" href="@Url.Content("~/Signup/Index")">@Lang.RegisterNow</a>
        }
    </div>
</div>

