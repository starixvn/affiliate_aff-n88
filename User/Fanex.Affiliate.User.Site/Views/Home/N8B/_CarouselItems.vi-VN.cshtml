@{
    var maxCommission = AppSetting.Instance.MaxCommission;

    var sportBannerFileName = Url.Content($"~/www/build/styles/Images/sports-banners/N8B/AFF-Home-banner-SB");
    var modbileSportBannerFileName = Url.Content($"~/www/build/styles/Images/sports-banners/N8B/AFF-Home-banner-SB.mobile");
    var advFileName = Url.Content($"~/www/build/styles/Images/apply/N8B/3step." + Model.Language);
}

<div class="item active">
    <picture>
        <source media="(max-width:480px)" srcset="@(modbileSportBannerFileName + ".webp?v=174504")" type="image/webp" />
        <source media="(max-width:480px)" srcset="@(modbileSportBannerFileName + ".jpg?v=174504")" type="image/jpeg" />
        <source srcset="@(sportBannerFileName + ".webp?v=174504")" type="image/webp" />
        <source srcset="@(sportBannerFileName + ".jpg?v=174504")" type="image/jpeg" />
        <img class="img-item img-responsive" src="@(sportBannerFileName + ".jpg?v=174504")" alt="Sport Banner" />
    </picture>
    <div class="banner-text banner-text-cn3">
        <h2 class="txt-lang">
            <span class="txt-lang-comm">50</span><strong class="txt-lang-percent">%</strong>
        </h2>
        <h3 class="sub-txt-lang">
            @Html.Raw(Lang.CommissionInBanner)
        </h3>
        <p class="sub-title">@Lang.WithAttractiveReward</p>
        @if (!Model.IsAuthenticated)
        {
            <a id="sportBanner" class="nounderline" href="@Url.Content("~/Signup/Index")">@Html.Raw(Lang.StartEarningNow)</a>
        }
    </div>
</div>

