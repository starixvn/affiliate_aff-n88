@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
    ViewBag.Title = Lang.Home;
}

@model Fanex.Affiliate.User.Core.ViewModels.HomeViewModel

@using Fanex.Affiliate.User.Core.CoreService
@using Fanex.Affiliate.User.Core.Constants

@{ 
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var shortedLangCode = SystemLanguage.GetShortedCodeForTracking(sessionService.CurrentLanguage);
    var siteName = AppSetting.Instance.SiteName;
    var sportBannerFileName = Url.Content($"~/www/build/styles/Images/sports-banners/{siteName}/AFF-Home-banner-SB." + Model.Language);
    var casinoBannerFileName = Url.Content($"~/www/build/styles/Images/casino-banners/AFF-Home-banner-Casino." + Model.Language);
    var advFileName = Url.Content($"~/www/build/styles/Images/apply/{siteName}/3step." + Model.Language);
}

@section styles{
    <link href="@Url.RenderLink("~/www/build/styles/css/home.css")" rel="stylesheet" />
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/pages/home.js")
}

<div class="content home-page">
    <div id="mainBanner" class="carousel slide banner-center" data-ride="carousel">
        <div class="carousel-inner" role="listbox">
            <div class="item active">
                <a id="sportBanner" class="nounderline" href="@(Model.IsAuthenticated ? Url.Content("~/UserPanel/Main/#AccountOverview") : Url.Content("~/Signup/Index"))">
                    <picture>
                        <source srcset="@(sportBannerFileName + ".webp")" type="image/webp" />
                        <source srcset="@(sportBannerFileName + ".jpg")" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(sportBannerFileName + ".jpg")" alt="Sport Banner" />
                    </picture>
                </a>
            </div>
            <div class="item">
                <a id="casinoBanner" class="nounderline" href="@Url.Content("~/Product/Index")">
                    <picture>
                        <source srcset="@(casinoBannerFileName + ".webp")" type="image/webp" />
                        <source srcset="@(casinoBannerFileName + ".jpg")" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(casinoBannerFileName + ".jpg")" alt="Casino Banner" />
                    </picture>
                </a>
            </div>
        </div>
        <a class="left carousel-control" href="#mainBanner" role="button" data-slide="prev">
            <span class="chevron left" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="right carousel-control" href="#mainBanner" role="button" data-slide="next">
            <span class="chevron right" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>
    <div class="news">
        <div class="item-wrapper first">
            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">
                        <span class="icon"><img src="~/www/build/styles/Images/icon-1.png" alt="icon-1" /></span>
                        <span class="text">@SiteFriendlyNameHelper.Replace12Bet(Lang.ApplyOneTwoBetAffiliate)</span>
                    </h4>
                    <a href="@Model.SignUpLink" class="nounderline">
                        <div class="img-content">
                            <picture>
                                <source srcset="@(advFileName + ".webp?v=20190226")" type="image/webp" />
                                <source srcset="@(advFileName + ".png?v=20190226")" type="image/jpeg" />
                                <img class="img-item img-responsive" src="@(advFileName + ".png?v=20190226")" alt="ads" />
                            </picture>
                        </div>
                        <p class="text-content">
                            @SiteFriendlyNameHelper.Replace12Bet(Lang.AsAOneTwoBetYouWillEarnCommission)
                        </p>
                    </a>
                </div>
            </div>
        </div>

        <div class="item-wrapper">
            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">
                        <span class="icon"><img src="~/www/build/styles/Images/icon-2.png" alt="icon-2" /></span>
                        <span class="text">@Lang.WhatNewInAffiliate</span>
                    </h4>
                    <div class="card-body">
                        <a href="@Url.Content("~/ContactUs")" class="img-content adv-contact @siteName">
                            <p class="text-1">@Lang.CannotGetEnough</p>
                            <p class="text-2">@Lang.YourCurrentCommision</p>
                            <span class="line"></span>
                            <p class="text-3">@Lang.ContactYourAffilliateSupportTeam</p>
                            <span class="btn">@Lang.ContactNow</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="item-wrapper last">
            <div class="card" id="affiliateNews">
                <div class="card-content">
                    <h4 class="card-title">
                        <span class="icon"><img src="~/www/build/styles/Images/icon-3.png" alt="icon-3" /></span>
                        <span class="text">@SiteFriendlyNameHelper.Replace12Bet(Lang.OneTwoBetAffiliateNews)</span>
                    </h4>
                    <div class="text-content">
                        <ul class="news-content">
                            <li>
                                <a class="nounderline mediaLink @(Model.IsAuthenticated ? string.Empty : "mediaLoginLink")" href="@Model.BannerLink">
                                    <span class="news-title">@Lang.NewBannerIsNowAvailable <span class="text-red" style="text-decoration:underline;">@Lang.NewWithExclamationPoint</span></span>
                                    <span>@Lang.YouCanNowLogInYourAffiliateAccount </span>
                                </a>
                            </li>
                            <li>
                                <a href="@Model.Promotion12BetLink" target="_blank" class="nounderline">
                                    <span class="news-title">@SiteFriendlyNameHelper.Replace12Bet(Lang.WhatNewInOneTwoBetPromotion) <span class="text-red" style="text-decoration:underline;">@Lang.NewWithExclamationPoint</span></span>
                                    <span>@SiteFriendlyNameHelper.Replace12Bet(Lang.GetToKnowHotPromotion)</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="shortedLangCode" value="@shortedLangCode" />
<input type="hidden" id="isCLickedBannerLink" value="0" />
