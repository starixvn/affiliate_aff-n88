@model Fanex.Affiliate.User.Core.ViewModels.HomeViewModel

@{
    var advFileName = Url.Content($"~/www/build/styles/Images/apply/N8G/3step." + Model.Language);
    var viewName = "~/Views/Home/N8G/_CarouselItems." + Model.Language + ".cshtml";
}


    <div id="mainBanner" class="carousel slide banner-center" data-ride="carousel">
        <div class="carousel-inner" role="listbox">
            @{ Html.RenderPartial(viewName, Model); }
        </div>
        @*<a class="left carousel-control" href="#mainBanner" role="button" data-slide="prev">
            <span class="chevron left" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="right carousel-control" href="#mainBanner" role="button" data-slide="next">
            <span class="chevron right" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
        </a>*@
    </div>
    <div class="news">
        <div class="item-wrapper first">
            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">
                        <span class="icon"><img src="~/www/build/styles/Images/icon-1.png" alt="icon-1" /></span>
                        <span class="text">@SiteFriendlyNameHelper.Replace12Bet(Lang.ApplyOneTwoBetAffiliate)</span>
                    </h4>
                    <div class="nounderline">
                        <div class="img-content">
                            <a href="@Model.SignUpLink">
                                <picture>
                                    <source srcset="@(advFileName + ".webp?v=158572")" type="image/webp" />
                                    <source srcset="@(advFileName + ".png?v=158572")" type="image/png" />
                                    <img class="img-item img-responsive" src="@(advFileName + ".png?v=158572")" alt="ads" />
                                </picture>
                            </a>
                        </div>
                        <p class="text-content">
                            @SiteFriendlyNameHelper.Replace12Bet(Lang.AsAOneTwoBetYouWillEarnCommission)
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="item-wrapper">
            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">
                        <span class="icon"><img src="~/www/build/styles/Images/icon-2.png" alt="icon-2" /></span>
                        <span class="text">@Lang.WhatNewInAffiliate</span>
                    </h4>
                    <div class="card-body">
                        <div class="img-content adv-contact N8G">
                            <p class="text-1">@Lang.CannotGetEnough</p>
                            <p class="text-2">@Lang.YourCurrentCommision</p>
                            <span class="line"></span>
                            <p class="text-3">@Lang.ContactYourAffilliateSupportTeam</p>
                            <a href="@Url.Content("~/ContactUs")" class="btn">@Lang.ContactNow</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="item-wrapper last">
            <div class="card" id="affiliateNews">
                <div class="card-content">
                    <h4 class="card-title">
                        <span class="icon"><img src="~/www/build/styles/Images/icon-3.png" alt="icon-3" /></span>
                        <span class="text">@SiteFriendlyNameHelper.Replace12Bet(Lang.OneTwoBetAffiliateNews)</span>
                    </h4>
                    <div class="text-content">
                        <ul class="news-content">
                            <li>
                                <a class="nounderline mediaLink @(Model.IsAuthenticated ? string.Empty : "mediaLoginLink")" href="@Model.BannerLink">
                                    <span class="news-title">@Lang.NewBannerIsNowAvailable <span class="text-red" style="text-decoration:underline;">@Lang.NewWithExclamationPoint</span></span>
                                    <span>@Lang.YouCanNowLogInYourAffiliateAccount </span>
                                </a>
                            </li>
                            <li>
                                <a href="@Model.Promotion12BetLink" target="_blank" class="nounderline">
                                    <span class="news-title">@SiteFriendlyNameHelper.Replace12Bet(Lang.WhatNewInOneTwoBetPromotion) <span class="text-red" style="text-decoration:underline;">@Lang.NewWithExclamationPoint</span></span>
                                    <span>@SiteFriendlyNameHelper.Replace12Bet(Lang.GetToKnowHotPromotion)</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>