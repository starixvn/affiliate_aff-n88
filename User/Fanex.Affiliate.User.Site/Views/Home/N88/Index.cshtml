@{
    Layout = "~/Views/Shared/N88/_LayoutHome.cshtml";
    ViewBag.Title = Lang.Home;
}

@model Fanex.Affiliate.User.Core.ViewModels.HomeViewModel

@{
    var desktopBannerPath = Url.Content($"~/www/build/styles/Images/home/n88/main-banners/main.desktop.{Model.Language}");
    var mobileBannerPath = Url.Content($"~/www/build/styles/Images/home/n88/main-banners/main.mobile.{Model.Language}");
    var advMobile = Url.Content($"~/www/build/styles/Images/apply/n88/3step.mobile.{Model.Language}");
    var advDesktop = Url.Content($"~/www/build/styles/Images/apply/n88/3step.desktop.{Model.Language}");

    var extraDesktopBannerPath = Url.Content($"~/www/build/styles/Images/home/n88/extra-banners/extra.desktop.{Model.Language}");
    var extraMobileBannerPath = Url.Content($"~/www/build/styles/Images/home/n88/extra-banners/extra.mobile.{Model.Language}");
    var faqHtmlString = Html.RenderPartialByLanguage("~/Views/Faq/N88/_Content", Model.Language, "N88").ToHtmlString();
    var htmlLifeTimeRevenue = Html.RenderPartialByLanguage($"~/Views/Home/N88/Content/LifeTimeRevenue", Model.Language, Model.SiteFriendlyName);
    var htmlCommission = Html.RenderPartialByLanguage($"~/Views/Home/N88/Content/Commission", Model.Language, Model.SiteFriendlyName);
    var htmlReceivedMonthlyCommission = Html.RenderPartialByLanguage($"~/Views/Home/N88/Content/ReceivedMonthlyCommission", Model.Language, Model.SiteFriendlyName);
    var htmlmonthlyIncome = Html.RenderPartialByLanguage($"~/Views/Home/N88/Content/MonthlyIncome", Model.Language, Model.SiteFriendlyName);
    var htmlNumberAffiliate = Html.RenderPartialByLanguage($"~/Views/Home/N88/Content/NumberAffiliate", Model.Language, Model.SiteFriendlyName);
    var htmlUserFriendly = Html.RenderPartialByLanguage($"~/Views/Home/N88/Content/UserFriendly", Model.Language, Model.SiteFriendlyName);
    var highlyDedicatedTeam = Html.RenderPartialByLanguage($"~/Views/Home/N88/Content/HighlyDedicatedTeam", Model.Language, Model.SiteFriendlyName);
    var htmlStepOne = Html.RenderPartialByLanguage($"~/Views/Home/N88/Content/StepOne", Model.Language, Model.SiteFriendlyName);
    var htmlStepTwo = Html.RenderPartialByLanguage($"~/Views/Home/N88/Content/StepTwo", Model.Language, Model.SiteFriendlyName);
    var htmlStepThree = Html.RenderPartialByLanguage($"~/Views/Home/N88/Content/StepThree", Model.Language, Model.SiteFriendlyName);
    var htmlStepFour = Html.RenderPartialByLanguage($"~/Views/Home/N88/Content/StepFour", Model.Language, Model.SiteFriendlyName);
}

@section styles{
    <link href="@Url.RenderLink("~/www/build/styles/css/home.css")" rel="stylesheet" />
    <link href="@Url.RenderLink("~/www/build/styles/css/faq.css")" rel="stylesheet" />
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/pages/home.js")
}

<div class="home-page home-new">
    <div class="home-banner">
        <img src="~/www/build/styles/Images/home/n88/NV88 Banner.png" alt="Banner" />
    </div>
    <div class="hot-news">
        @RazorHelper.RenderHotN88News()
    </div>
    <div class="why-become-aff">
        <div class="join-us-title">@Html.Raw(@Lang.WhyBecomeAff)</div>
        <div class="why-become-aff-row">
            <div class="left-block">
                <div class="join-us">

                    @Html.Raw(htmlLifeTimeRevenue)
                </div>
                <div class="why-become-aff-child-row pc">
                    <div class="marketing zoom-in ">
                        @Html.Raw(htmlUserFriendly)
                    </div>
                    <div class="marketing zoom-in ">
                        @Html.Raw(highlyDedicatedTeam)
                    </div>
                </div>
            </div>
            <div class="wrapper-right">
                <div class="sm left-com">
                    <div class="why-become-aff-child-row">
                        <div class="marketing zoom-in ">
                            @Html.Raw(htmlUserFriendly)
                        </div>
                        <div class="marketing zoom-in ">
                            @Html.Raw(highlyDedicatedTeam)
                        </div>
                    </div>
                </div>
                <div class="right-block zoom-in">

                    @Html.Raw(htmlCommission)
                </div>

            </div>
        </div>
        <div class="aff-com">
            <div class="left-aff-com zoom-in"> <img src="~/www/build/styles/Images/home/n88/Group 4.png" alt="Earning" /></div>
            <div class="right-aff-com">
                <div class="zoom-in aff-info">
                    @Html.Raw(htmlReceivedMonthlyCommission)
                </div>
                <div class="zoom-in aff-info">
                    @Html.Raw(htmlmonthlyIncome)
                </div>
                <div class="zoom-in aff-info">
                    @Html.Raw(htmlNumberAffiliate)
                </div>
            </div>
        </div>
    </div>
    <div class="partner">
        <div class="partner-title line-title"><span>@Html.Raw(@Lang.OfficialAsianBettingPartner)</span></div>
        <div class="carousel slide slide-mobile" id="slide-mobile" >
            <div class="partner-section carousel-inner" >
                <div class="item carousel-item active"><img src="~/www/build/styles/Images/home/n88/aston-villa-en 1.png" alt="Aston Villa" /></div>
                <div class="item carousel-item"><img src="~/www/build/styles/Images/home/n88/RR.png" alt="Sevilla FC" /></div>
                <div class="item carousel-item"><img src="~/www/build/styles/Images/home/n88/aston-villa-en 3.png" alt="Inter Milan" /></div>
            </div>
        </div>
    </div>
    <div class="apply-aff">
        <div class="apply-aff-title">@Html.Raw(@Lang.ApplyNova88Affiliate)</div>
        <div class="apply-aff-section">
            @Html.Raw(htmlStepOne)
            @Html.Raw(htmlStepTwo)
            @Html.Raw(htmlStepThree)
            @Html.Raw(htmlStepFour)
        </div>
    </div>
    <div class="be-the-next">
        <a class="home-button zoom-in" href="~/Signup/Index">@Lang.BeTheNext</a>
    </div>
    <div class="product-provider">
        <div class="product-provider-title block-title">@Html.Raw(Lang.OurProductsAndProviders)</div>
        <div id="our-product" class="our-product carousel slide slide-mobile"  >
            <div class="product-container carousel-inner">
                <div class="items zoom-in item  carousel-item active">
                    <img src="~/www/build/styles/Images/home/n88/product-sports.png" alt="Sportsbook" />
                    <div class="text">@Lang.Home_Sports</div>
                </div>
                <div class="items zoom-in item  carousel-item">
                    <img src="~/www/build/styles/Images/home/n88/product-e-sports.png" alt="E-Sports" />
                    <div class="text">@Lang.Home_E_Sports</div>
                </div>
                <div class="items zoom-in item  carousel-item">
                    <img src="~/www/build/styles/Images/home/n88/product-live-casino.png" alt="Live Casino" />
                    <div class="text">@Lang.Home_Live_Casino</div>
                </div>
                <div class="items zoom-in item  carousel-item">
                    <img src="~/www/build/styles/Images/home/n88/product-slots.png" alt="Slots" />
                    <div class="text">@Lang.Home_Slots</div>
                </div>
                <div class="items zoom-in item  carousel-item">
                    <img src="~/www/build/styles/Images/home/n88/product-fishing.png" alt="Fishing" />
                    <div class="text">@Lang.Home_Fishing</div>
                </div>
                <div class="items zoom-in item  carousel-item">
                    <img src="~/www/build/styles/Images/home/n88/product-number-game.png" alt="Number Game" />
                    <div class="text">@Lang.Home_Number_Game</div>
                </div>
                <div class="items zoom-in item  carousel-item">
                    <img src="~/www/build/styles/Images/home/n88/product-keno.png" alt="Keno" />
                    <div class="text">@Lang.Home_Keno</div>
                </div>
                <div class="items zoom-in item  carousel-item">
                    <img src="~/www/build/styles/Images/home/n88/product-lottery.png" alt="Lottery" />
                    <div class="text">@Lang.Home_Lottery</div>
                </div>
            </div>
        </div>
        <div id="provider" class="provider carousel slide" data-ride="carousel">
            <ol class="carousel-indicators">
                <li data-target="#provider" data-slide-to="5" class="active"></li>
                <li data-target="#provider" data-slide-to="7"></li>
            </ol>
            <div class="carousel-inner">
                <div class="item  carousel-item active">
                    <img src="~/www/build/styles/Images/home/n88/Provider/Frame 7245.png" alt="1" />
                </div>
                <div class="item carousel-item">
                    <img src="~/www/build/styles/Images/home/n88/Provider/Frame 7246.png" alt="2" />
                </div>
                <div class="item carousel-item">
                    <img src="~/www/build/styles/Images/home/n88/Provider/Frame 7247.png" alt="3" />
                </div>
                <div class="item carousel-item">
                    <img src="~/www/build/styles/Images/home/n88/Provider/Frame 7248.png" alt="4" />
                </div>
                <div class="item carousel-item">
                    <img src="~/www/build/styles/Images/home/n88/Provider/Frame 7249.png" alt="5" />
                </div>
                <div class="item carousel-item">
                    <img src="~/www/build/styles/Images/home/n88/Provider/Frame 7250.png" alt="6" />
                </div>
                <div class="item carousel-item">
                    <img src="~/www/build/styles/Images/home/n88/Provider/Frame 7251.png" alt="7" />
                </div>
                <div class="item carousel-item">
                    <img src="~/www/build/styles/Images/home/n88/Provider/Frame 7252.png" alt="8" />
                </div>
            </div>
            <button class="left carousel-control none-border" type="button" data-target="#provider" data-slide="prev">
                <span class="left chevron prev-button slide-button" aria-hidden="true"></span>
                <span class="sr-only">Previous</span>
            </button>
            <button class="right carousel-control none-border" type="button" data-target="#provider" data-slide="next">
                <span class="right chevron next-button slide-button" aria-hidden="true"></span>
                <span class="sr-only">Next</span>
            </button>
        </div>
    </div>
    <div class="your-turn">
        <a class="home-button zoom-in" href="~/Signup/Index">@Lang.YourTurnToTop</a>
    </div>
    <div class="faq">
        <div class="block-title">@Lang.Faqs</div>
        @Html.Raw(faqHtmlString)
    </div>
</div>

<input type="hidden" id="shortedLangCode" value="@Model.ShortedLanguageCode" />
<input type="hidden" id="isCLickedBannerLink" value="0" />
