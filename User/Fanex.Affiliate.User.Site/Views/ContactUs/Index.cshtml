@using Fanex.Affiliate.User.Core.CoreService
@model Fanex.Affiliate.User.Core.ViewModels.ContactUsViewModel

@{
    var settingService = DependencyResolver.Current.GetService<IAppSetting>();
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var siteName = settingService.SiteName;
    var layoutPath = siteName == "N88" ? "~/Views/Shared/N88/_LayoutBeforeLogin.cshtml" : "~/Views/Shared/_LayoutBeforeLogin.cshtml";
    var siteFriendlyName = settingService.SiteFriendlyName;
    var currentLanguage = sessionService.CurrentLanguage;

    Layout = layoutPath;
    ViewBag.Title = $"{siteFriendlyName} {Lang.AffiliateProgram} | {Lang.ContactUs}";
}

@section styles{
    <link href="@Url.RenderLink("~/www/build/styles/css/contact-us.css")" rel="stylesheet" />
}

@section scripts{
    <script src="@Url.RenderLink("~/www/build/js/validation.js")"></script>
    <script src="@Url.RenderLink("~/www/build/js/contact-us.js")"></script>
}

@{
    var contentClass = siteName == "N88" ? "main-content" : "content";
    var currentChannel = Model.ContactChannels?.FirstOrDefault(c =>
        c.MarketID?.Equals(ViewContext.HttpContext.Session["CurrentLanguage"]?.ToString(), StringComparison.OrdinalIgnoreCase) == true)
        ?? Model.ContactChannels?.FirstOrDefault();
    var imageBasePath = siteName == "N88" ? "~/www/build/styles/Images/contact-us/N88/" : "~/www/build/styles/Images/contact-us/";
}

<div class="@contentClass">
    <div class="content">
        <div class="page-title">
            <span class="text">@Lang.ContactUs</span>
        </div>

        <div class="slogan">
            <p>@Html.Raw(Lang.PleaseDirectAnyComment)</p>
        </div>

        <div class="alert alert-success" role="alert" id="messageSuccess" style="display: none;">
            <p class="text-center">Thank you for contacting us. We will get back to you shortly.</p>
        </div>

        <div class="alert alert-danger" role="alert" id="messageError" style="display: none"></div>

        <div id="mainContent">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-6">
                        <div class="contact-assistance">
                            <h3>Get Personal Assistance</h3>

                            @if (currentChannel != null)
                            {
                                if (!string.IsNullOrEmpty(currentChannel.Email))
                                {
                                    <div class="contact-item">
                                        <div class="contact-icon">
                                            <img class="contact-icon-img" src="@Url.Content(imageBasePath + "email.png")" alt="@Lang.EmailContactUs" />
                                        </div>
                                        <div class="contact-info">
                                            <a href="mailto:@currentChannel.Email">@currentChannel.Email</a>
                                        </div>
                                    </div>
                                }

                                if (!string.IsNullOrEmpty(currentChannel.Telegram))
                                {
                                    <div class="contact-item">
                                        <div class="contact-icon">
                                            <img class="contact-icon-img" src="@Url.Content(imageBasePath + "telegram.png")" alt="@Lang.Telegram" />
                                        </div>
                                        <div class="contact-info">
                                            <a href="@currentChannel.Telegram" target="_blank">@currentChannel.Telegram</a>
                                        </div>
                                    </div>
                                }

                                if (!string.IsNullOrEmpty(currentChannel.Whatsapp))
                                {
                                    <div class="contact-item">
                                        <div class="contact-icon">
                                            <img class="contact-icon-img" src="@Url.Content(imageBasePath + "whatsapp.png")" alt="@Lang.Whatsapp" />
                                        </div>
                                        <div class="contact-info">
                                            <a href="@currentChannel.Whatsapp" target="_blank">@currentChannel.Whatsapp</a>
                                        </div>
                                    </div>
                                }

                                if (!string.IsNullOrEmpty(currentChannel.Zalo))
                                {
                                    <div class="contact-item">
                                        <div class="contact-icon">
                                            <img class="contact-icon-img" src="@Url.Content(imageBasePath + "phone.png")" alt="Zalo" />
                                        </div>
                                        <div class="contact-info">
                                            <span>Zalo</span>
                                            <p>@currentChannel.Zalo</p>
                                        </div>
                                    </div>
                                }
                            }

                            <div class="operating-hours">
                                <h4>Operating Hours</h4>
                                <p>Monday - Friday</p>
                                <p>10:00 am - 08:00 pm (GMT +8)</p>
                                <p class="note">Support services are unavailable during weekends and public holidays</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="contact-form">
                            <h3>Get In Touch</h3>

                            @using (Html.BeginForm("Index", "ContactUs", FormMethod.Post, new { @id = "contactForm", @class = "form-horizontal" }))
                            {
                                @Html.AntiForgeryToken()

                                <div class="row">
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            <label class="control-label">@Lang.FName <span class="required">*</span></label>
                                            @Html.TextBoxFor(m => m.ContactForm.FirstName, new { @class = "form-control", @placeholder = "Your first name" })
                                            <span class="help-block hide"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            <label class="control-label">@Lang.LName <span class="required">*</span></label>
                                            @Html.TextBoxFor(m => m.ContactForm.LastName, new { @class = "form-control", @placeholder = "Your last name" })
                                            <span class="help-block hide"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="control-label">Email Address <span class="required">*</span></label>
                                    @Html.TextBoxFor(m => m.ContactForm.Email, new { @class = "form-control", @placeholder = "Your email address" })
                                    <span class="help-block hide"></span>
                                </div>

                                <div class="form-group">
                                    <label class="control-label">Subject of this message <span class="required">*</span></label>
                                    @Html.TextBoxFor(m => m.ContactForm.Subject, new { @class = "form-control", @placeholder = "Subject of this message" })
                                    <span class="help-block hide"></span>
                                </div>

                                <div class="form-group">
                                    <label class="control-label">Message</label>
                                    @Html.TextAreaFor(m => m.ContactForm.Message, new { @class = "form-control", @rows = 5, @placeholder = "Say something about us" })
                                    <span class="help-block hide"></span>
                                </div>

                                <div class="form-group">
                                    <button class="btn btn-submit btn-block" id="btnSubmit" type="submit">Submit</button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
