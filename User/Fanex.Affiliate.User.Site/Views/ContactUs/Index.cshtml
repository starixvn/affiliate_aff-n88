@using Fanex.Affiliate.User.Core.Utilities
@using Fanex.Affiliate.User.Core.Constants
@using Fanex.Affiliate.User.Core.CoreService

@{
    var appSetting = AppSetting.Instance;
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();

    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
    ViewBag.Title = $"{appSetting.SiteFriendlyName} Affiliate Program | Contact Us";

    var mailContact = appSetting.GetMailContactByLanguageCode(sessionService.CurrentLanguage);
    var phoneNumber = appSetting.PhoneNumber;
    var isN88 = string.Equals(appSetting.SiteName, SiteName.N88, StringComparison.CurrentCultureIgnoreCase);
    var isN8B = string.Equals(appSetting.SiteName, SiteName.N8B, StringComparison.CurrentCultureIgnoreCase);
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/contact-us.css")
}

@section scripts{
    <script>
        var resourceLanguage = {
            generalError: '@Error.General'
        }
    </script>
    @Html.InlineScripts("~/www/build/js/contactus.js")
}

<div class="content">
    <div class="page-title">
        <span class="text">@Lang.ContactUs</span>
    </div>

    <div class="container-fluid">
        @if (isN88)
        {
            <div class="row">
                <div class="col-sm-12">
                    <div class="date-time">
                        <div class="img-support">
                            <img class="img-responsive" src="~/www/build/styles/Images/contact-us/contact.png" />
                        </div>
                        <div class="date-time-info">
                            <p class="text-center">@Html.Raw(Lang.SupportTimeN88)</p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-12">
                    <div class="contact-form text-center">
                        <div id="mainContent">
                            <p class="intro">@Html.Raw(string.Format(SiteFriendlyNameHelper.Replace12Bet(Lang.PleaseDirectAnyCommentN88), "<a href=\"mailto:" + mailContact + "\">" + mailContact + "</a>"))</p>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row contact-title">
                <p>@Html.Raw(Lang.PleaseDirectAnyComment)</p>
            </div>
            if (isN8B)
            {
                <div class="row contact-icon-group">
                    <div class="col-xs-12">
                        <div class="contact-icon">
                            <img class="img-responsive" src="~/www/build/styles/Images/contact-us/email.png" />
                        </div>
                        <div class="text-center">
                            <strong>Email</strong>
                            <p class="intro"><a href=@("mailto:" + mailContact)>@mailContact</a></p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="row contact-icon-group">
                    <div class="col-xs-12 col-sm-6 col-md-3">
                        <div class="contact-icon">
                            <img class="img-responsive" src="~/www/build/styles/Images/contact-us/phone.png" />
                        </div>
                        <div class="text-center">
                            <strong>@Lang.Phone</strong>
                            <p>@phoneNumber</p>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-3">
                        <div class="contact-icon">
                            <img class="img-responsive" src="~/www/build/styles/Images/contact-us/email.png" />
                        </div>
                        <div class="text-center">
                            <strong>Email</strong>
                            <p class="intro"><a href=@("mailto:" + mailContact)>@mailContact</a></p>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-3">
                        <div class="contact-icon">
                            <img class="img-responsive" src="~/www/build/styles/Images/contact-us/telegram.png" />
                        </div>
                        <div class="text-center">
                            <strong>Telegram</strong>
                            <p>@phoneNumber</p>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-3">
                        <div class="contact-icon">
                            <img class="img-responsive" src=@Url.Content("~/www/build/styles/Images/contact-us/" + appSetting.SiteFriendlyName + ".jpg") />
                        </div>
                        <div class="text-center">
                            <strong>Zalo</strong>
                            <p>@phoneNumber</p>
                        </div>
                    </div>
                </div>
            }
            <div class="row">
                <div class="col-sm-12">
                    <div class="date-time-info">
                        <p class="text-center">@Html.Raw(Lang.SupportTime)</p>
                    </div>
                </div>
            </div>
        }
    </div>
    </div>