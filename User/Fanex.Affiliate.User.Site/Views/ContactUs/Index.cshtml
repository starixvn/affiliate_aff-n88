@using Fanex.Affiliate.User.Core.Utilities
@using Fanex.Affiliate.User.Core.Constants

@model Fanex.Affiliate.User.Core.DTO.UserInfo
@{
    var appSetting = AppSetting.Instance;

    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
    ViewBag.Title = $"{appSetting.SiteFriendlyName} Affiliate Program | Contact Us";

    var name = Model != null ? $"{Model?.FirstName} {Model?.LastName}" : string.Empty;
    var affiliate = Model?.UserName;
    var email = Model?.Email;
    var mailContact = appSetting.MailContact;
    var isN88 = string.Equals(appSetting.SiteName, SiteName.N88, StringComparison.CurrentCultureIgnoreCase);
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/contact-us.css")
}

@section scripts{
    <script>
        var resourceLanguage = {
            generalError: '@Error.General'
        }
    </script>
    @Html.InlineScripts("~/www/build/js/contactus.js")
}

<div class="content">
    <div class="page-title">
        <span class="text">@Lang.ContactUs</span>
    </div>

    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-3">
                <div class="date-time">
                    <div class="img-support">
                        <img class="img-responsive" src="~/www/build/styles/Images/contact-us/contact.png" />
                    </div>
                    <div class="date-time-info">
                        <p class="text-center">@Html.Raw(Lang.SupportTime)</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-9">
                @*<div class="flex flex-wrap">
            <div class="flex-sm-6 flex-0 language-wrap-item">
                <div class="languages-item">
                    <div class="single-flag">
                        <img src="~/www/build/styles/Images/contact-us/english_lang.png" />
                    </div>
                    <div class="info">
                        <p class="language">@Lang.EnglishSupport</p>
                        <a class="contact-info" href="skype:affiliate@(AppSetting.Instance.SiteFriendlyName)">
                            <img class="im-icon" src="~/www/build/styles/Images/contact-us/skype_icon.png" />
                            <span>affiliate@(AppSetting.Instance.SiteFriendlyName)</span>
                        </a>
                    </div>
                </div>
            </div>
            <div class="flex-sm-6 flex-0 language-wrap-item">
                <div class="languages-item">
                    <div class="single-flag">
                        <img src="~/www/build/styles/Images/contact-us/vietnam_lang.png" />
                    </div>
                    <div class="info">
                        <p class="language">@Lang.VietnamSupport</p>
                        <a class="contact-info" href="skype:crmsupport.1">
                            <img class="im-icon" src="~/www/build/styles/Images/contact-us/skype_icon.png" />
                            <span>crmsupport.1</span>
                        </a>
                        <span class="contact-info info-zalo">
                            <img class="im-zalo" src="~/www/build/styles/Images/contact-us/zalo.png" />
                            <span>+63 927 684 2457</span>
                        </span>
                    </div>
                </div>
