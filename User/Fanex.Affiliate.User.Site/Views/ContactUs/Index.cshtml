@model Fanex.Affiliate.User.Core.ViewModels.ContactUsViewModel

@{
    Layout = PathHelper.GetLayoutPath("_LayoutBeforeLogin", Model.SiteName);
    ViewBag.Title = $"{Model.SiteFriendlyName} {Lang.AffiliateProgram} | {Lang.ContactUs}";

    var viewName = PathHelper.GetViewPath("ContactUs", "_Content", Model.SiteName);
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/contact-us.css")
}

@section scripts{
    <script>
        var resourceLanguage = {
            generalError: '@Error.General'
        }
    </script>
    @Html.InlineScripts("~/www/build/js/contactus.js")
}



<div class="main-content">
    <div class="content">
        <div class="page-title">
            <span class="text">@Lang.ContactUs</span>
        </div>
        <div class="slogan">
            Please direct any comments or questions to following contact points:
        </div>
        @{ Html.RenderPartial(viewName, Model.MailContact); }
    </div>
</div>
