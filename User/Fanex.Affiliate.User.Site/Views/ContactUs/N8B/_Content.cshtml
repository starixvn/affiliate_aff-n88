@model string

<div class="container-fluid">
        <div class="row contact-title">
            <p>@Html.Raw(Lang.PleaseDirectAnyComment)</p>
        </div>
        <div class="row contact-icon-group">
            <div class="col-xs-12 col-sm-4">
                <div class="contact-icon">
                    <img class="img-responsive" src="~/www/build/styles/Images/contact-us/email.png" alt="email icon" />
                </div>
                <div class="text-center">
                    <strong>Email</strong>
                    <p class="intro"><a href=@("mailto:" + Model)>@Model</a></p>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4">
                <div class="contact-icon">
                    <img class="img-responsive" src="~/www/build/styles/Images/contact-us/telegram.png" alt="telegram icon" />
                </div>
                <div class="text-center">
                    <strong>Telegram</strong>
                    <p class="intro"><a href="https://cli.re/bwing-affiliate">https://cli.re/bwing-affiliate</a></p>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4">
                <div class="contact-icon">
                    <img class="img-responsive" src=@Url.Content("~/www/build/styles/Images/contact-us/bwing.png") alt="zalo icon" />
                </div>
                <div class="text-center">
                    <strong>Zalo</strong>
                    <p>(+63) 9456383158</p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="date-time-info">
                    <p class="text-center">@Html.Raw(Lang.SupportTime)</p>
                </div>
            </div>
        </div>
    </div>