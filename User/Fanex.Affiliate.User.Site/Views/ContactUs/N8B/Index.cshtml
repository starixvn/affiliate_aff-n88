@model Fanex.Affiliate.User.Core.ViewModels.ContactUsViewModel

@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
    ViewBag.Title = $"Bwing {Lang.AffiliateProgram} | {Lang.ContactUs}";
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/contact-us.css")
}

<div class="content">
    <div class="page-title">
        <span class="text">@Lang.ContactUs</span>
    </div>
    <div class="container-fluid">
        <div class="row contact-title">
            <p>@Html.Raw(Lang.PleaseDirectAnyComment)</p>
        </div>
        <div class="row contact-icon-group">
            <div class="col-xs-12 col-sm-4">
                <div class="contact-icon">
                    <img class="img-responsive" src="~/www/build/styles/Images/contact-us/email.png" alt="email icon" />
                </div>
                <div class="text-center">
                    <strong>Email</strong>
                    <p class="intro"><a href=@("mailto:" + Model.MailContact)>@Model.MailContact</a></p>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4">
                <div class="contact-icon">
                    <img class="img-responsive" src="~/www/build/styles/Images/contact-us/telegram.png" alt="telegram icon" />
                </div>
                <div class="text-center">
                    <strong>Telegram</strong>
                    <p class="intro"><a href="https://cli.re/bwing-affiliate">https://cli.re/bwing-affiliate</a></p>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4">
                <div class="contact-icon">
                    <img class="img-responsive" src=@Url.Content("~/www/build/styles/Images/contact-us/whatsapp.png") alt="whatsapp icon" />
                </div>
                <div class="text-center">
                    <strong>@Lang.Whatsapp</strong>
                    <p class="intro"><a href="https://cli.re/bwingdaily">https://cli.re/bwingdaily</a></p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="date-time-info">
                    <p class="text-center">@Html.Raw(Lang.SupportTime)</p>
                </div>
            </div>
        </div>
    </div>
</div>
