@model string

@{
    Layout = "~/Views/Shared/N88/_LayoutBeforeLogin.cshtml";
    ViewBag.Title = $"Nova88 {Lang.AffiliateProgram} | {Lang.ContactUs}";
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/contact-us.css")
    @Html.InlineStyles("~/www/build/styles/css/n88/contact-us.css")
}

<div class="main-content">
    <div class="content">
        <div class="page-title">
            <span class="text">@Lang.ContactUs</span>
        </div>
        <div class="slogan">
            <p>@Html.Raw(Lang.PleaseDirectAnyComment)</p>
        </div>
        <div class="grid-contact-info">
            <div class="contact-items">
                <ul class="info-social">
                    <li>
                        <img src="~/www/build/styles/Images/contact-us/N88/email.png" alt="@Lang.EmailContactUs" />
                        <span>@Lang.EmailContactUs</span>
                    </li>
                    <li><a href=@("mailto:" + Model)>@Model</a></li>
                </ul>
            </div>
            <div class="contact-items">
                <ul class="info-social">
                    <li>
                        <img src="~/www/build/styles/Images/contact-us/N88/telegram.png" alt="@Lang.Telegram" />
                        <span>@Lang.Telegram</span>
                    </li>
                    <li><a href="https://t.me/nova88affiliate">https://t.me/nova88affiliate</a></li>
                </ul>
            </div>
            <div class="contact-items">
                <ul class="info-social">
                    <li>
                        <img src="~/www/build/styles/Images/contact-us/N88/whatsapp.png" alt="@Lang.Whatsapp" />
                        <span>@Lang.Whatsapp</span>
                    </li>
                    <li><a href="https://cli.re/nova88affiliate">https://cli.re/nova88affiliate</a></li>
                </ul>
            </div>
        </div>

        <div class="date-time-info">
            <p class="text-center">@Html.Raw(Lang.SupportTimeN88)</p>
        </div>
    </div>
</div>