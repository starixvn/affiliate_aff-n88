@model string

<div class="row contact-icon-group">
    <div class="col-xs-12 col-sm-4">
        <div class="contact-icon">
            <img class="img-responsive" id="email_icon" alt="email icon" />
        </div>
        <div class="text-center">
            <strong>@Lang.Email1</strong>
            <p class="intro"><a href=@("mailto:" + Model)>@Model</a></p>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4">
        <div class="contact-icon">
            <img class="img-responsive" id="telegram_icon" alt="telegram icon" />
        </div>
        <div class="text-center">
            <strong>@Lang.Telegram</strong>
            <p class="intro"><a href="https://t.me/nova88affiliate">https://t.me/nova88affiliate</a></p>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4">
        <div class="contact-icon">
            <img class="img-responsive" id="whatsapp_icon" alt="whatsapp icon" />
        </div>
        <div class="text-center">
            <strong>@Lang.Whatsapp</strong>
            <p class="intro"><a href="https://cli.re/nova88affiliate">https://cli.re/nova88affiliate</a></p>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-12">
        <div class="date-time-info">
            <p class="text-center">@Html.Raw(Lang.SupportTimeN88)</p>
        </div>
    </div>
</div>