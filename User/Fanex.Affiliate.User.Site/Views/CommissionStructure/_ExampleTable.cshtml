@model Fanex.Affiliate.User.Core.ViewModels.RevenueSharingStructureViewModel

<div class="table table-responsive" style="max-width: 1000px; margin: 15px auto;">
    <table>
        <thead>
            <tr>
                <th width="10%"></th>
                <th width="40%">@Lang.ActiveReferredPlayers</th>
                <th width="40%">@string.Format(Lang.NetWinLoss, Model.DefaultCurrency)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="text-center">1</td>
                <td class="text-center">P1</td>
                <td class="text-center">345,000,000</td>
            </tr>
            <tr>
                <td class="text-center">2</td>
                <td class="text-center">P2</td>
                <td class="text-center">667,000,000</td>
            </tr>
            <tr>
                <td class="text-center">3</td>
                <td class="text-center">P3</td>
                <td class="text-center">391,000,000</td>
            </tr>
            <tr>
                <td class="text-center">4</td>
                <td class="text-center">P4</td>
                <td class="text-center">540,500,000</td>
            </tr>
            <tr>
                <td class="text-center">5</td>
                <td class="text-center">P5</td>
                <td class="text-center">529,000,000</td>
            </tr>
            <tr>
                <td colspan="2" class="text-center">@Lang.Total</td>
                <td class="text-center">2,472,500,000 (@Lang.Tier 3)</td>
            </tr>
            <tr>
                <td colspan="2" class="text-center">@Lang.YourRevenueShare</td>
                <td class="text-center">2,472,500,000 x @(Model.MaxCommission) = <strong>1,236,250,000</strong></td>
            </tr>
        </tbody>
    </table>
</div>
