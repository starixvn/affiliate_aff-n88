@using Fanex.Affiliate.User.Core.Constants
@{
    var appSetting = AppSetting.Instance;
    var isN88 = string.Equals(appSetting.SiteName, SiteName.N88, StringComparison.CurrentCultureIgnoreCase);
}
<div class="table table-responsive" style="max-width: 1000px; margin: 15px auto;">
    <table>
        <thead>
            <tr>
                <th width="10%"></th>
                <th width="40%">@Lang.ActiveReferredPlayers</th>
                <th width="40%">@string.Format(Lang.NetWinLoss, appSetting.DefaultCurrency)</th>
            </tr>
        </thead>
        <tbody>
            @if (isN88)
            {
                <tr>
                    <td class="text-center">1</td>
                    <td class="text-center">P1</td>
                    <td class="text-center">15,000</td>
                </tr>
                <tr>
                    <td class="text-center">2</td>
                    <td class="text-center">P2</td>
                    <td class="text-center">29,000</td>
                </tr>
                <tr>
                    <td class="text-center">3</td>
                    <td class="text-center">P3</td>
                    <td class="text-center">17,000</td>
                </tr>
                <tr>
                    <td class="text-center">4</td>
                    <td class="text-center">P4</td>
                    <td class="text-center">45,000</td>
                </tr>
                <tr>
                    <td class="text-center">5</td>
                    <td class="text-center">P5</td>
                    <td class="text-center">23,000</td>
                </tr>
                <tr>
                    <td colspan="2" class="text-center">@Lang.Total</td>
                    <td class="text-center">129,000 (@Lang.Tier 3)</td>
                </tr>
                <tr>
                    <td colspan="2" class="text-center">@Lang.YourRevenueShare</td>
                    <td class="text-center">129,000 x 45% = <strong>58,050</strong></td>
                </tr>
            }
            else
            {
                <tr>
                    <td class="text-center">1</td>
                    <td class="text-center">P1</td>
                    <td class="text-center">345,000,000</td>
                </tr>
                <tr>
                    <td class="text-center">2</td>
                    <td class="text-center">P2</td>
                    <td class="text-center">667,000,000</td>
                </tr>
                <tr>
                    <td class="text-center">3</td>
                    <td class="text-center">P3</td>
                    <td class="text-center">391,000,000</td>
                </tr>
                <tr>
                    <td class="text-center">4</td>
                    <td class="text-center">P4</td>
                    <td class="text-center">1,035,000,000</td>
                </tr>
                <tr>
                    <td class="text-center">5</td>
                    <td class="text-center">P5</td>
                    <td class="text-center">529,000,000</td>
                </tr>
                <tr>
                    <td colspan="2" class="text-center">@Lang.Total</td>
                    <td class="text-center">2,967,000,000 (@Lang.Tier 3)</td>
                </tr>
                <tr>
                    <td colspan="2" class="text-center">@Lang.YourRevenueShare</td>
                    <td class="text-center">2,967,000,000 x 50% = <strong>1,483,500,000</strong></td>
                </tr>
            }
        </tbody>
    </table>
</div>
