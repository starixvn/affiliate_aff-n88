@model Fanex.Affiliate.User.Core.ViewModels.RevenueSharingStructureViewModel

<section class="info-group" id="WhatWeHave">
    <div class="title">
        <span class="text">আমাদের যা আছে </span>
    </div>
    <ul>
        <li class="text">
            Top-notch gaming and online betting products such as Sports, Live Casino, Virtual Sports, Keno, Slot games, plus a wide selection of games
        </li>
        <li class="text">
            শীর্ষস্থানীয় গেমিং এবং অনলাইন বেটিং পণ্য যেমন খেলাধূলা, লাইভ ক্যাসিনো, ভার্চুয়াল স্পোর্টস, কেনো, স্লট গেমস এবং সকাল ধরনের খেলাধূলা
        </li>
        <li class="text">
            কৌশলগত বিপণন সরঞ্জাম উচ্চ সদস্য রূপান্তর এবং ধরে রাখার হার নিশ্চিত করে
        </li>
    </ul>
</section>
<section class="info-group" id="WhatWeOffer">
    <div class="title">
        <span class="text">আমরা কি অফার করি</span>
    </div>
    <ul>
        <li class="text">
            সর্বোচ্চ @Model.MaxCommission ভাগ রাজস্ব শেয়ার
        </li>
        <li class="text">
            10% আরও  যোগ করতে আপনার  সাব-অ্যাফিলিয়েট হিসাবে আমাদের অ্যাফিলিয়েট প্রোগ্রামে যোগ দিতে এবং আপনার পুরষ্কার পেতে বন্ধুদের নিয়োগ করুন!
        </li>
        <li class="text">
            আপনার কর্মক্ষমতা ট্র্যাকিং জন্য কার্যকর এবং সহজে ব্যবহার ব্যবস্থাপনা সিস্টেম
        </li>
        <li class="text">
            বন্ধুত্বপূর্ণ এবং পেশাদার এফিলিয়াট্স দল  সবসময় আপনাকে সাহায্য করতে প্রস্তুত
        </li>
    </ul>
</section>
<section class="info-group" id="OurPlan">
    <div class="title">
        <span class="text">আমাদের পরিকল্পনা</span>
    </div>
    <p class="text">
        আপনার রাজস্ব ভাগ দুটি অংশ নিয়ে গঠিত: (i) আপনার উল্লেখ করা খেলোয়াড়ের বাজির ক্ষতি থেকে এবং (ii) আপনার রেফার করা অ্যাফিলিয়েটের রাজস্ব ভাগ থেকে
    </p>
    <ol type="i">
        <li class="text-block">
            <strong>Fixed Revenue Share:</strong>
            @{ Html.RenderPartial("~/Views/CommissionStructure/N88/_RevenueShareTable.cshtml", Model.MaxCommission); }
            <ul>
                <li class="text" style="margin-top: 15px;">
                    <strong>কোম্পানি মোট জয় :</strong> Nova 88 এ আপনার দ্বারা সুপারিশকৃত মাসিক মোট ক্ষতি
                </li>
                <li class="text">
                    <strong>সক্রিয় খেলোয়াড়:</strong> সদস্য যারা মাসে অন্তত একটি (1) বাজি রেখেছেন।
                </li>
                <li class="text">
                    যে কোনো মাসের জন্য নেতিবাচক রাজস্ব ভাগ পরবর্তী মাসে এগিয়ে নিয়ে যাওয়া হবে।
                </li>
                <li class="text">
                    সমস্ত অনুমোদিত সদস্যদের এফিলিয়েটস  সরাসরি ব্যয় করা প্রশাসনিক এবং মার্কেটিং  খরচ সাপেক্ষে।
                </li>
                <li class="text">
                    মাসিক ভিত্তিতে রাজস্ব থেকে খরচ বাদ দেওয়া হবে । এই খরচ নিম্নলিখিত অন্তর্ভুক্ত হতে পারে:
                    <ul class="dash">
                        <li>
                            <strong>ব্যাঙ্কিং ফি</strong> - সমস্ত অনুমোদিত এফিলিয়াটস গ্রাহকদের জড়িত প্রতিটির জন্য জমা এবং উত্তোলনের চার্জ
                        </li>
                        <li>
                            <strong>রয়্যালটি ফি</strong> - পণ্য রয়্যালটি ফি - যা এফিলিয়াটস  গ্রাহক দ্বারা খেলা পণ্য থেকে GGR আর ১০ শতাংশ
                        </li>
                        <li>
                            <strong>প্রচার বোনাস</strong> - এফিলিয়াটস গ্রাহকদেড় আর্থিক বোনাস বা বাট্টা দেয়া হয়
                        </li>
                    </ul>
                </li>
            </ul>
            <br />
            <p class="text">উদাহরণ</p>
            <p class="text"><i><strong>ইতিবাচক রাজস্ব</strong></i></p>
            <div style="padding-left: 25px;">
                <p class="text">Gross Revenue = USD 18,000</p>
                <p class="text">Bonus Expenses = USD 1,000</p>
                <p class="text">Transaction Fees = USD 180</p>
                <p class="text">Royalty Fees = USD 1,100</p>
                <p class="text">Commission = </p>
                <p class="text">(Gross Revenue - Bonus Expenses - Transaction Fees - Royalty Fees) x Revenue Share %</p>
                <p class="text">(18,000 - 1,000 - 180 - 1,100) x 45% = USD 7,074</p>
            </div>

            <p class="text"><i><strong>Negative Revenue</strong></i></p>
            <div style="padding-left: 25px;">
                <p class="text">Gross revenue = - USD 8,000</p>
                <p class="text">Member’s bonus = USD 698</p>
                <p class="text">Transaction Fees = USD 127</p>
                <p class="text">Commission = </p>
                <p class="text">(Gross Revenue - Bonus Expenses - Transaction Fees) x Revenue Share %</p>
                <p class="text">(-8,000 - 698 - 127) x 45% = USD -3,971.25 (Carry forward to following month)</p>
            </div>
        </li>
        <li class="text-block">
            <strong>Sub-Affiliate Structure:</strong> you will be eligible to receive an extra 10% from your referred affiliates’ revenue share,
            and as long as they bring other affiliates in, you can also have a share from their sub-affiliates’ revenue share either!
        </li>
    </ol>
</section>
<section class="info-group" id="RevenueSharePayoutExample">
    <div class="title">
        <span class="text"><i>Revenue Share Payout Example</i></span>
    </div>
    <p class="text">
        <i>Figure 1:</i> An example to show you how your revenue share earned from your referred players is calculated
    </p>
    @{ Html.RenderPartial($"~/Views/CommissionStructure/{Model.SiteName}/_ExampleTable.cshtml", Model); }
    <p class="text">
        <i>Figure 2:</i> An example to show you how your revenue share earned from your referred affiliates (and their sub-affiliates) is calculated
    </p>
    <div class="img-support" style="max-width: 600px; margin: 15px auto;">
        <img class="img-responsive" src="~/www/build/styles/Images/revenue-share-structure/@(Model.SiteName)/revenue_share_hierarchy.@(Model.CurrentLanguage).png?v=174504" alt="hierarchy banner" />
    </div>
    <p class="text">
        Your revenue share earned from the referred affiliates:
    </p>
    <div style="padding-left: 30px;">
        <p class="text">
            = [B1+ ((C1 + C2) * 10%)]*10% + [B2 * 10%]
        </p>
        <p class="text">
            = [0 + (50,000 + 30,000) * 10%)]*10% + [70,000 * 10%]
        </p>
        <p class="text">
            = USD 7,800
        </p>
    </div>
    <p class="text">
        <strong>=></strong> Your total revenue share for the month would be: 58,050 + 7,800 = <strong>USD 65,850</strong>
    </p>
</section>
<section class="info-group" id="HowWePay">
    <div class="title">
        <span class="text">How we pay</span>
    </div>
    <ul>
        <li class="text">
            Once a month, through your @Model.SiteFriendlyName player account (in USD, THB, MYR, IDR & CNY) and the minimum withdrawal amount is USD 100. For other currencies need to request from NOVA88 Affiliate team.
        </li>
        <li class="text">
            Any 2nd withdrawal request in the same month shall be subject to @Model.SiteFriendlyName Affiliates team’s approval.
        </li>
    </ul>
</section>