@model Fanex.Affiliate.User.Core.ViewModels.RevenueSharingStructureViewModel

<section class="info-group" id="WhatWeHave">
    <div class="title">
        <span class="text">Chúng Tôi Sở Hữu</span>
    </div>
    <ul>
        <li class="text">
            Những sản phẩm cá cược hàng đầu như Thể Thao, Casino Trực Tiếp, Thể Thao Ảo, Keno, Trò chơi Xèng, và vô số các trò chơi trực tuyến khác
        </li>
        <li class="text">
            Thương hiệu danh tiếng, hỗ trợ hơn 2 ngôn ngữ khác nhau, dễ dàng thu hút khách hàng tham gia
        </li>
        <li class="text">
            Chiến lược tiếp thị uy tín, đảm bảo tỷ lệ chuyển đổi và duy trì thành viên luôn ở mức cao nhất
        </li>
    </ul>
</section>
<section class="info-group" id="WhatWeOffer">
    <div class="title">
        <span class="text">Quyền Lợi Khi Tham Gia</span>
    </div>
    <ul>
        <li class="text">
            Chiết khấu hoa hồng lên đến @Model.MaxCommission
        </li>
        <li class="text">
            Thưởng thêm 10% - khi giới thiệu thành công bạn bè tham gia chương trình cộng tác của chúng tôi với tư cách là Đại Lý Cấp Dưới
        </li>
        <li class="text">
            Hệ thống quản lý hiệu quả và dễ sử dụng để theo dõi hiệu suất kinh doanh của bạn
        </li>
        <li class="text">
            Đội ngũ tư vấn thân thiện và chuyên nghiệp luôn sẵn sàng hỗ trợ bạn
        </li>
    </ul>
</section>
<section class="info-group" id="OurPlan">
    <div class="title">
        <span class="text">Kế Hoạch Của Chúng Tôi</span>
    </div>
    <p class="text">
        Bạn có thể nhận tiền hoa hồng từ cả hai (2) cách: (i) tiền thua cược của người chơi mà bạn giới thiệu và (ii) hoa hồng của các Đại Lý Cấp Dưới do bạn giới thiệu:
    </p>
    <ol type="i">
        <li class="text-block">
            <strong>Chia sẻ doanh thu cố định:</strong>
            @{ Html.RenderPartial("~/Views/CommissionStructure/N88/_RevenueShareTable.cshtml", Model.MaxCommission); }
            <ul>
                <li class="text" style="margin-top: 15px;">
                    <strong>Tiền lãi thực của công ty:</strong> tiền lãi từ những người chơi được bạn giới thiệu cho Nova88.
                </li>
                <li class="text">
                    <strong>Người Chơi Đủ Điều Kiện:</strong> người chơi có ít nhất một (1) cược trong tháng đó.
                </li>
                <li class="text">
                    Khoản tiền hoa hồng bị âm trong tháng sẽ được cộng dồn cho tháng tiếp theo.
                </li>
                <li class="text">
                    Tất cả Đại Lý phải chịu phí quản lý và phí quảng cáo phát sinh trực tiếp để thu hút khách hàng.
                </li>
                <li class="text">
                    Các Chi phí sẽ được trừ vào doanh thu từng tháng gồm:
                    <ul class="dash">
                        <li>
                            <strong>Phí ngân hàng</strong> - Phí Gửi và Rút tiền từ giao dịch của người chơi thuộc Đại Lý.
                        </li>
                        <li>
                            <strong>Phí bản quyền</strong> - Phí bản quyền sản phẩm liên quan đến hoạt động chơi của người chơi thuộc Đại Lý.
                        </li>
                        <li>
                            <strong>Phí tiền thưởng</strong> - Tiền thưởng hoặc tiền hoàn trả cho người chơi thuộc Đại Lý.
                        </li>
                    </ul>
                </li>
            </ul>
            <br />
            <p class="text">Ví dụ:</p>
            <p class="text"><i><strong>Doanh thu dương</strong></i></p>
            <div style="padding-left: 25px;">
                <p class="text">Lợi nhuận gộp = USD 18,000</p>
                <p class="text">Khuyến mãi = USD 1,000</p>
                <p class="text">Phí giao dịch = USD 180</p>
                <p class="text">Phí bản quyền = USD 1,100</p>
                <p class="text">Hoa hồng = </p>
                <p class="text">(Lợi nhuận gộp – Khuyến mãi – Phí giao dịch - Phí bản quyền) x Tỷ lệ % hoa hồng</p>
                <p class="text">(18,000 - 1,000 - 180 - 1,100) x 45% = USD 7,074</p>
            </div>

            <p class="text"><i><strong>Doanh thu âm</strong></i></p>
            <div style="padding-left: 25px;">
                <p class="text">Lợi nhuận gộp = - USD 8,000</p>
                <p class="text">Khuyến mãi thành viên = USD 698</p>
                <p class="text">Phí giao dịch = USD 127</p>
                <p class="text">Hoa hồng = </p>
                <p class="text">(Lợi nhuận gộp – Khuyến mãi – Phí giao dịch) x Tỷ lệ % hoa hồng</p>
                <p class="text">(-8,000 - 698 - 127) x 45% = USD -3,971.25 (Chuyển sang tháng sau)</p>
            </div>
        </li>
        <li class="text-block">
            <strong>Cấu trúc tiền hoa hồng từ Đại Lý Cấp Dưới:</strong> bạn sẽ nhận được 10% doanh thu của các Đại Lý Cấp Dưới do bạn giới thiệu,
            và nếu họ lại tiếp tục giới thiệu thành công các Đại Lý khác tham gia vào chương trình, bạn sẽ được nhận thêm một khoản
            doanh thu từ đó!
        </li>
    </ol>
</section>
<section class="info-group" id="RevenueSharePayoutExample">
    <div class="title">
        <span class="text"><i>Ví dụ về cách tính tiền hoa hồng</i></span>
    </div>
    <p class="text">
        <i>Hình 1:</i> ví dụ về cách tính tiền hoa hồng bạn nhận được từ người chơi được bạn giới thiệu
    </p>
    @{ Html.RenderPartial($"~/Views/CommissionStructure/{Model.SiteName}/_ExampleTable.cshtml", Model); }
    <p class="text">
        <i>Hình 2:</i> ví dụ về cách tính tiền hoa hồng bạn nhận được từ Đại Lý được bạn giới thiệu, và từ Đại Lý Cấp Dưới của họ
    </p>
    <div class="img-support" style="max-width: 600px; margin: 15px auto;">
        <img class="img-responsive" src="~/www/build/styles/Images/revenue-share-structure/@(Model.SiteName)/revenue_share_hierarchy.@(Model.CurrentLanguage).png?v=174504" alt="hierarchy banner" />
    </div>
    <p class="text">
        Tiền hoa hồng bạn nhận được:
    </p>
    <div style="padding-left: 30px;">
        <p class="text">
            = [B1+ ((C1 + C2) * 10%)]*10% + [B2 * 10%]
        </p>
        <p class="text">
            = [0 + (50,000 + 30,000) * 10%)]*10% + [70,000 * 10%]
        </p>
        <p class="text">
            = USD 7,800
        </p>
    </div>
    <p class="text">
        <strong>=></strong> Tổng tiền hoa hồng trong tháng bạn nhận được: 58,050 + 7,800 = <strong>USD 65,850</strong>
    </p>
</section>
<section class="info-group" id="HowWePay">
    <div class="title">
        <span class="text">Phương Thức Thanh Toán</span>
    </div>
    <ul>
        <li class="text">
            Chúng tôi sẽ trả tiền hoa hồng cho bạn mỗi tháng một lần, thông qua một tài khoản người chơi do bạn sở hữu tại @Model.SiteFriendlyName (bằng tiền USD, THB, MYR, IDR, INR, CNY, BDT & VND) và số tiền rút tối thiểu phải tương đương USD 100. Các giao dịch ngoại tệ khác cần phải có sự đồng ý từ nhóm Đại Lý @Model.SiteFriendlyName.
        </li>
        <li class="text">
            Bất kỳ yêu cầu rút tiền thứ 2 nào trong tháng đều phải được sự đồng ý của nhóm Đại Lý @Model.SiteFriendlyName.
        </li>
    </ul>
</section>