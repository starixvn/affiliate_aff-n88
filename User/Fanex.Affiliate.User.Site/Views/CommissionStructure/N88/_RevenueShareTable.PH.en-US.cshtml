@model string

<div class="table table-responsive">
    <table>
        <thead>
            <tr>
                <th width="25%">@Lang.RevenueShare</th>
                <th width="5%">@Lang.Tier</th>
                <th width="20%">@Lang.CompanyNetWinN88</th>
                <th width="18%">@Lang.QualifyingMem</th>
                <th width="20%">@Lang.CommissionRate</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td rowspan="6" class="text-center">
                    <p class="all-products">@Lang.AllProducts</p>
                </td>
                <td class="text-center">1</td>
                <td class="text-center">≤PHP165,000</td>
                <td rowspan="5" class="text-center word">>=5</td>
                <td class="text-center">25%</td>
            </tr>
            <tr>
                <td class="text-center">2</td>
                <td class="text-center">PHP165,055 - PHP1,375,000</td>
                <td class="text-center">30%</td>
            </tr>
            <tr>
                <td class="text-center">3</td>
                <td class="text-center">PHP1,375,055 - PHP2,750,000</td>
                <td class="text-center">40%</td>
            </tr>
            <tr>
                <td class="text-center">4</td>
                <td class="text-center">PHP2,750,055 - PHP5,500,000</td>
                <td class="text-center">45%</td>
            </tr>
            <tr>
                <td class="text-center">5</td>
                <td class="text-center">>PHP5,500,055</td>
                <td class="text-center">50%</td>
            </tr>
            <tr>
                <td class="text-center">6</td>
                <td class="text-center" colspan="2">@Lang.ByInvitationOnly</td>
                <td class="text-center">@Lang.Flat</td>
            </tr>
        </tbody>
    </table>
</div>