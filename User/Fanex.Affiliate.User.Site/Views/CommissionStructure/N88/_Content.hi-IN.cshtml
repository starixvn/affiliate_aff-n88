@model Fanex.Affiliate.User.Core.ViewModels.RevenueSharingStructureViewModel
<div class="revenue-share-banner">
    <div class="banner-title">
        <div class="first-title">रेवनू शेरिंग</div>
        <div>स्ट्रक्चर</div>
    </div>
</div>
<div class="content-group">
    <div class="title-container">
        <div class="index-number">01</div>
        <div class="title-block">
            <div class="title"><span>@Lang.WhatWeHave</span></div>
            <div class="button-toggle"></div>
        </div>
    </div>
    <div class="content-block">
        <ul>
            <li><p>खेल, लाइव कैसीनो, आभासी खेल, केनो, स्लॉट गेम जैसे शीर्ष-स्तरीय गेमिंग और ऑनलाइन सट्टेबाजी उत्पाद साथ ही खेलों का एक विस्तृत चयन|</p></li>
            <li><p>5 से अधिक भाषाओं वाला प्रसिद्ध ब्रांड इसलिए आपके लिए सदस्यों को आकर्षित करना आसान है</p></li>
            <li><p>उच्च सदस्य रूपांतरण और प्रतिधारण दर सुनिश्चित करने वाले सामरिक विपणन उपकरण</p></li>
        </ul>
    </div>
</div>
<div class="content-group">
    <div class="title-container">
        <div class="index-number">02</div>
        <div class="title-block">
            <div class="title"><span>@Lang.WhatWeOffer</span></div>
            <div class="button-toggle"></div>
        </div>
    </div>
    <div class="content-block">
        <ul>
            <li><p>@Model.MaxCommission तक रेवनू शेयर दर</p></li>
            <li><p>10% का अतिरिक्त - हमारे संबद्ध कार्यक्रम में अपने उप-संबद्ध के रूप में शामिल होने के लिए दोस्तों को भर्ती करें और अपना इनाम प्राप्त करें!</p></li>
            <li><p>आपके प्रदर्शन पर नज़र रखने वाली प्रभावी और उपयोग में आने वाली आसान प्रबंधन प्रणाली</p></li>
            <li><p>मित्रवत और पेशेवर सहयोगी टीम आपकी सहायता के लिए हमेशा तैयार रहती है</p></li>
        </ul>
    </div>
</div>
<div class="content-group">
    <div class="title-container">
        <div class="index-number">03</div>
        <div class="title-block">
            <div class="title"><span>@Lang.OurPlan</span></div>
            <div class="button-toggle"></div>
        </div>
    </div>
    <div class="content-block">
        <p>आपके रेवनू शेयर में दो भाग होते हैं: (i) आपके निर्दिष्ट खिलाड़ी के सट्टेबाजी के नुकसान से और (ii) आपके संदर्भित सहयोगी के रेवनू शेयर से:</p>
        <p><strong>i. नियमित कमीशन संरचना:</strong></p>
        @{ Html.RenderPartial($"~/Views/CommissionStructure/{Model.SiteName}/_RevenueShareTable.cshtml"); }
        <p><strong>कंपनी का शुद्ध लाभ:</strong> @Model.SiteFriendlyName को आपके द्वारा सुझाए गए सभी खिलाड़ियों के मासिक शुद्ध नुकसान में से सभी संबंधित लागतों को घटाने के बाद जो वास्तविक लाभ बचता है।</p>
        <p><strong>योग्य खिलाड़ी:</strong> ऐसे सदस्य जिनका किसी भी कैलेंडर महीने में सट्टा कारोबार (wagering turnover) कम से कम USD 100.00 होता है।</p>
        <p> किसी भी महीने के लिए नकारात्मक रेवनू शेयर अगले महीने के लिए आगे बढ़ा दी जाएगी।</p>
        <p>सभी सहयोगी सदस्यों के अधिग्रहण के लिए सीधे प्रशासनिक और विपणन लागतों के अधीन हैं।</p>
        <p>
            मासिक आधार पर रेवनू से कटौती की गई लागत। इस लागत में निम्नलिखित शामिल हो सकते हैं:
            <ul class="dash">
                <li>
                    <strong>बैंकिंग शुल्क</strong> - सभी संबद्ध ग्राहकों को शामिल करने वाले प्रत्येक के लिए जमा और निकासी शुल्क।
                </li>
                <li>
                    <strong>रॉयल्टी शुल्क</strong> - उत्पाद रॉयल्टी शुल्क, जो संबद्ध ग्राहकों द्वारा खेले गए उत्पाद से जीजीआर का 10% है।
                </li>
                <li>
                    <strong>प्रमोशन बोनस</strong> - संबद्ध ग्राहकों को दिए जाने वाले मौद्रिक बोनस या छूट।
                </li>
            </ul>
        </p>
        <p class="text">उदाहरण:</p>
        <p class="text"><i><strong>पॉजिटिव रेवेन्यू</strong></i></p>
        <div>
            <p class="text">ग्रॉस रेवेनुए = USD 60,000</p>
            <p class="text">बोनस एक्सपेंसेस = USD 5,000</p>
            <p class="text">ट्रांसक्शन फीस = USD 550</p>
            <p class="text">रॉयल्टी फीस = USD 2,500</p>
            <p class="text">कमीशन = </p>
            <p class="text">(ग्रॉस रेवेनुए - बोनस एक्सपेंसेस - ट्रांसक्शन फीस - रॉयल्टी फीस ) x रेवेनुए शेयर %</p>
            <p class="text">(60,000 − 5,000 − 550 − 2,500) × 45% = USD 23,377.5</p>
        </div>
        <p class="text"><i><strong>नेगेटिव रेवेनुए</strong></i></p>
        <div>
            <p class="text">ग्रॉस रेवेनुए = -USD 5,000</p>
            <p class="text">मेंबर'स बोनस = USD 500</p>
            <p class="text">ट्रांसक्शन फीस = USD 150</p>
            <p class="text">कमीशन = </p>
            <p class="text">(ग्रॉस रेवेनुए - बोनस एक्सपेंसेस - ट्रांसक्शन फीस) x रेवेनुए शेयर %</p>
            <p class="text">(-5,000 - 500 - 150) × 25% = USD -1,412.50 ( कैर्री फॉरवर्ड तो फोल्लोविंग मंथ)</p>
        </div>
        <p>
            <strong>ii. उप संबद्ध संरचना:</strong> आप अपने संदर्भित सहयोगियों के राजस्व हिस्से से अतिरिक्त 10% प्राप्त करने के योग्य होंगे,
            और जब तक वे अन्य सहयोगियों को इसमें लाते हैं, तब तक आप उनके उप-संबद्धों के राजस्व हिस्से से भी हिस्सा प्राप्त कर सकते हैं!
        </p>
    </div>
</div>
<div class="content-group">
    <div class="title-container">
        <div class="index-number">04</div>
        <div class="title-block">
            <div class="title"><span>@Lang.RevenueSharePayoutExample</span></div>
            <div class="button-toggle"></div>
        </div>
    </div>
    <div class="content-block">
        <p><strong>चित्र 1:</strong> आपको यह दिखाने के लिए एक उदाहरण कि आपके रेफ़र किए गए खिलाड़ियों से अर्जित आपके रेवनू शेयर की गणना कैसे की जाती है</p>
        @{ Html.RenderPartial($"~/Views/CommissionStructure/{Model.SiteName}/_ExampleTable.cshtml"); }
    <p><strong>चित्र 2:</strong> आपको यह दिखाने के लिए एक उदाहरण कि आपके संदर्भित सहयोगियों (और उनके उप-संबद्धों) से अर्जित आपकी रेवनू शेयर की गणना कैसे की जाती है</p>
        <div class="img-support" style="max-width: 600px; margin: 15px auto;">
            <img class="img-responsive" src="~/www/build/styles/Images/revenue-share-structure/@(Model.SiteName)/revenue-share.@(Model.CurrentLanguage).png" alt="hierarchy banner" />
        </div>
        <p>  संदर्भित सहयोगियों से अर्जित आपका रेवनू शेयर:</p>
        <div>
            <p class="text">
                = [B1+ ((C1 + C2) * 10%)]*10% + [B2 * 10%]
            </p>
            <p class="text">
                = [0 + (50,000 + 30,000) * 10%)]*10% + [70,000 * 10%]
            </p>
            <p class="text">
                = USD 7,800
            </p>
        </div>
        <p>
            <strong>=></strong> महीने के लिए आपका कुल रेवनू शेयर होगा: 69,500 + 7,800 = <strong>USD 77,300</strong>
        </p>
    </div>
</div>
<div class="content-group">
    <div class="title-container">
        <div class="index-number">05</div>
        <div class="title-block">
            <div class="title"><span>@Lang.HowWePay</span></div>
            <div class="button-toggle"></div>
        </div>
    </div>
    <div class="content-block">
        <ul>
            <li><p>महीने में एक बार, आपके नोव88 प्लेयर खाते (USD, THB, MYR, IDR, INR, CNY, BDT और VND) के माध्यम से और न्यूनतम निकासी राशि USD 100 है। अन्य मुद्राओं के लिए नोव88 एफिलिएट प्रोग्राम टीम से अनुरोध करने की आवश्यकता है।</p></li>
            <li><p>उसी महीने में कोई दूसरा निकासी अनुरोध नोव88 एफिलिएट प्रोग्राम टीम के अनुमोदन के अधीन होगा।</p></li>
        </ul>
    </div>
</div>
