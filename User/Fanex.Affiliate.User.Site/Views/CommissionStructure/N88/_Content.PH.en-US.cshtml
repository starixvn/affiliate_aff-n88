@model Fanex.Affiliate.User.Core.ViewModels.RevenueSharingStructureViewModel

<section class="info-group" id="WhatWeHave">
    <div class="title">
        <span class="text">@Lang.WhatWeHave</span>
    </div>
    <ul>
        <li class="text">
            Top-notch gaming and online betting products such as Sports, Live Casino, Virtual Sports, Keno, Slot games, plus a wide selection of games
        </li>
        <li class="text">
            Renowned brand with over 5 languages so it is easier for you to attract members
        </li>
        <li class="text">
            Strategic Marketing tools ensuring high member conversion and retention rate
        </li>
    </ul>
</section>
<section class="info-group" id="WhatWeOffer">
    <div class="title">
        <span class="text">@Lang.WhatWeOffer</span>
    </div>
    <ul>
        <li class="text">
            Up to @Model.MaxCommission revenue share rate
        </li>
        <li class="text">
            An addition of 10% – recruit friends to join our Affiliate program as your sub-affiliate and get your reward!
        </li>
        <li class="text">
            Effective and easy-to-use management system for your performance tracking
        </li>
        <li class="text">
            Friendly and professional affiliate team always ready to assist you
        </li>
    </ul>
</section>
<section class="info-group" id="OurPlan">
    <div class="title">
        <span class="text">@Lang.OurPlan</span>
    </div>
    <p class="text">
        Your revenue share consists of two parts: (i) from your referred player’s betting losses and (ii) from your referred affiliate’s revenue share:
    </p>
    <ol type="i">
        <li class="text-block">
            <strong>Regular Commission Structure:</strong>
            @{ Html.RenderPartial("~/Views/CommissionStructure/N88/_RevenueShareTable.PH.en-US.cshtml", Model.MaxCommission); }
            <ul>
                <li class="text" style="margin-top: 15px;">
                    <strong>Company’s Net Profit:</strong> The actual profit remaining from the monthly net loss of all players recommended by you to @Model.SiteFriendlyName after deducting all related costs.
                </li>
                <li class="text">
                    <strong>Qualified Player:</strong> Members with at least PHP 5,500 in wagering turnover per calendar month.
                </li>
                <li class="text">
                    Negative revenue share for any given month will be carried forward to the following month.
                </li>
                <li class="text">
                    All affiliates are subject to administrative and marketing costs incurred directly for the acquisition of members.
                </li>
                <li class="text">
                    The cost deducted from the revenue on a monthly basis. This cost may include the following:
                    <ul class="dash">
                        <li>
                            <strong>Banking Fee</strong> - Deposit and Withdrawal charges for each involving all the affiliate's customers.
                        </li>
                        <li>
                            <strong>Royalty Fee</strong> - Product royalty fees incurred involving all affiliate customers.
                        </li>
                        <li>
                            <strong>Promotion bonuses</strong> - Monetary bonuses or rebates given to the affiliate customers.
                        </li>
                    </ul>
                </li>
            </ul>
            <br />
            <p class="text">Example:</p>
            <p class="text"><i><strong>Positive Revenue</strong></i></p>
            <div style="padding-left: 25px;">
                <p class="text">Gross Revenue = PHP 3,300,000</p>
                <p class="text">Bonus Expenses = PHP 275,000</p>
                <p class="text">Transaction Fees = PHP 30,250</p>
                <p class="text">Royalty Fees = PHP 137,500</p>
                <p class="text">Commission = </p>
                <p class="text">(Gross Revenue - Bonus Expenses - Transaction Fees - Royalty Fees) x Revenue Share %</p>
                <p class="text">(3,300,000 − 275,000 − 30,250 − 137,500) × 45% = PHP 1,285,762.50</p>
            </div>

            <p class="text"><i><strong>Negative Revenue</strong></i></p>
            <div style="padding-left: 25px;">
                <p class="text">Gross revenue = -PHP 275,000</p>
                <p class="text">Member’s bonus = PHP 27,500</p>
                <p class="text">Transaction Fees = PHP 8,250</p>
                <p class="text">Commission = </p>
                <p class="text">(Gross Revenue - Bonus Expenses - Transaction Fees) x Revenue Share %</p>
                <p class="text">(-275,000 - 27,500 - 8,250) × 25% = PHP -77,687.50 (Carry forward to following month)</p>
            </div>
        </li>
        <li class="text-block">
            <strong>Sub-Affiliate Structure:</strong> you will be eligible to receive an extra 10% from your referred affiliates’ revenue share,
            and as long as they bring other affiliates in, you can also have a share from their sub-affiliates’ revenue share either!
        </li>
    </ol>
</section>
<section class="info-group" id="RevenueSharePayoutExample">
    <div class="title">
        <span class="text"><i>@Lang.RevenueSharePayoutExample</i></span>
    </div>
    <p class="text">
        <i>Figure 1:</i> An example to show you how your revenue share earned from your referred players is calculated
    </p>
    @{ Html.RenderPartial($"~/Views/CommissionStructure/{Model.SiteName}/_ExampleTable.PH.en-US.cshtml", Model); }
    <p class="text">
        <i>Figure 2:</i> An example to show you how your revenue share earned from your referred affiliates (and their sub-affiliates) is calculated
    </p>
    <div class="img-support" style="max-width: 600px; margin: 15px auto;">
        <img class="img-responsive" src="~/www/build/styles/Images/revenue-share-structure/@(Model.SiteName)/revenue_share_hierarchy.PH.@(Model.CurrentLanguage).png?v=269365" alt="hierarchy banner" />
    </div>
    <p class="text">
        Your revenue share earned from the referred affiliates:
    </p>
    <div style="padding-left: 30px;">
        <p class="text">
            = [B1+ ((C1 + C2) * 10%)]*10% + [B2 * 10%]
        </p>
        <p class="text">
            = [0+(2,750,000+1,650,000)×10%]×10%+[3,850,000×10%]
        </p>
        <p class="text">
            = PHP 429,000
        </p>
    </div>
    <p class="text">
        <strong>=></strong> Your total revenue share for the month would be: 3,822,500 + 429,000 = <strong>PHP 4,251,500</strong>
    </p>
</section>
<section class="info-group" id="HowWePay">
    <div class="title">
        <span class="text">@Lang.HowWePay</span>
    </div>
    <ul>
        <li class="text">
            Once a month, through your @Model.SiteFriendlyName player account in PHP and the minimum withdrawal amount is PHP 5,500.
        </li>
        <li class="text">
            Any 2nd withdrawal request in the same month shall be subject to @Model.SiteFriendlyName Affiliates team’s approval.
        </li>
    </ul>
</section>