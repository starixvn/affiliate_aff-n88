@using Fanex.Affiliate.User.Core.Constants
@model Fanex.Affiliate.User.Core.ViewModels.RevenueSharingStructureViewModel

@{
    ViewBag.Title = Lang.CommissionStructure;
    Layout = "~/Views/Shared/N88/_LayoutBeforeLogin.cshtml";
}
@{
    var mobileBannerPath = Url.Content($"~/www/build/styles/Images/revenue-share-structure/n88/revenue-share-banner-mobile.{Model.CurrentLanguage}");
    var desktopBannerPath = Url.Content($"~/www/build/styles/Images/revenue-share-structure/n88/revenue-share-banner.{Model.CurrentLanguage}");
    var htmlString = Html.RenderPartialByLanguage("~/Views/CommissionStructure/N88/_Content", Model.CurrentLanguage, Model).ToHtmlString();
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/n88/left-menu-panel.js")
    @Html.InlineScripts("~/www/build/js/revenue-share.js")
}

<div class="revenue-share-new-page">
    <div class="revenue-share-banner">
        <picture>
            <source media="(max-width:767px)" srcset="@(mobileBannerPath + ".png?v=0.01")" type="image/png" />
            <source srcset="@(desktopBannerPath + ".png?v=0.01")" type="image/png" />
            <img class="img-item img-responsive" src="@(desktopBannerPath + ".png?v=0.01")" alt="Main Banner" />
        </picture>
    </div>
    <div class="content">
        @Html.Raw(htmlString)

        @RazorHelper.RenderN88MovingTopButton()
    </div>
</div>