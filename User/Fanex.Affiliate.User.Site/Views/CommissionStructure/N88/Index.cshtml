@using Fanex.Affiliate.User.Core.Constants
@model Fanex.Affiliate.User.Core.ViewModels.RevenueSharingStructureViewModel

@{
    ViewBag.Title = Lang.CommissionStructure;
    Layout = "~/Views/Shared/N88/_LayoutBeforeLogin.cshtml";
}
@{
    var viewName = $"~/Views/CommissionStructure/N88/_Content.{Model.CurrentLanguage}.cshtml";

    var htmlString = Html.Partial(viewName, Model).ToHtmlString();
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/n88/left-menu-panel.js")
}

<div class="main-content main-content-left-panel">
    @RazorHelper.RenderLeftPanel(Menu.RevenueSharingMenuList)
    <div class="content">
        <div class="page-title">
            <span class="text">@Lang.CommissionStructure</span>
        </div>

        @Html.Raw(htmlString)

        @RazorHelper.RenderN88MovingTopButton()
    </div>
</div>