@model Fanex.Affiliate.User.Core.ViewModels.RevenueSharingStructureViewModel

<div class="content-group">
    <div class="title-container">
        <div class="index-number">01</div>
        <div class="title-block">
            <div class="title"><span>@Lang.WhatWeHave</span></div>
            <div class="button-toggle"></div>
        </div>
    </div>
    <div class="content-block">
        <p>ผลิตภัณฑ์ ที่เกี่ยวกับเกมมิ่งและการเดิมพันออนไลน์ เช่น กีฬา, คาสิโนสด, กีฬาเสมือนจริง, คีโน, เกมสล็อต รวมถึงเกมอื่นๆให้เลือกมากมาย</p>
        <p>แบรนด์ที่มีชื่อเสียงมีมากกว่า 5 ภาษาเพื่อให้คุณดึงดูดสมาชิกได้ง่ายขึ้น</p>
        <p> การตลาดเชิงกลยุทธ์เพื่อสร้างความมั่นใจในการแลกเปลี่ยนสมาชิกและการเก็บรักษาสมาชิก</p>
    </div>
</div>
<div class="content-group">
    <div class="title-container">
        <div class="index-number">02</div>
        <div class="title-block">
            <div class="title"><span>@Lang.WhatWeOffer</span></div>
            <div class="button-toggle"></div>
        </div>
    </div>
    <div class="content-block">
        <p>ัตราส่วนแบ่งรายได้สูงถึง @Model.MaxCommission</p>
        <p>รับเพิ่มอีก 10% เมื่อรับสมัครเพื่อนเพื่อเข้าร่วมโปรแกรมพันธมิตร(Affiliates)ของเราในฐานะพันธมิตรย่อยของคุณ</p>
        <p>ระบบการจัดการที่มีประสิทธิภาพและใช้งานง่ายสำหรับการติดตามประสิทธิภาพของคุณ</p>
        <p>ทีมพันธมิตรที่เป็นมิตรและเป็นมืออาชีพที่พร้อมที่จะให้ความช่วยเหลือคุณเสมอ</p>
    </div>
</div>
<div class="content-group">
    <div class="title-container">
        <div class="index-number">03</div>
        <div class="title-block">
            <div class="title"><span>@Lang.OurPlan</span></div>
            <div class="button-toggle"></div>
        </div>
    </div>
    <div class="content-block">
        <p>ส่วนแบ่งรายได้ของคุณประกอบด้วยสองส่วน: (i) ส่วนแรกคือจากการเสียเดิมพันของผู้เล่นที่อ้างอิง และ (ii) ส่วนที่สองจากส่วนแบ่งรายได้ของพันธมิตร(Affiliates) ของคุณ:</p>
        <p><<strong>โครงสร้างค่าคอมมิชชันปกติ:</strong></p>
        @{ Html.RenderPartial($"~/Views/CommissionStructure/{Model.SiteName}/_RevenueShareTable.cshtml"); }
        <p>
            <strong>กำไรสุทธิของบริษัท: </strong> คือกำไรที่เหลือหลังจากหักยอดเสีย
            รายเดือนของผู้เล่นที่คุณแนะนำ
            รวมทั้งค่าใช้จ่ายที่เกี่ยวข้องทั้งหมดแล้ว
        </p>
        <p><strong>ผู้เล่นที่ผ่านคุณสมบัติ:</strong> สมาชิกที่มียอดเดิมพันเทิร์นโอเวอร์อย่างน้อย 100.00 USD ต่อเดือน</p>
        <p>ยอดบัญชีที่ติดลบของเดือนที่ทำการจ่ายค่าคอมมิชชั่นนั้นจะถูกยกไปรวมในเดือนถัดไป</p>
        <p> โบนัสต่างๆ หรือ เงินคืนจากโปรโมชั่นจะถือเป็นค่าใช้จ่ายที่พันธมิตรจะต้องทำการแบกรับ โดยค่าใช้จ่ายนี้จะนำมาหักลบกับรายได้รวม ก่อนที่จะคำนวณเป็นรายได้สุทธิของพันธมิตร</p>
        <p>
            สำหรับในส่วนของค่าใช้จ่ายที่จะนำมาหักลบในส่วนของรายได้สุทธินั้น มีรายละเอียดดังต่อไปนี้:
            <ul class="dash">
                <li>
                    <strong>ค่าธรรมเนียมการโอนเงิน</strong> - ค่าธรรมเนียมในการฝากเงิน และ ถอนเงินของสมาชิกภายใต้พันธมิตรของคุณ
                </li>
                <li>
                    <strong>ค่าลิขสิทธิ์</strong> - ค่าธรรมเนียมลิขสิทธิ์โปรดักส์ ซึ่งคิดเป็น 10% ของการเล่น GGR จากผู้เล่นที่ทำการสมัครภายใต้ตัวแทนพันธมิตรของคุณ
                </li>
                <li>
                    <strong>ค่าโบนัสต่างๆ</strong> - ค่าโบนัสจากโปรโมชั่นต่างๆ เครดิตฟรี หรือ โบนัสคืนเงินให้กับสมาชิกภายใต้พันธมิตรของคุณ
                </li>
            </ul>
        </p>
        <p class="text">ตัวอย่าง:</p>
        <p class="text"><i><strong>รายได้บวก</strong></i></p>
        <div>
            <p class="text">กำไร/ขาดทุนของสมาชิก = USD 60,000</p>
            <p class="text">โบนัสของสมาชิก = USD 5,000</p>
            <p class="text">ค่าธรรมเนียมทางการเงิน = USD 550</p>
            <p class="text">ค่าภาคหลวงค่าธรรมเนียม = USD 2,500</p>
            <p class="text">คอมมิชชั่น = </p>
            <p class="text">(กำไร/ขาดทุนของสมาชิก - โบนัสของสมาชิก - ค่าธรรมเนียมทางการเงิน - ค่าภาคหลวงค่าธรรมเนียม) x อัตราเปอร์เซ็น คอมมิชชั่น %</p>
        </div>
        <p class="text"><i><strong>รายได้ติดลบ</strong></i></p>
        <div>
            <p class="text">กำไร/ขาดทุนของสมาชิก = -USD 5,000</p>
            <p class="text">โบนัสของสมาชิก = USD 500</p>
            <p class="text">ค่าภาคหลวงค่าธรรมเนียม = USD 150</p>
            <p class="text">คอมมิชชั่น = </p>
            <p class="text">(กำไร/ขาดทุนของสมาชิก - โบนัสของสมาชิก - ค่าธรรมเนียมทางการเงิน) x อัตราเปอร์เซ็น คอมมิชชั่น %</p>
            <p class="text">(-5,000 - 500 - 150) × 25% = USD -1,412.50 (ยกยอดไปเดือนหน้า)</p>
        </div>
        <p>
            <strong>โครงสร้างพันธมิตรย่อย:</strong> คุณจะมีสิทธิ์ได้รับส่วนแบ่งรายได้พิเศษ 10% จากพันธมิตร (Affiliates)ในเครือของคุณและตราบใดที่พวกเขาสามารถนำพันธมิตร
            Affiliates อื่นเข้ามา คุณก็สามารถมีส่วนแบ่งรายได้จากพันธมิตร Affiliates ย่อยของพวกเขาด้วยเช่นกัน!
        </p>
    </div>
</div>
<div class="content-group">
    <div class="title-container">
        <div class="index-number">04</div>
        <div class="title-block">
            <div class="title"><span>@Lang.RevenueSharePayoutExample</span></div>
            <div class="button-toggle"></div>
        </div>
    </div>
    <div class="content-block">
        <p><strong>รูปที่ 1 :</strong> ตัวอย่างเพื่อแสดงให้คุณเห็นว่าการคำนวณส่วนแบ่งรายได้ของคุณจากผู้เล่นที่แนะนำของคุณ</p>
        @{ Html.RenderPartial($"~/Views/CommissionStructure/{Model.SiteName}/_ExampleTable.cshtml"); }
    <p><strong>รูปที่ 2:</strong> ตัวอย่างเพื่อแสดงให้เห็นว่าการคำนวณส่วนแบ่งรายได้ของคุณจากพันธมิตร Affiliates ของคุณ (และ บริษัท ในเครือย่อย sub-affiliates) คำนวณอย่างไร</p>
        <div class="img-support" style="max-width: 600px; margin: 15px auto;">
            <img class="img-responsive" src="~/www/build/styles/Images/revenue-share-structure/@(Model.SiteName)/revenue-share-desktop.@(Model.CurrentLanguage).png" alt="hierarchy banner" />
        </div>
        <p>่วนแบ่งรายได้ของคุณได้รับจากพันธมิตรที่ได้รับการแนะนำ:</p>
        <div>
            <p class="text">
                = [B1+ ((C1 + C2) * 10%)]*10% + [B2 * 10%]
            </p>
            <p class="text">
                = [0 + (50,000 + 30,000) * 10%)]*10% + [70,000 * 10%]
            </p>
            <p class="text">
                = USD 7,800
            </p>
        </div>
        <p>
            <strong>=></strong> ส่วนแบ่งรายได้รวมของคุณสำหรับเดือนนั้นคือ: 69,500 + 7,800 = <strong>USD 77,300</strong>
        </p>
    </div>
</div>
<div class="content-group">
    <div class="title-container">
        <div class="index-number">05</div>
        <div class="title-block">
            <div class="title"><span>@Lang.HowWePay</span></div>
            <div class="button-toggle"></div>
        </div>
    </div>
    <div class="content-block">
        <p>@Model.SiteFriendlyName จะทำการจ่ายเงินเดือนละครั้งผ่านบัญชีผู้เล่น @Model.SiteFriendlyName ของคุณ (USD, THB, MYR, IDR, INR, CNY, BDT &amp; VND) และจำนวนการถอนขั้นต่ำคือ USD 100 (หรือในสกุลเงินเทียบเท่า) สำหรับสกุลเงินอื่นต้องทำการติดต่อจากทีมในเครือ @Model.SiteFriendlyName</p>
        <p>คำขอถอนเงินครั้งที่ 2 ในเดือนเดียวกันจะต้องได้รับการอนุมัติจากทีมในเครือ @Model.SiteFriendlyName</p>
    </div>
</div>