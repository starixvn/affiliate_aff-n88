@{
    var appSetting = AppSetting.Instance;
    var maxCommisison = appSetting.MaxCommission;
    var bannerSrc = Url.Content($"~/www/build/styles/images/revenue-share-structure/N88/revenue.th-TH.jpg?v={appSetting.JsVersion}");
}
<div class="banner">
    <img src="@bannerSrc" alt="commission banner" />
</div>

<div class="info-group">
    <div class="title">
        <span class="text">สิ่งที่เรามี</span>
    </div>
    <ul>
        <li class="text">
            ผลิตภัณฑ์ ที่เกี่ยวกับเกมมิ่งและการเดิมพันออนไลน์ เช่น กีฬา, คาสิโนสด, กีฬาเสมือนจริง, คีโน, เกมสล็อต รวมถึงเกมอื่นๆให้เลือกมากมาย
        </li>
        <li class="text">
            แบรนด์ที่มีชื่อเสียงมีมากกว่า 5 ภาษาเพื่อให้คุณดึงดูดสมาชิกได้ง่ายขึ้น
        </li>
        <li class="text">
            การตลาดเชิงกลยุทธ์เพื่อสร้างความมั่นใจในการแลกเปลี่ยนสมาชิกและการเก็บรักษาสมาชิก
        </li>
    </ul>
</div>
<div class="info-group">
    <div class="title">
        <span class="text">สิ่งที่เราเสนอให้คือ</span>
    </div>
    <ul>
        <li class="text">
            อัตราส่วนแบ่งรายได้สูงถึง @maxCommisison
        </li>
        <li class="text">
            รับเพิ่มอีก 10% เมื่อรับสมัครเพื่อนเพื่อเข้าร่วมโปรแกรมพันธมิตร(Affiliates)ของเราในฐานะพันธมิตรย่อยของคุณ
        </li>
        <li class="text">
            ระบบการจัดการที่มีประสิทธิภาพและใช้งานง่ายสำหรับการติดตามประสิทธิภาพของคุณ
        </li>
        <li class="text">
            ทีมพันธมิตรที่เป็นมิตรและเป็นมืออาชีพที่พร้อมที่จะให้ความช่วยเหลือคุณเสมอ
        </li>
    </ul>
</div>
<div class="info-group">
    <div class="title">
        <span class="text">แผนของเราคือ</span>
    </div>
    <p class="text">
        ส่วนแบ่งรายได้ของคุณประกอบด้วยสองส่วน: (i) ส่วนแรกคือจากการเสียเดิมพันของผู้เล่นที่อ้างอิง และ (ii) ส่วนที่สองจากส่วนแบ่งรายได้ของพันธมิตร(Affiliates) ของคุณ:
    </p>
    <ol type="i">
        <li class="text-block">
            <strong>Multi-tier Revenue Share Structure:</strong>
            @{ Html.RenderPartial("~/Views/CommissionStructure/_RevenueShareTable.cshtml"); }
            <ul>
                <li class="text" style="margin-top: 15px;">
                    <strong>รายได้สุทธิ:</strong> คำนวณจากยอดเสียสุทธิของสมาชิกที่อยู่ภายใต้พันธมิตรของคุณที่ทำการแนะนำให้ Nova88 ในแต่ละเดีอน
                </li>
                <li class="text">
                    <strong>จำนวนผู้เล่นที่ผ่านเกณฑ์:</strong> สมาชิกที่อยู่ภายใต้พันธมิตรนั้นจะต้องมีประวัติการเดิมพันอย่างน้อย 1 ครั้ง ในเดือนนั้นๆ
                </li>
                <li class="text">
                    ยอดบัญชีที่ติดลบของเดือนที่ทำการจ่ายค่าคอมมิชชั่นนั้นจะถูกยกไปรวมในเดือนถัดไป
                </li>
                <li class="text">
                    โบนัสต่างๆ หรือ เงินคืนจากโปรโมชั่นจะถือเป็นค่าใช้จ่ายที่พันธมิตรจะต้องทำการแบกรับ โดยค่าใช้จ่ายนี้จะนำมาหักลบกับรายได้รวม ก่อนที่จะคำนวณเป็นรายได้สุทธิของพันธมิตร
                </li>
                <li class="text">
                    สำหรับในส่วนของค่าใช้จ่ายที่จะนำมาหักลบในส่วนของรายได้สุทธินั้น มีรายละเอียดดังต่อไปนี้:
                    <ul class="dash">
                        <li>
                            ค่าธรรมเนียมการโอนเงิน - ค่าธรรมเนียมในการฝากเงิน และ ถอนเงินของสมาชิกภายใต้พันธมิตรของคุณ
                        </li>
                        <li>
                            ค่าลิขสิทธิ์ - ค่าธรรมเนียมลิขสิทธิ์โปรดักส์ ซึ่งคิดเป็น 10% ของการเล่น GGR จากผู้เล่นที่ทำการสมัครภายใต้ตัวแทนพันธมิตรของคุณ
                        </li>
                        <li>
                            ค่าโบนัสต่างๆ - ค่าโบนัสจากโปรโมชั่นต่างๆ เครดิตฟรี หรือ โบนัสคืนเงินให้กับสมาชิกภายใต้พันธมิตรของคุณ
                        </li>
                    </ul>
                </li>
            </ul>
        </li>
        <li class="text-block"><strong>โครงสร้างพันธมิตร:</strong> คุณจะมีสิทธิ์ได้รับส่วนแบ่งรายได้พิเศษ 10% จากพันธมิตร (Affiliates)ในเครือของคุณและตราบใดที่พวกเขาสามารถนำพันธมิตร Affiliates อื่นเข้ามา คุณก็สามารถมีส่วนแบ่งรายได้จากพันธมิตร Affiliates ย่อยของพวกเขาด้วยเช่นกัน!</li>
    </ol>
</div>
<div class="info-group">
    <div class="title">
        <span class="text"><i>ตัวอย่างการจ่ายส่วนแบ่งรายได้</i></span>
    </div>
    <p class="text">
        <i>รูปที่ 1 :</i> ตัวอย่างเพื่อแสดงให้คุณเห็นว่าการคำนวณส่วนแบ่งรายได้ของคุณจากผู้เล่นที่แนะนำของคุณ
    </p>
    @{ Html.RenderPartial("~/Views/CommissionStructure/_ExampleTable.cshtml"); }
    <p class="text">
        <i>รูปที่ 2:</i> ตัวอย่างเพื่อแสดงให้เห็นว่าการคำนวณส่วนแบ่งรายได้ของคุณจากพันธมิตร Affiliates ของคุณ (และ บริษัท ในเครือย่อย sub-affiliates) คำนวณอย่างไร
    </p>
    <div class="img-support" style="max-width: 600px; margin: 15px auto;">
        <img class="img-responsive" id="revenue_share_hierarchy" alt="hierarchy banner" />
    </div>
    <p class="text">
        ส่วนแบ่งรายได้ของคุณได้รับจากพันธมิตรที่ได้รับการแนะนำ:
    </p>
    <div style="padding-left: 30px;">
        <p class="text">
            = [B1+ ((C1 + C2) * 10%)]*10% + [B2 * 10%]
        </p>
        <p class="text">
            = [0 + (50,000 + 30,000) * 10%)]*10% + [70,000 * 10%]
        </p>
        <p class="text">
            = 7,800 USD
        </p>
    </div>
    <p class="text">
        <strong>=></strong> ส่วนแบ่งรายได้รวมของคุณสำหรับเดือนนั้นคือ: 58,050 + 7,800 = <strong>65,850 USD</strong>
    </p>
</div>
<div class="info-group">
    <div class="title">
        <span class="text">การจ่ายเงิน</span>
    </div>
    <ul>
        <li class="text">
            Nova88 จะทำการจ่ายเงินเดือนละครั้งผ่านบัญชีผู้เล่น Nova88 ของคุณ (MYR, IDR, THB & CNY) และจำนวนการถอนขั้นต่ำคือ USD 100 (หรือในสกุลเงินเทียบเท่า) สำหรับสกุลเงินอื่นต้องทำการติดต่อจากทีมในเครือ Nova88
        </li>
        <li class="text">
            คำขอถอนเงินครั้งที่ 2 ในเดือนเดียวกันจะต้องได้รับการอนุมัติจากทีมในเครือ Nova88
        </li>
    </ul>
</div>