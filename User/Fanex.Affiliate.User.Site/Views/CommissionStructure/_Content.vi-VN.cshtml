@using Fanex.Affiliate.User.Core.Constants
@{
    var appSetting = AppSetting.Instance;
    var siteName = appSetting.SiteFriendlyName;
    var defaultCurrency = appSetting.DefaultCurrency;
    var isN88 = string.Equals(appSetting.SiteName, SiteName.N88, StringComparison.CurrentCultureIgnoreCase);
}
<div class="banner-commission-structure">
    <div class="text-content english">
        <p class="text-big-yellow">45%</p>
        <p class="text-big-white">Thưởng Hoa Hồng</p>
        <p class="text-small-white text-small">Cho</p>
        <p class="text-small-white"><span class="text-yellow">Thể Thao</span> và <span class="text-yellow">Casino</span></p>
    </div>
</div>

<div class="info-group">
    <div class="title">
        <span class="text">Chúng Tôi Sở Hữu</span>
    </div>
    <ul>
        <li class="text">
            Những sản phẩm cá cược hàng đầu như Thể Thao, Casino Trực Tiếp, Thể Thao Ảo, Keno, Trò chơi Xèng, và vô số các trò chơi trực tuyến khác
        </li>
        <li class="text">
            Thương hiệu danh tiếng, hỗ trợ hơn 5 ngôn ngữ khác nhau, dễ dàng thu hút khách hàng tham gia
        </li>
        <li class="text">
            Chiến lược tiếp thị uy tín, đảm bảo tỷ lệ chuyển đổi và duy trì thành viên luôn ở mức cao nhất
        </li>
    </ul>
</div>
<div class="info-group">
    <div class="title">
        <span class="text">Quyền Lợi Khi Tham Gia</span>
    </div>
    <ul>
        <li class="text">
            Chiết khấu hoa hồng lên đến 45%
        </li>
        <li class="text">
            Thưởng thêm 10% - khi giới thiệu thành công bạn bè tham gia chương trình cộng tác của chúng tôi với tư cách là Affiliate tuyến dưới
        </li>
        <li class="text">
            Hệ thống quản lý hiệu quả và dễ sử dụng để theo dõi hiệu suất kinh doanh của bạn
        </li>
        <li class="text">
            Đội ngũ tư vấn thân thiện và chuyên nghiệp luôn sẵn sàng hỗ trợ bạn
        </li>
    </ul>
</div>
<div class="info-group">
    <div class="title">
        <span class="text">Chương Trình Affiliate</span>
    </div>
    <p class="text">
        Bạn có thể nhận tiền hoa hồng từ cả hai (2) cách: (i) tiền thua cược của người chơi mà bạn giới thiệu và (ii) hoa hồng của các Affiliate tuyến dưới do bạn giới thiệu:
    </p>
    <ol type="i">
        <li class="text-block">
            <strong>Cấu trúc tiền hoa hồng từ người chơi:</strong>
            @{ Html.RenderPartial("~/Views/CommissionStructure/_RevenueShareTable.cshtml"); }
            <ul>
                <li class="text" style="margin-top: 15px;">
                    <strong>Lãi Thực Công Ty:</strong> tiền lời từ những người chơi được bạn giới thiệu cho @siteName.
                </li>
                <li class="text">
                    <strong>Người Chơi Đủ Điều Kiện:</strong> người chơi có ít nhất một (1) cược trong tháng đó.
                </li>
                <li class="text">
                    Khoản tiền hoa hồng bị âm trong tháng sẽ được cộng dồn cho tháng tiếp theo.
                </li>
            </ul>
        </li>
        <li class="text-block"><strong>Cấu trúc tiền hoa hồng từ Affiliate tuyến dưới:</strong> bạn sẽ nhận được 10% doanh thu của các Affiliate tuyến dưới do bạn giới thiệu, và nếu họ lại tiếp tục giới thiệu thành công các Affiliate khác tham gia vào chương trình, bạn sẽ được nhận thêm một khoản doanh thu từ đó!</li>
    </ol>
</div>
<div class="info-group">
    <div class="title">
        <span class="text"><i>Ví dụ về cách tính tiền hoa hồng</i></span>
    </div>
    <p class="text">
        <i>Hình 1:</i> ví dụ về cách tính tiền hoa hồng bạn nhận được từ người chơi được bạn giới thiệu
    </p>
    @{ Html.RenderPartial("~/Views/CommissionStructure/_ExampleTable.cshtml"); }
    <p class="text">
        <i>Hình 2:</i> ví dụ về cách tính tiền hoa hồng bạn nhận được từ Affiliate được bạn giới thiệu, và từ Affiliate tuyến dưới của họ
    </p>
    <div class="img-support" style="max-width: 600px; margin: 15px auto;">
        <img class="img-responsive" src="~/www/build/styles/Images/revenue-share-structure/revenue_share_hierarchy-vn.png" />
    </div>
    <p class="text">
        Tiền hoa hồng bạn nhận được:
    </p>
    <div style="padding-left: 30px;">
        <p class="text">
            = [B1+ ((C1 + C2) * 10%)] + [B2 * 10%]
        </p>
        <p class="text">
            = [0 + (50,000 + 30,000) * 10%)] + [70,000 * 10%]
        </p>
        <p class="text">
            = 15,000 @defaultCurrency
        </p>
    </div>
    <p class="text">
        <strong>=></strong> Tổng tiền hoa hồng trong tháng bạn nhận được: 58,050 + 15,000 = <strong>73,050 @defaultCurrency</strong>
    </p>
</div>
<div class="info-group">
    <div class="title">
        <span class="text">Phương Thức Thanh Toán</span>
    </div>
    <ul>
        <li class="text">
            Chúng tôi sẽ trả tiền hoa hồng cho bạn mỗi tháng một lần, thông qua một tài khoản người chơi do bạn sở hữu tại @siteName (bằng tiền MYR, IDR, THB hoặc CBY) và số tiền rút tối thiểu phải tương đương @appSetting.MinWithdrawal @defaultCurrency. Đối với những loại tiền tệ khác, cần phải gửi yêu cầu cho nhóm Affiliate @siteName.
        </li>
        <li class="text">
            Bất kỳ yêu cầu rút tiền thứ 2 nào trong tháng đều phải được sự đồng ý của nhóm Affiliate @siteName.
        </li>
    </ul>
</div>