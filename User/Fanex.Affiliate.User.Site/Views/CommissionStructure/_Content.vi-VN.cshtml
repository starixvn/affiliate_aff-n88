@using Fanex.Affiliate.User.Core.Constants
@{
    var appSetting = AppSetting.Instance;
    var siteName = appSetting.SiteFriendlyName;
    var defaultCurrency = appSetting.DefaultCurrency;
    var isN88 = string.Equals(appSetting.SiteName, SiteName.N88, StringComparison.CurrentCultureIgnoreCase);
}
<div class="banner-commission-structure">
    <div class="text-content">
        <p class="text-big-yellow">@(isN88 ? "45%" : "50%")</p>
        <p class="text-big-white">Thưởng Hoa Hồng</p>
        <p class="text-small-white text-small">Cho</p>
        <p class="text-small-white"><span class="text-yellow">Thể Thao </span> và <span class="text-yellow">Casino</span></p>
    </div>
</div>
<div class="info-group">
    <p class="text">
        Là hội viên của @siteName, mỗi tháng, bạn sẽ nhận hoa hồng dựa trên số lượng Thành viên bạn giới thiệu chơi @siteName trong tháng. Hệ thống báo cáo trực tuyến của @siteName hoạt động 24 giờ/ngày, 7 ngày/tuần giúp bạn cập nhật tình hình hoạt động đại lý của mình.<br>Số tiền bạn kiếm được tùy thuộc vào lượng lưu lượng bạn có thể gửi tới từ trang web của mình. @siteName sẽ hỗ trợ Thành viên thực hiện gửi tiền, đăng ký khuyến mãi; bên cạnh đó, những ưu đãi đặc biệt dành riêng cho từng tài khoản sẽ thu hút Thành viên tham gia lâu dài tại @siteName.
    </p>
</div>
<div class="info-group">
    <div class="title">
        <span class="text">Mô Hình Chia Sẻ Doanh Thu</span>
    </div>
    <p class="text">
        Mô hình này dựa trên việc tính toán tổng Doanh thu cược tại tất cả các sản phẩm @siteName.
    </p>
    <p class="text">
        @siteName cung cấp một mô hình chia sẻ doanh thu của tất cả sản phẩm. Đây là một mô hình tích lũy dựa trên số lượng các thành viên hoạt động mỗi tháng, mang đến doanh thu cược của từng loại sản phẩm.
    </p>
    @{ Html.RenderPartial("~/Views/CommissionStructure/_RevenueShareTable.cshtml"); }
    <p class="text" style="margin-top: 15px;">
        Theo mục đích của bảng trên, “Doanh Thu Thuần" có nghĩa là tổng tiền cược của các thành viên trong tháng trừ : (i) phần tiền thanh toán các cược thắng, (ii) bất kỳ tiền thưởng khuyến mãi; (iii) Khoản bồi hoàn; và (iv) bất kỳ lợi nhuận  khác, các khoản tín dụng, tiền bồi thường hoặc tiền hoàn lại cho thành viên.
    </p>
</div>
<div class="info-group">
    <div class="title">
        <span class="text">Số dư âm</span>
    </div>
    <p class="text">
        Nếu Số dư của tháng là số âm, thì toàn bộ số dư đó sẽ được chuyển tiếp vào tháng sau. Ví dụ: nếu cuối tháng 1 sau khi tổng kết, số tiền trong tài khoản của hội viên là -@(defaultCurrency)58,000,000, số tiền này sẽ chuyển tiếp vào tháng 2. Nếu tháng 2 số dư trong tài khoản là @(defaultCurrency)78,000,000, thì số dư tài khoản sẽ là @(defaultCurrency)20,000,000. Nhưng nếu tháng 2 số dư vẫn là số âm, ví dụ là -@(defaultCurrency)36,000,000, thì sẽ tiếp tục tích lũy số âm của tháng trước đến tháng sau, vậy số tiền chuyển đến tháng 3 sẽ là -@(defaultCurrency)94,000,000. Mỗi Đại Lý @siteName sẽ hưởng tỷ lệ hoa hồng thu nhập tương ứng với cấp bậc .
    </p>
</div>
<div class="info-group">
    <div class="title">
        <span class="text">Thanh Toán Hoa Hồng</span>
    </div>
    <p class="text">
        Ngoài @(isN88 ? "USD ra bạn có thể yêu cầu rút tiền bằng đơn vị tiền khác như" : "VND ra bạn có thể yêu cầu rút tiền bằng đơn vị tiền khác như USD,") MYR, EUR, CNY. Tỷ lệ ngoại tệ sẽ được quy đổi dựa vào tỷ lệ ngày thanh toán hoa hồng.
    </p>
    <p class="text">Chúng tôi cung cấp những phương thức rút tiền hoa hồng đại lý sau: </p>
    <p>1. Thông qua tài khoản cá cược @siteName</p>
    <p class="text">
        * Mỗi tháng Đại lý @siteName chỉ có thể rút tiền 1 lần duy nhất. Nếu yêu cầu rút tiền nhiều hơn 1 lần trong tháng của bạn được @siteName chấp thuận, bạn cũng có thể yêu cầu rút 2 lần/ tháng. Hiện tại @siteName không tính phí giao dịch rút tiền hoa hồng mỗi tháng của Đại lý, nhưng chúng tôi sẽ không chi trả bất kỳ phí thủ tục hoặc phí phát sinh nào khác.<br>Số tiền yêu cầu rút tối thiểu là @(defaultCurrency)@(AppSetting.Instance.MinWithdrawal)
    </p>
</div>