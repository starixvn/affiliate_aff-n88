@using Fanex.Affiliate.User.Core.Constants
@{
    var appSetting = AppSetting.Instance;
    var siteName = appSetting.SiteFriendlyName;
    var defaultCurrency = appSetting.DefaultCurrency;
    var isN88 = string.Equals(appSetting.SiteName, SiteName.N88, StringComparison.CurrentCultureIgnoreCase);
}
<div class="banner-commission-structure">
    <div class="text-content english">
        <p class="text-big-yellow">@(isN88 ? "45%" : "50%")</p>
        <p class="text-big-white">revenue share for life</p>
        <p class="text-small-white text-small">on</p>
        <p class="text-small-white"><span class="text-yellow">Sports</span> and <span class="text-yellow">Casino</span></p>
    </div>
</div>

<div class="info-group">
    <div class="title">
        <span class="text">What we have</span>
    </div>
    <ul>
        <li class="text">
            Top-notch gaming and online betting products such as Sports, Live Casino, Virtual Sports, Keno, Slot games, plus a wide selection of games.
        </li>
        <li class="text">
            Renowned brand with over 5 languages so it is easier for you to attract members.
        </li>
        <li class="text">
            Strategic Marketing tools ensuring high member conversion and retention rate.
        </li>
    </ul>
</div>
<div class="info-group">
    <div class="title">
        <span class="text">What we offer</span>
    </div>
    <ul>
        <li class="text">
            Up to 45% revenue share rate .
        </li>
        <li class="text">
            An additional of 10% – recruit friends to join our Affiliate program as your sub-affiliate and get your reward!
        </li>
        <li class="text">
            Effective and easy-to-use management system for your performance tracking.
        </li>
        <li class="text">
            Friendly and professional affiliate team always ready to assist you.
        </li>
    </ul>
</div>
<div class="info-group">
    <div class="title">
        <span class="text">Our Plan</span>
    </div>
    <p class="text">
        Your revenue share consists of two parts: (i) from your referred player’s betting losses and (ii) from your referred affiliate’s revenue share:
    </p>
    <ol type="i">
        <li class="text-block">
            <strong>Multi-tier Revenue Share Structure:</strong>
            @{ Html.RenderPartial("~/Views/CommissionStructure/_RevenueShareTable.cshtml"); }
            <ul>
                <li class="text" style="margin-top: 15px;">
                    Company Net Win: the monthly net loss of all players recommended by you to @siteName.
                </li>
                <li class="text">
                    Active Players: members that have placed at least one (1) bet in the month.
                </li>
                <li class="text">
                    Negative revenue share for any given month will be carried forward to the following month.
                </li>
            </ul>
        </li>
        <li class="text-block"><strong>Affiliate Structure:</strong> you will be eligible to receive an extra 10% from your referred affiliates’ revenue share, and as long as they bring other affiliates in, you can also have a share from their sub-affiliates’ revenue share either!</li>
    </ol>
</div>
<div class="info-group">
    <div class="title">
        <span class="text"><i>Revenue Share Payout Example</i></span>
    </div>
    <p class="text">
        <i>Figure 1:</i> An example to show you how your revenue share earned from your referred players is calculated
    </p>
    @{ Html.RenderPartial("~/Views/CommissionStructure/_ExampleTable.cshtml"); }
    <p class="text">
        <i>Figure 2:</i> An example to show you how your revenue share earned from your referred affiliates (and their sub-affiliates) is calculated
    </p>
    <div class="img-support" style="max-width: 600px; margin: 15px auto;">
        <img class="img-responsive" src="~/www/build/styles/Images/revenue-share-structure/revenue_share_hierarchy.png" />
    </div>
    <p class="text">
        Your revenue share earned from the referred affiliates:
    </p>
    <div style="padding-left: 30px;">
        <p class="text">
            = [B1+ ((C1 + C2) * 10%)] + [B2 * 10%]
        </p>
        <p class="text">
            = [0 + (50,000 + 30,000) * 10%)] + [70,000 * 10%]
        </p>
        <p class="text">
            = 15,000 @defaultCurrency
        </p>
    </div>
    <p class="text">
        <strong>=></strong> Your total revenue share for the month would be: 58,050 + 15,000 = <strong>73,050 @defaultCurrency</strong>
    </p>
</div>
<div class="info-group">
    <div class="title">
        <span class="text">How we pay</span>
    </div>
    <ul>
        <li class="text">
            Once a month, through your Nova88 player account (in MYR, IDR, THB & CNY) and the minimum withdrawal amount is @defaultCurrency 100 (or in equivalent currencies). For others currency need to request from @siteName.ToUpperInvariant() Affiliates teams.
        </li>
        <li class="text">
            Any 2nd withdrawal request in the same month shall be subject to Nova88 Affiliates team’s approval.
        </li>
    </ul>
</div>