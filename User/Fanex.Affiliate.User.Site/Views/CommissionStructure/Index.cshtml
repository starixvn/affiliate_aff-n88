@using Fanex.Affiliate.User.Core.Constants
@model Fanex.Affiliate.User.Core.ViewModels.RevenueSharingStructureViewModel

@{
    ViewBag.Title = Lang.CommissionStructure;
    Layout = PathHelper.GetLayoutPath("_LayoutBeforeLogin", Model.SiteName);
}
@{
    var isN88 = string.Equals(Model.SiteName, SiteName.N88, StringComparison.CurrentCultureIgnoreCase);
    var viewName = $"~/Views/CommissionStructure/{Model.SiteName}/_Content.{Model.CurrentLanguage}.cshtml";

    var htmlString = Html.Partial(viewName, Model).ToHtmlString();
}

@section styles{
    <link rel="stylesheet" href="@Url.RenderLink("~/www/build/styles/css/revenue-structure.css")" />
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/n88/left-menu-panel.js")
}

<div class="main-content">
    @if (isN88)
    {
        <div class="mobile-left-panel">
            <span>List Category</span>
        </div>
        <div class="left-panel" id="left-panel-menu">
            <div class="menu">
                <ul class="nav navbar-nav" id="left-panel-nav">
                    <li>
                        <a class="left-menu-item active" href="#WhatWeHave">
                            @Lang.WhatWeHave
                        </a>
                        @*<ul class="sub-menu">
                            <li><a href="#" class="active">Sub menu 1</a></li>
                            <li><a href="#">Sub menu 1</a></li>
                            <li><a href="#">Sub menu 1</a></li>
                            <li><a href="#">Sub menu 1</a></li>
                        </ul>*@
                    </li>
                    <li>
                        <a class="left-menu-item" href="#WhatWeOffer">
                            @Lang.WhatWeOffer
                        </a>
                    </li>
                    <li>
                        <a class="left-menu-item" href="#OurPlan">
                            @Lang.OurPlan
                        </a>
                    </li>
                    <li>
                        <a class="left-menu-item" href="#RevenueSharePayoutExample">
                            @Lang.RevenueSharePayoutExample
                        </a>
                    </li>
                    <li>
                        <a class="left-menu-item" href="#HowWePay">
                            @Lang.HowWePay
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    }
    <div class="content">
        <div class="page-title">
            <span class="text">@Lang.CommissionStructure</span>
        </div>

        @Html.Raw(htmlString)

        @RazorHelper.RenderMovingTopButton()
    </div>
</div>


