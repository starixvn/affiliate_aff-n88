@{
    ViewBag.Title = Lang.CommissionStructure;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}
@model string
@{
    var viewName = "~/Views/CommissionStructure/" + AppSetting.Instance.SiteName + "/_Content." + Model + ".cshtml";

    var htmlString = Html.Partial(viewName).ToHtmlString();
}

@section styles{
    <link rel="stylesheet" href="@Url.RenderLink("~/www/build/styles/css/revenue-structure.css")"/>
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/revenue-structure.js")
}



<div class="content">
    <div class="page-title">
        <span class="text">@Lang.CommissionStructure</span>
    </div>

    @Html.Raw(htmlString)

    @RazorHelper.RenderMovingTopButton()
</div>