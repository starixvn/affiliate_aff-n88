@model Fanex.Affiliate.User.Core.ViewModels.RevenueSharingStructureViewModel

@{
    ViewBag.Title = Lang.CommissionStructure;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}
@{
    var htmlString = Html.RenderPartialByLanguage("~/Views/CommissionStructure/N8B/_Content", Model.CurrentLanguage, Model).ToHtmlString();
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/revenue-share.js")
}

<div class="revenue-share-banner">
    <div class="banner-title">
        <div>@Lang.CommissionStructure</div>
    </div>
</div>
<div class="revenue-share-new-page">
    @Html.Raw(htmlString)

    @RazorHelper.RenderMovingTopButton()
</div>