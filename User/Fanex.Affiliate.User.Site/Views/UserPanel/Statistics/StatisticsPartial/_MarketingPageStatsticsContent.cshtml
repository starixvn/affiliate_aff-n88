@using Fanex.Affiliate.User.Core.DTO.UserPanel;
@using System.Linq;
@model IEnumerable<IGrouping<string, MarketingPageStatistics>>

@helper RenderItem(IGrouping<string, MarketingPageStatistics> item, int index)
{

    var channelName = item.First().ChannelName;


    <tr data-id='@item.Key' class='parent-item'>
        <td class="text-center">@index</td>
        <td class="text-bold">
            <div class="flex">
                <span class="flex-0">@channelName</span>
                <div class="flex-middle">
                    <button class="btn btn-transparent">
                        <span class="glyphicon glyphicon-chevron-right"></span>
                    </button>
                </div>
            </div>
        </td>
        <td class="text-center">-</td>
        <td class="text-right">@item.Sum(l => l.TotalClick).FormatNumber() </td>
        <td class="text-right">@item.Sum(l => l.UniqueClick).FormatNumber() </td>
        <td class="text-right">@item.Sum(l => l.SignUps).FormatNumber() </td>
        <td class="text-right">@item.Sum(l => l.Fdm).FormatNumber() </td>
    </tr>
    foreach (var link in item)
    {
        @RenderLinkRow(link);
    }
}

@helper RenderLinkRow(MarketingPageStatistics link)
{
    <tr data-parent="@link.ChannelName" class="display-none">
        <td></td>
        <td>@(string.IsNullOrEmpty(link.AffMediaLink) ? "none" : link.AffMediaLink)</td>
        <td class="text-center">@(string.IsNullOrEmpty(link.MarketName) ? "none" : link.MarketName)</td>
        <td class="text-right">@link.TotalClick.FormatNumber()</td>
        <td class="text-right">@link.UniqueClick.FormatNumber()</td>
        <td class="text-right">@link.SignUps.FormatNumber()</td>
        <td class="text-right">@link.Fdm.FormatNumber()</td>
    </tr>
}

<table style="table-layout: fixed; width: 100%" class="row-toogleable-table">
    <thead>
        <tr>
            <th width="4%"></th>
            <th width="46%">@Lang.Channel</th>
            <th width="12%">@Lang.Language</th>
            <th width="10%">@Lang.TotalClick</th>
            <th width="10%">@Lang.UniqueClick</th>
            <th width="10%">@Lang.Signup</th>
            <th width="8%">@Lang.FTD</th>
        </tr>
    </thead>
    <tbody>
        @{
            if (Model != null && Model.Any())
            {
                var index = 1;
                foreach (var item in Model)
                {
                    @RenderItem(item, index);
                    index++;
                }
            }
            else
            {
                <tr>
                    <td class="text-center" colspan="7">@Lang.NoInfo</td>
                </tr>
            }
        }
    </tbody>
</table>
