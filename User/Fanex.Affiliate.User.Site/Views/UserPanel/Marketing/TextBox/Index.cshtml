@{
    Layout = null;
}
@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.Marketing.OldMarketingViewModel

@Html.InlineStyles("~/www/build/styles/css/oldmarketing.css")

<div class="page-title">
    <span class="text">@Lang.Text</span>
</div>

<div id="searchForm">
    @{ Html.RenderPartial("~/Views/UserPanel/Marketing/MarketingPartial/_SearchForm.cshtml", Model.SearchForm); }
</div>

<div id="linkForm">
    @{ Html.RenderPartial("~/Views/UserPanel/Marketing/MarketingPartial/_LinkForm.cshtml", Model.LinkForm); }
</div>

<div id="textLinkList">
    @{ Html.RenderPartial("~/Views/UserPanel/Marketing/MarketingPartial/_TextLink.cshtml", Model.TextLinkList); }
</div>

<div id="dataContainerList">
    <div class="info-group">
        <div class="title">
            <span class="text">@Lang.Text</span>
        </div>

        @{ Html.RenderPartial("~/Views/UserPanel/Marketing/MarketingPartial/_BannerFilter.cshtml"); }

        <div id="marketingPager"></div>
        <div id="marketingDataList">
            @{ Html.RenderPartial("~/Views/UserPanel/Marketing/MarketingPartial/_TextList.cshtml", Model.MarketingDataList); }
        </div>
    </div>
</div>

<script src="@Url.RenderLink("~/www/build/js/textbox.js")"></script>