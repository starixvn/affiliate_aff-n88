@{
    Layout = null;
}

@Html.InlineStyles("~/www/build/styles/css/player-transfer-balance.css")

<div class="page-title">
    <span class="text">@Lang.TransferBalanceForPlayer</span>
</div>

<div class="alert" role="alert" id="messageResult" style="display: none"></div>
<div class="info-group">
    <div class="form-horizontal">
        <div class="form-group">
            <label class="col-sm-3 control-label">@Lang.PlayerUserName </label>
            <div class="col-sm-4">
                <input class="form-control" id="playerUserName" />
            </div>
            <div class="col-sm-2 "><button class="btn btn-submit" id="btn-search">@Lang.Search</button></div>
        </div>
        <div class="transfer-info hidden">
            <div class="form-group">
                <label class="col-sm-3 control-label" id="player-currency-label">@Lang.PlayerCurrency</label>
                <div class="col-sm-6 form-control-static ">
                    <span class="form-control-static" id="player-currency">USD</span>
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-3 control-label">
                    <div class="text-bold">@Lang.AvailableBalance</div>
                    <div class="text-italic" id="payment-acc-label">@Lang.InYourPaymentAcc</div>
                </div>

                <div class="col-sm-6 form-control-static flex">
                    <span class="form-control-static text-uppercase" id="avail-bal">0 USD</span>
                    <span class="text-uppercase form-control-static" id="avail-bal-base-currency">0 USD</span>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">@Lang.TransferLimit</label>
                <div class="col-sm-6 form-control-static ">
                    <span class="form-control-static text-uppercase" id="transfer-limit">0 USD</span>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label" id="transfer-amount-label">@Lang.TransferAmountTo</label>
                <div class="col-sm-6 flex " id="exchangeRate">
                    <span class="form-control-static text-uppercase" id="exchange-player-currency">USD</span>
                    <input class="form-control text-right" min="0" step="any" id="amount" type="number" />
                    <span class="form-control-static text-uppercase" id="exchange-base-currency">~ 0 USD</span>
                </div>
            </div>
            <div class="col-sm-offset-3 btn-block">
                <button class="btn btn-submit disabled" id="btn-submit">@Lang.Submit</button>
            </div>
        </div>
    </div>
</div>

<script src="@Url.RenderLink("~/www/build/js/player-transfer-balance.js")"></script>
