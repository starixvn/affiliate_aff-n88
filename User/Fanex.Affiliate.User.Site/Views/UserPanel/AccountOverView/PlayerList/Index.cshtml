@{
    Layout = null;
}

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.PlayerListViewModel

<link href="@Url.RenderLink("~/www/build/styles/css/player-list.css")" rel="stylesheet" />

<div class="container-fluid" id="player-list">
    <div class="info-group">
        <div class="panel custom-panel">
            <div class="panel-body">
                <form class="form-inline form-filter">
                    <div class="form-group">
                        <label>@Lang.Player:</label>
                        <select id="PlayerType" class="form-control">
                            @foreach (var item in EnumHelper.GetSelectList(typeof(Fanex.Affiliate.User.Core.Enum.PlayerType)))
                            {
                                <option value="@item.Value">@Lang.ResourceManager.GetString(item.Text)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>@Lang.From:</label>
                        <div id="fromPicker" class="date-wrapper">
                            <input readonly class="form-control" type="text" id="FromDate" value="@Model.FromDate.ToString("MM/dd/yyyy")" />
                            <span class="glyphicon glyphicon-calendar"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>@Lang.To:</label>
                        <div id="toPicker" class="date-wrapper">
                            <input readonly class="form-control" type="text" id="ToDate" value="@Model.ToDate.ToString("MM/dd/yyyy")" />
                            <span class="glyphicon glyphicon-calendar"></span>
                        </div>
                    </div>
                    <div class="checkbox form-group">
                        <label class="text-bold">
                            <input id="ignoreDateFilter" type="checkbox" />
                            @Lang.ShowAllPlayersIgnoreDateFilter
                        </label>
                    </div>
                    <button type="button" class="btn btn-submit btn-player-list" id="btnSubmit">@Lang.Submit</button>
                </form>
            </div>
        </div>
        <div class="report-container">
            <div class="table table-medium table-responsive display-none" id="player-list-table"></div>
            <div id="pager"></div>
        </div>
    </div>
</div>

<script src="@Url.RenderLink("~/www/build/js/player-list.js")"></script>