@model Fanex.Affiliate.User.Core.DTO.UserPanel.PlayerListResult

<table>
    <thead>
        <tr>
            <th width="10%">#</th>
            <th width="30%">@Lang.Username</th>
            <th width="30%">@Lang.Currency</th>
            <th width="30%">@Lang.RegisteredDate</th>
        </tr>
    </thead>
    <tbody>
        @{
            if (Model.Items != null && Model.Items.Any())
            {
                var idx = (int)ViewBag.StartRowNumber;
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-center">@idx</td>
                        <td>@item.Username</td>
                        <td class="text-center">@item.Currency</td>
                        <td class="text-center">@(item.RegisteredDate?.ToString("MM/dd/yyyy HH:mm:ss") ?? string.Empty)</td>
                    </tr>

                    idx++;
                }
            }
            else
            {
                <tr>
                    <td class="text-center no-info" colspan="4">@Lang.NoInfo</td>
                </tr>
            }
        }
    </tbody>
</table>

<input id="TotalItem" type="hidden" value="@Model.TotalRow" />