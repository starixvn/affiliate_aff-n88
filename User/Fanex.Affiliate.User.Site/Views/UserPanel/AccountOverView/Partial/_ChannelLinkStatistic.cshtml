
@{
    Layout = null;
}

@model IEnumerable<IGrouping<string, Fanex.Affiliate.User.Core.DTO.MarketingChannelLink>>

@helper RenderItem(IGrouping<string, Fanex.Affiliate.User.Core.DTO.MarketingChannelLink> item, int index)
{

    var channelName = item.First().ChannelName;

    <tr data-id='@item.Key' class='parent-item'>
        <td>@index</td>
        <td class="text-bold">
            <div class="flex">
                <span class="flex-0">@channelName</span>
                <div class="flex-middle">
                    <button class="btn btn-transparent">
                        <span class="glyphicon glyphicon-chevron-right"></span>
                    </button>
                </div>
            </div>
        </td>
        <td class="text-center text-bold">@item.Count()</td>
        <td class="text-center">-</td>
    </tr>
    foreach (var link in item)
    {
        @RenderLinkRow(link);
    }
}

@helper RenderLinkRow(Fanex.Affiliate.User.Core.DTO.MarketingChannelLink link)
{
    <tr data-parent="@link.ChannelCode" class="display-none">
        <td></td>
        <td>@link.AffMediaLink</td>
        <td></td>
        <td>@link.DisplayName</td>
    </tr>
}


<div id="channel-table" class="table table-responsive">
    <table>
        <thead>
            <tr>
                <th width="10%"></th>
                <th width="40%">@Lang.Channel</th>
                <th>@Lang.NumberOfLink </th>
                <th>@Lang.Language</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null && Model.Any())
                {
                    var id = 1;

                    foreach (var item in Model)
                    {
                        @RenderItem(item, id);
                        id++;
                    }
                }
                else
                {
                    <tr>
                        <td class="text-center" colspan="4">@Lang.NoInfo</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<script src="@Url.RenderLink("~/www/build/js/channel-link-statistic.js")"></script>
