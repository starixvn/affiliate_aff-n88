@{
    Layout = null;
}
@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.Marketing.AffiliateLinkViewModel
@{
    var linkTypes = Model.LinkTypes ?? new List<SelectListItem>();
    var targetCountries = Model.TargetCountries ?? new List<SelectListItem>();
    var availableDomains = Model.Domains ?? new List<SelectListItem>();
    var landingPages = Model.SitePages ?? new List<SelectListItem>();
    var languages = Model.Languages ?? new List<SelectListItem>();

    var channels = new List<SelectListItem> { new SelectListItem { Text = Lang.AddNew, Value = "add-new" } };
    channels.AddRange(Model.Channels.Select(c => new SelectListItem { Value = c.Key, Text = c.Value }));

    var hasAnyDomain = availableDomains.Any();
    var hasAnyMemberSitePage = landingPages.Any();

    var disabled = hasAnyDomain && hasAnyMemberSitePage && channels.Count > 1 ? "" : "disabled";
}

@Html.InlineStyles("~/www/build/styles/css/n88/marketing.min.css")
<div class="wrapper-after-login" id="aff-link">
    <div class="wrapper-layout-after-login">
        <div class="column">
            <div id="searchForm" class="info-group">
                <div class="title">
                    <span class="text">@Lang.Search</span>
                </div>
                <div class="search-container">
                    <form>
                        <div class="column-form">
                            @RazorHelper.RenderDropdownForN88Marketing("AffLinkType", Lang.AffiliateLinkType, linkTypes, false)
 
                            @RazorHelper.RenderDropdownForN88Marketing("TargetCountry", Lang.TargetCountry, targetCountries, false)

                            @RazorHelper.RenderDropdownForN88Marketing("Language", Lang.Language, languages, languages.Count() > 1)

                        </div>
                        <div class="column-form">
                            @RazorHelper.RenderDropdownForN88MarketingHasNoInfo("Domain", Lang.AvailableDomains, availableDomains, hasAnyDomain)

                            @RazorHelper.RenderDropdownForN88MarketingHasNoInfo("Page", Lang.LinkTo, landingPages, hasAnyMemberSitePage)

                            @RazorHelper.RenderDropdownForN88Marketing("Channel", Lang.Channel, channels, false)
                            <div class="form-group flex-sm-boostrap flex-center form-group-button">
                                <label class="control-label none-label"></label>
                                <div class="control-input">
                                    <button @disabled type="button" class="btn btn-submit btn-gen" id="btnMarketingSubmit">@Lang.GenerateLink</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="qr-code">
                <div class="info-group">
                    <div class="title">
                        <span class="text">@Lang.TrackingAndQrCode</span>
                    </div>
                </div>
                <div id="qr-code">

                </div>
            </div>
        </div>
        <div class="column">
            <div class="info-group">
                <div class="title">
                    <span class="text">@Lang.MarketingPage</span>
                </div>
            </div>
            <div id="link-statistic" class="link-statistic">

            </div>
        </div>
    </div>
</div>
<script>
    window.searchOption = @Html.Raw(Json.Encode(Model));
    var dic = {
        'enterChannel': '@Html.Raw(Lang.EnterChannel)',
        'addChannelSuccess': '@Html.Raw(Lang.AddChannelSuccess)',
        'confirmActiveLink': '@Html.Raw(Lang.ConfirmActiveLink)',
        'invalidChannelName': '@Html.Raw(Error.InvalidChannelName)',
        'nameToLong20': '@Html.Raw(Error.NameToLong20)',
        'confirmDeactiveLink': '@Html.Raw(Lang.ConfirmDeactiveLink)'
    }
    window.dic = Object.assign({}, window.dic, dic)
</script>

<script src="@Url.RenderLink("~/www/build/js/affiliate-link.js")"></script>