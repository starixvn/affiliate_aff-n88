@model IEnumerable<Fanex.Affiliate.User.Core.DTO.UserPanel.OverviewDetail>

@{
    var rowNum = Model.Count();
    var itemTotal = Model.LastOrDefault();
    var hasData = rowNum > 1;
    var hasScroll = rowNum > 11;
}

<div class="table">
    <table class="has-total">
        <thead>
            <tr class="overview-table-header" id="overview-table-header">
                <th width="10%">@Lang.Date</th>
                <th width="10%">@Lang.NewSignup</th>
                <th width="12%">@Lang.DepositedPlayers</th>
                <th width="12%">@Lang.ActivePlayers</th>
                <th width="10%">@Lang.Deposit</th>
                <th width="10%">@Lang.Turnover</th>
                <th width="10%">@Lang.Withdrawal</th>
                <th width="10%">@Lang.Winlost</th>
            </tr>
            @{
                if (hasData)
                {
                    <tr class="overview-table-total" id="overview-table-total">
                        <th class="text-center">Total</th>
                        <th class="text-center">@itemTotal.Signups</th>
                        <th class="text-center">@itemTotal.DepositedMembers</th>
                        <th class="text-center">@itemTotal.ActiveMembers</th>
                        <th class="text-center">@itemTotal.Deposit.FormatDecimal()</th>
                        <th class="text-center">@itemTotal.Turnover.FormatDecimal()</th>
                        <th class="text-center">@itemTotal.Withdrawal.FormatDecimal()</th>
                        <th class="text-center">@itemTotal.Winloss.FormatDecimal()</th>
                    </tr>
                }
            }
        </thead>
        <tbody class="@(hasScroll ? "has-scroll" : string.Empty)">
            @{
                if (hasData)
                {
                    for (var i = 0; i < rowNum - 1; i++)
                    {
                        var item = Model.ElementAt(i);
                        <tr>
                            <td class="text-center">@item.WinlostDate.ToString("MM/dd/yyyy")</td>
                            <td class="text-center">@item.Signups</td>
                            <td class="text-center">@item.DepositedMembers</td>
                            <td class="text-center">@item.ActiveMembers</td>
                            <td class="text-center">@item.Deposit.FormatDecimal()</td>
                            <td class="text-center">@item.Turnover.FormatDecimal()</td>
                            <td class="text-center">@item.Withdrawal.FormatDecimal()</td>
                            <td class="text-center">@item.Winloss.FormatDecimal()</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td class="text-center" colspan="9">@Lang.NoInfo</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script src="@Url.RenderLink("~/www/build/js/overview.js")"></script>