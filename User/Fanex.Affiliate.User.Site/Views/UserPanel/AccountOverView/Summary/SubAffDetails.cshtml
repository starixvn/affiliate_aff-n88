
@{
    Layout = null;
    var hasScroll = Model != null && Model.Count() > 10;
}

@model IEnumerable<Fanex.Affiliate.User.Core.DTO.UserPanel.SubAffDetail>

<div class="table player-detail-table">
    <table id="player-detail-table">
        <thead>
            <tr class="player-detail-table-header">
                <th width="8%">No.</th>
                <th width="16%" class="th" data-name="Username">
                    <div class="th-wrapper">
                        <span>@Lang.Username</span>
                    </div>
                </th>
                <th width="16%" class="th" data-name="FirstName">
                    <div class="th-wrapper">
                        <span>@Lang.FName</span>
                    </div>
                </th>
                <th width="10%" class="th" data-name="LastName">
                    <div class="th-wrapper">
                        <span>@Lang.LName</span>
                    </div>
                </th>
                <th width="10%" class="th" data-name="ApprovedDate">
                    <div class="th-wrapper">
                        <span>@Lang.ApprovalDate</span>
                    </div>
                </th>
                <th width="10%" hidden class="th" data-name="SuspensionStatus">
                    <div class="th-wrapper">
                        <span>@Lang.SuspensionSatus</span>
                    </div>
                </th>
                <th width="10%" hidden class="th" data-name="SuspensionDate">
                    <div class="th-wrapper">
                        <span>@Lang.SuspensionDate</span>
                    </div>
                </th>
                <th width="10%" class="th" data-name="TurnOver">
                    <div class="th-wrapper">
                        <span>@Lang.TotalTurnover</span>
                    </div>
                </th>
                <th width="10%" class="th" data-name="WinLoss">
                    <div class="th-wrapper">
                        <span>@Lang.TotalWinLoss</span>
                    </div>
                </th>
                <th width="10%" class="th" data-name="Commission">
                    <div class="th-wrapper">
                        <span>@Lang.TotalCommission</span>
                    </div>
                </th>
                <th width="10%" class="th" data-name="ActivePlayer">
                    <div class="th-wrapper">
                        <span>@Lang.NumberOfActivePlayers</span>
                    </div>
                </th>
                <th width="10%" hidden class="th" data-name="Remove">
                    <div class="th-wrapper">
                        <span>@Lang.Remove</span>
                    </div>
                </th>
            </tr>
        </thead>
        <tbody id="player-detail-content">
            @{
                if (Model != null && Model.Any())
                {
                    var startRowNumber = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@startRowNumber</td>
                            <td class="text-center break-all">@item.UserName</td>
                            <td class="text-center">@item.FirstName</td>
                            <td class="text-center">@item.LastName</td>
                            <td class="text-center">@item.ApprovedDate.ToString("dd/MM/yyyy hh:mm:ss")</td>
                            <td class="text-center">@item.Turnover.FormatDecimal()</td>
                            <td class="text-center">@item.Winloss.FormatDecimal()</td>
                            <td class="text-center">@item.Commission.FormatDecimal()</td>
                            <td class="text-center">@item.ActivePlayer</td>
                        </tr>

                        startRowNumber++;
                    }
                }
                else
                {
                <tr>
                    <td class="text-center" colspan="9">@Lang.NoInfo</td>
                </tr>
                }
            }
        </tbody>
    </table>
</div>


