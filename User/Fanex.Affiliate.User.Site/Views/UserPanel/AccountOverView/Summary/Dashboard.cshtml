@model Fanex.Affiliate.User.Core.DTO.UserPanel.OverviewSummary

<div class="">
    <span class="my-account">@Lang.MyAccount</span>
    <div class="group group-one">
        <div class="img-icon">
            <img class="img-responsive" src="~/www/build/styles/Images/account-overview/new-sign-up.png" />
        </div>
        <div class="info-panel">
            <span class="info-panel-title">@Lang.NewSignup / @Lang.Deposit</span>
            <span class="info-panel-content">@($"{Model.Signups}/{Model.DepositedMembers}")</span>
        </div>

        <div class="info-panel">
            <span class="info-panel-title">@Lang.ActivePlayers</span>
            <span class="info-panel-content">@($"{Model.ActivePlayers}")</span>
        </div>
    </div>
    <div class="group group-two">
        <div class="img-icon">
            <img class="img-responsive" src="~/www/build/styles/Images/account-overview/commission.png" />
        </div>
        <div class="info-panel">
            <span class="info-panel-title">@Lang.Commission</span>
            <span class="info-panel-content">@Model.Commission.ToStringMoneyWithSymbol()</span>
        </div>
        <div class="info-panel">
            <span class="info-panel-title">@Lang.BalanceBroughtFoward</span>
            <span class="info-panel-content">@Model.BalanceBroughtForward.ToStringMoneyWithSymbol()</span>
        </div>
    </div>
    <div class="group group-three">
        <div class="img-icon">
            <img class="img-responsive" src="~/www/build/styles/Images/account-overview/total-deposit.png" />
        </div>
        <div class="info-panel">
            <span class="info-panel-title">@Lang.TotalDeposit</span>
            <span class="info-panel-content">@Model.Deposit.ToStringMoneyWithSymbol()</span>
        </div>
        <div class="info-panel">
            <span class="info-panel-title">@Lang.TotalTurnover</span>
            <span class="info-panel-content">@Model.Turnover.ToStringMoneyWithSymbol()</span>
        </div>
    </div>
</div>
@if (!Model.IsMaxSubLevel)
{
    <div>
        <span class="my-account">@Lang.SubAffiliate</span>
        <div class="group group-four">
            <div class="img-icon">
                <img class="img-responsive" src="~/www/build/styles/Images/account-overview/icon-subaff.png" />
            </div>
            <div class="info-panel">
                <span class="info-panel-title">@Lang.SubAffDownline</span>
                <span class="info-panel-content">@Model.NoOfSubAff</span>
            </div>

            <div class="info-panel">
                <span class="info-panel-title">@Lang.SubAffEarning </span>
                <span class="info-panel-content">@Model.SubAffCommission.ToStringMoneyWithSymbol()</span>
            </div>
        </div>
    </div>
}

