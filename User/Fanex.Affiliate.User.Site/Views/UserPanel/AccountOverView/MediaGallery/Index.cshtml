@{
    Layout = null;
}

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.Marketing.MediaGallerySearchFormViewModel
@{
    var linkTypes = Model.LinkTypes ?? new List<SelectListItem>();
    var targetCountries = Model.TargetCountries ?? new List<SelectListItem>();
    var availableDomains = Model.Domains ?? new List<SelectListItem>();
    var landingPages = Model.SitePages ?? new List<SelectListItem>();
    var languages = Model.Languages ?? new List<SelectListItem>();

    var channels = new List<SelectListItem> { new SelectListItem { Text = Lang.AddNew, Value = "add-new" } };
    channels.AddRange(Model.Channels.Select(c => new SelectListItem { Value = c.Key, Text = c.Value }));

    var category = Model.CategoryList ?? new List<SelectListItem>();

    var hasAnyDomain = availableDomains.Any();
    var hasAnyMemberSitePage = landingPages.Any();

    var disabled = hasAnyDomain && hasAnyMemberSitePage && channels.Count > 1 ? "" : "disabled";
}

@Html.InlineStyles("~/www/build/styles/css/marketing.min.css")

<div class="container-fluid" id="media-gallery">
    <div class="col-md-6">
        <div class="row">
            <div id="searchForm" class="info-group">
                <div class="title">
                    <span class="text">@Lang.Search</span>
                </div>
                <div class="search-container">
                    <form>
                        <div class="col-md-6">
                            @RazorHelper.RenderDropdownForMarketing("AffLinkType", Lang.AffiliateLinkType, linkTypes, false)

                            @RazorHelper.RenderDropdownForMarketing("TargetCountry", Lang.TargetCountry, targetCountries, false)

                            @RazorHelper.RenderDropdownForMarketing("Language", Lang.Language, languages, languages.Count() > 1)
 
                            @RazorHelper.RenderDropdownForMarketingHasNoInfo("Domain", Lang.AvailableDomains, availableDomains, hasAnyDomain)

                            @RazorHelper.RenderDropdownForMarketing("Category", Lang.Category, category)

                            @RazorHelper.RenderDropdownForMarketing("SubCategory", Lang.SubCategory, new List<SelectListItem>(), true, false)

                            <div class="form-group flex-sm-boostrap flex-center">
                                <label class="col-sm-3 control-label">@Lang.Device</label>
                                <div class="col-sm-9">
                                    <select class="form-control" id="DeviceType">
                                        @foreach (var item in EnumHelper.GetSelectList(typeof(Fanex.Affiliate.User.Core.Enum.DeviceType)))
                                        {
                                            <option value="@item.Value">@Lang.ResourceManager.GetString(item.Text)</option>
                                        }
                                    </select>

                                </div>
                            </div>

                        </div>
                        <div class="col-md-6">
                            @RazorHelper.RenderDropdownForMarketing("Currency", Lang.Currency, Model.CurrencyList)
 
                            <div class="form-group flex-sm-boostrap flex-center">
                                <label class="col-sm-3 control-label">@Lang.Device</label>
                                <div class="col-sm-9">
                                    <select class="form-control" id="DeviceType">
                                        @foreach (var item in EnumHelper.GetSelectList(typeof(Fanex.Affiliate.User.Core.Enum.DeviceType)))
                                        {
                                            <option value="@item.Value">@Lang.ResourceManager.GetString(item.Text)</option>
                                        }
                                    </select>

                                </div>
                            </div>
 
                            @RazorHelper.RenderDropdownForMarketing("Size", Lang.Size, Model.SizeList)

                            @RazorHelper.RenderDropdownForMarketingHasNoInfo("Page", Lang.LinkTo, landingPages, hasAnyMemberSitePage)

                            @RazorHelper.RenderDropdownForMarketing("Channel", Lang.Channel, channels, false)

                            <div class="form-group">
                                <div class="col-sm-offset-3 col-sm-1">
                                    <button type="button" @disabled class="btn btn-submit btn-gen" id="btnMarketingSubmit">@Lang.SearchAndGenQR</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="row">
            <div class="info-group">
                <div class="title">
                    <span class="text">@Lang.TrackingAndQrCode</span>
                </div>
            </div>
            <div id="qr-code" class="col-md-12">

            </div>
        </div>
    </div>
</div>

<div id="dataContainerList">
    <div class="info-group">
        <div class="title">
            <span class="text">@Lang.Banner</span>
        </div>

        <div id="marketingDataList">
        </div>

        <div id="marketingPager"></div>
    </div>
</div>

<script>
    window.searchOption = @Html.Raw(Json.Encode(Model));
    var dic = {
        'enterChannel': '@Html.Raw(Lang.EnterChannel)',
        'addChannelSuccess': '@Html.Raw(Lang.AddChannelSuccess)',
        'confirmActiveLink': '@Html.Raw(Lang.ConfirmActiveLink)',
        'confirmDeactiveLink': '@Html.Raw(Lang.ConfirmDeactiveLink)',
        'invalidChannelName': '@Html.Raw(Error.InvalidChannelName)',
        'nameToLong20': '@Html.Raw(Error.NameToLong20)',
        'all': '@Html.Raw(Lang.All)',
    }
    window.dic = Object.assign({}, window.dic, dic)
</script>

<script src="@Url.RenderLink("~/www/build/js/mediagallery.js")"></script>