@{
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";

    var lastDateOfMonth = new DateTime(Model.SelectedDate.Year, Model.SelectedDate.Month + 1, 1).AddDays(-1);
}

@section styles{
    <link href="@Url.RenderLink("~/www/build/styles/css/betlist/betlist.css")" rel="stylesheet" />
    <link href="@Url.RenderLink("~/www/build/styles/css/betlist.css")" rel="stylesheet" />
}

@section scripts{
    <script type="text/javascript">
        var resourceLang = {
            result: '@Lang.result'
        }
    </script>

    <script src="@Url.RenderLink("~/www/build/js/betlist.js")"></script>
}

@model Fanex.Affiliate.User.Core.ViewModels.BetList.MainBetListViewModel

<div id="mainPanel">
    <div class="page-title">
        <span class="text">@Lang.lblBetLists</span>
    </div>

    <div>
        <div class="breadcrumb-container">
            <ol class="breadcrumb" id="dailyEarningBreadcrumb">
                <li><a href="@Url.Content("~/UserPanel/Main/#StatementHistory")">@Lang.StatementHistory (@lastDateOfMonth.ToString("MMM yyyy"))</a></li>
                <li>
                    <a href="@Url.Content("~/UserPanel/Main/#DailyEarning?monthDate=" + HttpUtility.UrlEncode(lastDateOfMonth.ToString("MM/dd/yyyy")))">
                        @lastDateOfMonth.ToString("MMMM yyyy")
                    </a>
                </li>
                <li>
                    <a href="@Url.Content("~/UserPanel/Main/#DailyEarningDetail?monthDate=" + HttpUtility.UrlEncode(Model.SelectedDate.ToString("MM/dd/yyyy")) + "&sportType=" + Model.SelectedSportType)">
                        @Model.SelectedDate.ToString("dd MMMM yyyy")
                    </a>
                </li>
                <li>@Model.UserName</li>
            </ol>
        </div>

        <div class="table" id="betlistContent">
            @if (string.IsNullOrEmpty(Model.BetListHtml))
            {
                <p class="text-center">@Lang.NoInfo</p>
            }
            else
            {
                @Html.Raw(Model.BetListHtml)
            }
        </div>
    </div>
</div>

<div class="modal fade betlist-dialog" tabindex="-1" role="dialog" id="betlistDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="betListDisalogTitle"></h4>
            </div>
            <div class="modal-body" id="betlistDialogContent"></div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->

