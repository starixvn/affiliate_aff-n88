@{ 
    Layout = null;

    var hasData = Model.MainData != null && Model.MainData.Any();
}

@using Fanex.Affiliate.User.Core.Constants
@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.DailyEarningDetailViewModel

<table>
    <thead>
        <tr>
            <th width="3%"></th>
            <th width="15%">@Lang.Username</th>
            <th width="10%">@Lang.Deposit</th>
            <th width="10%">@Lang.Withdrawal</th>
            <th width="10%">@Lang.Turnover</th>
            <th width="10%">@Lang.Winlost</th>
        </tr>
    </thead>
    <tbody>
        @{
            if (hasData)
            {
                var index = 1;
                foreach (var item in Model.MainData)
                {
                    var userName = item.UserName.ToLowerInvariant().StartsWith("12bet$") ?
                        item.UserName.Substring(6, item.UserName.Length - 6) :
                        item.UserName;
                    <tr>
                        <td>@index</td>
                        <td class="text-center">
                            @if (Model.HasDailyDetail && Model.SelectedProduct == Product.Sportsbook && item.Turnover > 0)
                            {
                                var param = new
                                {
                                    date = Model.SelectedDate.ToString("MM/dd/yyyy"),
                                    sportType = Model.SelectedProduct,
                                    custId = item.CustId,
                                    userName = item.UserName
                                };

                                <a class="earningDetailItem" href="javascript:;" data-param="@Json.Encode(param)">
                                    @userName
                                </a>
                            }
                            else
                            {
                                @userName
                            }
                        </td>
                        <td class="text-right">
                            @if (item.Deposit > 0)
                            {
                                <a class="transactionItem" href="javascript:;" data-username="@item.UserName" data-date="@Model.SelectedDate.ToString("MM/dd/yyyy")" data-isdeposit="true">
                                    @item.Deposit.ToStringMoneyWithSymbol()
                                </a>
                            }
                            else
                            {
                                @item.Deposit.ToStringMoneyWithSymbol()
                            }
                        </td>
                        <td class="text-right">
                            @if (item.Withdrawal > 0)
                            {
                                <a class="transactionItem" href="javascript:;" data-username="@item.UserName" data-date="@Model.SelectedDate.ToString("MM/dd/yyyy")" data-isdeposit="false">
                                    @item.Withdrawal.ToStringMoneyWithSymbol()
                                </a>
                            }
                            else
                            {
                                @item.Withdrawal.ToStringMoneyWithSymbol()
                            }
                        </td>
                        <td class="text-right">@item.Turnover.ToStringMoneyWithSymbol()</td>
                        <td class="text-right">@item.WinLost.ToStringMoneyWithSymbol()</td>
                    </tr>

                    index++;
                }
            }
        }
    </tbody>


</table>

@if (!hasData)
{
    <p class="text-center">@Lang.NoInfo</p>
}
