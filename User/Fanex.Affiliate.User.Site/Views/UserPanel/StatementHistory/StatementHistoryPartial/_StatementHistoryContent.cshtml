@model IEnumerable<Fanex.Affiliate.User.Core.ViewModels.UserPanel.StatementHistoryViewModel>

@helper RenderItem(Fanex.Affiliate.User.Core.ViewModels.UserPanel.StatementHistoryViewModel item, int? index = null)
{
    var isLink = item.TransType != (byte)Fanex.Affiliate.User.Core.Enum.TransType.Payment
    && item.TransType != (byte)Fanex.Affiliate.User.Core.Enum.TransType.Adjustment
    && item.TransType != (byte)Fanex.Affiliate.User.Core.Enum.TransType.MonthlyTotal
    && DateTime.Compare(item.MonthDate, ViewBag.AvailableFromDate) > 0;

    <tr>
        <td>@index</td>
        <td class="text-bold">@item.DateString</td>
        <td>@item.TransTypeString</td>
        <td class="text-right">
            @if (isLink)
            {
                <a class="amountItem" data-date="@item.MonthDate.ToString("MM/dd/yyyy")" href="javascript:;">
                    @item.Amount.ToStringMoneyWithSymbol()
                </a>
            }
            else
            {
                @item.Amount.ToStringMoneyWithSymbol()
            }
        </td>
        <td class="text-center">@item.DisplayStatus</td>
        <td>
            @if (item.TransType == (byte)Fanex.Affiliate.User.Core.Enum.TransType.Payment
                || item.TransType == (byte)Fanex.Affiliate.User.Core.Enum.TransType.Commission
                || item.TransType == (byte)Fanex.Affiliate.User.Core.Enum.TransType.MonthlyTotal
                || item.TransType == (byte)Fanex.Affiliate.User.Core.Enum.TransType.SubAffBonus)
            {
                @Html.Raw(item.Description)
            }
        </td>
    </tr>
}
<div class="table table-responsive">
    <table>
        <thead>
            <tr>
                <th width="5%"></th>
                <th>@Lang.Date</th>
                <th>@Lang.Type</th>
                <th>@Lang.Amount</th>
                <th>@Lang.Status</th>
                <th>@Lang.Description</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null && Model.Any())
                {
                    var index = (int)ViewBag.StartRowNumber;

                    foreach (var item in Model)
                    {
                        @RenderItem(item, index);
                        if (item.Children != null)
                        {
                            foreach (var child in item.Children)
                            {
                                @RenderItem(child)
                            }
                        }

                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td class="text-center" colspan="6">@Lang.NoInfo</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<input type="hidden" id="TotalItem" value="@ViewBag.TotalItem" />

