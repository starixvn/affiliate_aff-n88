@{
    Layout = null;

    var lastDateOfMonth = new DateTime(Model.SelectedDate.Year, Model.SelectedDate.Month + 1, 1).AddDays(-1);
}
@Html.InlineStyles("~/www/build/styles/css/dailyearning-detail.css")

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.DailyEarningDetailViewModel

<div class="page-title">
    <span class="text">@Lang.DailyEarningDetail</span>
</div>

<div>
    <div class="breadcrumb-container">
        <ol class="breadcrumb" id="dailyEarningBreadcrumb">
            <li><a href="@Url.Content("~/UserPanel/Main/#StatementHistory")">@Lang.StatementHistory</a></li>
            <li>
                <a href="@Url.Content("~/UserPanel/Main/#DailyEarning?monthDate=" + HttpUtility.UrlEncode(lastDateOfMonth.ToString("MM/dd/yyyy")))">
                    @Model.SelectedDate.ToString("MMMM yyyy")
                </a>
            </li>
        </ol>
    </div>

    <form class="form-inline form-filter">
        <div class="form-group">
            <label class="w100">@Lang.SelectDate:</label>
            <div id="datePicker" class="date-wrapper">
                <input readonly id="MonthDate" class="form-control" type="text" value="@Model.SelectedDate.ToString("MM/dd/yyyy")" />
                <span class="glyphicon glyphicon-calendar"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="w100">@Lang.ProductType:</label>
            <select class="form-control" id="ProductId">
                <option value="0">@Lang.All</option>
                @if (Model.ProductList != null && Model.ProductList.Any())
                {
                    foreach (var item in Model.ProductList)
                    {
                        <option value="@item.ProductId" @(item.ProductId == Model.SelectedProduct ? "selected" : string.Empty)>@item.ProductName</option>
                    }
                }
            </select>
        </div>
        <button type="button" class="btn btn-submit" id="btnEarningDetailSubmit">@Lang.Submit</button>
    </form>

    <div class="table table-responsive" id="dailyEarningDetailContent">
        @{ Html.RenderPartial("~/Views/UserPanel/StatementHistory/StatementHistoryPartial/_DailyEarningDetailContent.cshtml", Model); }
    </div>
</div>

<div class="modal fade transaction-dialog" tabindex="-1" role="dialog" id="transactionDialog">
    <div class="modal-dialog" role="document" style="width: 1100px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="transactionDisalogTitle"></h4>
            </div>
            <div class="modal-body" id="transactionDialogContent"></div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->

<script>
    var dialogTitle = {
        titleDeposit: '@Lang.MemDepositInfo',
        titleWithdrawal: '@Lang.MemberWithdrawalInfo'
    }
</script>

<script src="@Url.RenderLink("~/www/build/js/daily-earning-detail.js")"></script>
