@{
    Layout = null;

    var now = DateTime.Now;
    var fromDate = new DateTime(now.Year, now.Month, 1);
    var nowGmt8Plus = now.ToUniversalTime().AddHours(8);
    var fromDateGmt8Plus = fromDate.ToUniversalTime().AddHours(8);
}

@Html.InlineStyles("~/www/build/styles/css/player-transfer-balance.css")

<div class="sub-content">
    <div class="page-title">
        <span class="text">@Lang.TransferBalanceForPlayerHistory</span>
    </div>
    <div class="info-group">
        <form class="form-inline form-filter">
            <div class="form-group">
                <label>@Lang.Player</label>
                <input class="form-control" type="text" id="PlayerName" />
            </div>
            <div class="form-group">
                <label>@Lang.From</label>
                <div id="fromPicker" class="date-wrapper">
                    <input readonly id="FromDate" class="form-control" type="text" value="@fromDateGmt8Plus.ToString("MM/dd/yyyy")" />
                    <span class="glyphicon glyphicon-calendar"></span>
                </div>
            </div>
            <div class="form-group">
                <label>@Lang.To</label>
                <div id="toPicker" class="date-wrapper">
                    <input readonly id="ToDate" class="form-control" type="text" value="@nowGmt8Plus.ToString("MM/dd/yyyy")" />
                    <span class="glyphicon glyphicon-calendar"></span>
                </div>
            </div>
            <button type="button" class="btn btn-submit" id="btnSubmit">@Lang.Submit</button>
        </form>

        <div class="report-container">
            <div class="table table-large table-responsive" id="table">
            </div>

            <div id="pager"></div>
        </div>
    </div>
</div>
<script src="@Url.RenderLink("~/www/build/js/player-transfer-balance-history.js")"></script>