@{
    Layout = null;
}

@model Fanex.Affiliate.User.Core.ViewModels.MemberTransactionViewModel
@{
    var hasData = Model.TransactionList != null && Model.TransactionList.Any();
}

<div class="container-fluid transactin-container">
    <div class="table table-responsive">
        <table>
            <thead>
                <tr>
                    <th width="12%">@Lang.TransactionID</th>
                    <th width="10%">@Lang.Date</th>
                    <th width="8%">@Lang.Status</th>
                    <th width="12%">@Lang.AccountNumber</th>
                    <th width="8%">@Lang.BankName</th>
                    <th width="10%">@Lang.BankAddress</th>
                    <th width="8%">@Lang.BankCountry</th>
                    <th width="8%">@Lang.BankCity</th>
                    <th width="8%">@Lang.Currency</th>
                    <th width="8%">@Lang.Original</th>
                    <th width="8%">@Lang.USDEqv</th>
                </tr>
            </thead>
            <tbody>
                @if (hasData)
                {

                    foreach (var item in Model.TransactionList)
                    {
                        <tr>
                            <td class="text-center">@item.TransactionId</td>
                            <td class="text-center">@item.OriginalTransactionDate</td>
                            <td class="text-center">@item.Status</td>
                            <td class="text-center">@item.AccountNo</td>
                            <td class="text-center">@item.NameOfBank</td>
                            <td>@item.BankAddress</td>
                            <td class="text-center">@item.BankCountry</td>
                            <td class="text-center">@item.BankCityTown</td>
                            <td class="text-center">@item.Currency</td>
                            <td class="text-center">@item.OriginalAmount</td>
                            <td class="text-center">@item.Amount</td>
                        </tr>
                    }

                    <tr class="total">
                        <td class="text-center" colspan="10">@Lang.Total</td>
                        <td class="text-right">@Model.Total.ToStringMoneyWithSymbol()</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!hasData)
        {
            <p class="text-center">@Lang.NoInfo</p>
        }
    </div>
</div>