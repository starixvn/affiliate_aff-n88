@{
    Layout = null;
}

@{
    var from = ViewBag.UmTimeFrom as string;
    var to = ViewBag.UmTimeTo as string;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="refresh" content="30" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Under Maintenance</title>
    <link href="~/www/build/styles/css/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.RenderLink("~/www/build/styles/css/main.css")" rel="stylesheet" />
    <style type="text/css">
        body {
            background: -ms-linear-gradient(left, #500001, #020518);
            background: -webkit-linear-gradient(left, #500001, #020518);
            background: -moz-linear-gradient(left, #500001, #020518);
            background: -o-linear-gradient(left, #500001, #020518);
            background: linear-gradient(left, #500001, #020518);
        }

        .um-container {
            background: #f5f0f0;
            padding: 15px;
            width: 100%;
        }

        .info {
            color: #ff5a00;
        }

        .um-wrapper a:visited {
            color: #ff5a00;
        }

        .um-wrapper a:hover {
            color: #002aa0;
        }

        .um-wrapper h1 {
            font-family: Arial, Helvetica;
            font-size: 18px;
            font-weight: bold;
            color: #ff5a00;
            _padding-top: 20px;
            *padding-top: 20px;
            line-height: 25px;
            display: inline-block;
        }

        .um-header {
            margin-bottom: 10px;
        }

        .um-header-top {
            height: 90px;
            background: url('../../www/build/styles/Images/header-bg.png');
        }

        .logo{
            margin-top: 20px;
            margin-left: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="um-header-top">
            <img class="logo" src="~/www/build/styles/Images/logo.png" />
        </header>
    </div>
    <div class="container main-container">
        <div class="content">
            <div class="um-container">
                @*EN*@
                <div class="um-wrapper">
                    <div class="um-header">
                        <img src="~/www/build/styles/Images/notify/note_icon.gif" width="46" height="46" />
                        <h1>Under Maintenance</h1>
                    </div>

                    <div class="message-content">
                        <p>We are having server maintenance, website will be unavailable until <span class="um-time info">@to (HK Time GMT +8).</span></p>
                        <p>Please accept our apologies for the inconvenience caused!</p>
                        <p>
                            To reach customer service, please <a class="info" href="https://secure.livechatinc.com/licence/7903821/open_chat.cgi?groups=1" target="_blank">click here</a> or email to
                            <a class="info" href="mailto:support.my@12csd.com?subject=Enquiries%20sent%20from%20@(AppSetting.Instance.SiteFriendlyName)%20website">
                                support.my@12csd.com
                            </a>
                        </p>
                    </div>
                </div>

                <hr style="border-top: 1px dotted rgb(153, 153, 153);" noshade="noshade" size="1">

                @*CS*@
                <div class="um-wrapper">
                    <div class="um-header">
                        <img src="~/www/build/styles/Images/notify/note_icon.gif" width="46" height="46" />
                        <h1>伺服器维护</h1>
                    </div>

                    <div class="message-content">
                        <p>本公司正进行伺服器维护，时间至 <span class="um-time">@to (HK Time GMT +8).</span></p>
                        <p>所有网页将无法登入，不便之处有请见谅！</p>
                        <p>
                            如需要在线帮助，有请<a class="info" href="https://secure.livechatinc.com/licence/7903821/open_chat.cgi?groups=2" target="_blank">点击这里</a>或邮件至
                            <a class="info" href="mailto:support.cs@12csd.com?subject=Enquiries%20sent%20from%20@(AppSetting.Instance.SiteFriendlyName)%20website">
                                support.cs@12csd.com
                            </a>
                        </p>
                    </div>
                </div>

                <hr style="border-top: 1px dotted rgb(153, 153, 153);" noshade="noshade" size="1">

                @*CH*@
                <div class="um-wrapper">
                    <div class="um-header">
                        <img src="~/www/build/styles/Images/notify/note_icon.gif" width="46" height="46" />
                        <h1>伺服器維護</h1>
                    </div>

                    <div class="message-content">
                        <p>本公司正進行伺服器維護，時間至 <span class="um-time info">@to (HK Time GMT +8).</span></p>
                        <p>所有網頁將無法登入，不便之處 有請見諒！</p>
                        <p>
                            如需要在線幫助，有請<a class="info" href="https://secure.livechatinc.com/licence/7903821/open_chat.cgi?groups=1" target="_blank">點擊這裡</a>或郵件至
                            <a class="info" href="mailto:support.my@12csd.com?subject=Enquiries%20sent%20from%20@(AppSetting.Instance.SiteFriendlyName)%20website">
                                support.my@12csd.com
                            </a>
                        </p>
                    </div>
                </div>

                <hr style="border-top: 1px dotted rgb(153, 153, 153);" noshade="noshade" size="1">

                @*TH*@
                <div class="um-wrapper">
                    <div class="um-header">
                        <img src="~/www/build/styles/Images/notify/note_icon.gif" width="46" height="46" />
                        <h1>ปรับปรุงระบบ</h1>
                    </div>

                    <div class="message-content">
                        <p>ทางเวบไซด์มีการปรับปรุงระบบขณะนี้ และไม่สามารถเข้าชมหรือใช้งานได้ไปจนถึงเวลา <span class="um-time info">@to (HK Time GMT +8).</span></p>
                        <p>ขออภัยในความไม่สะดวก คะ!</p>
                        <p>
                            ติอต่อฝ่ายบริการลูกค้าเราได้ที่ <a class="info" href="https://secure.livechatinc.com/licence/7903821/open_chat.cgi?groups=4" target="_blank">ห้องสนทนาสด</a> หรือ อีเมลล์

                            <a class="info" href="mailto:support.th@12csd.com?subject=Enquiries%20sent%20from%20@(AppSetting.Instance.SiteFriendlyName)%20website">
                                support.th@12csd.com
                            </a>
                        </p>
                    </div>
                </div>

                <hr style="border-top: 1px dotted rgb(153, 153, 153);" noshade="noshade" size="1">

                @*VN*@
                <div class="um-wrapper">
                    <div class="um-header">
                        <img src="~/www/build/styles/Images/notify/note_icon.gif" width="46" height="46" />
                        <h1>Hệ thống bảo trì</h1>
                    </div>

                    <div class="message-content">
                        <p>Hệ thống công ty chúng tôi đang trong thời gian bảo trì đến <span class="um-time info">@to (HK Time GMT +8).</span></p>
                        <p>Thành thật xin lỗi những bất tiện gây ra.</p>
                        <p>
                            Yêu cầu dịch vụ khách hàng, xin vui lòng <a class="info" href="https://secure.livechatinc.com/licence/7903821/open_chat.cgi?groups=3" target="_blank">Nhấp vào đây</a> hoặc gửi Email đến

                            <a class="info" href="mailto:support.vn@12csd.com?subject=Enquiries%20sent%20from%20@(AppSetting.Instance.SiteFriendlyName)%20website">
